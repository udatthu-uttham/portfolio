---
import '../styles/global.css';
import PointerRide from '../components/PointerRide.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Uttham Udatthu — design leadership for commerce at India scale.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- The header's avatar, cropped square to the head so it still reads as a
         face at 16px. The touch icon sits on the white sheet stock (--paper-1): iOS paints a
         transparent icon black. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <!-- scroll-reveal content starts at opacity 0 for the IntersectionObserver;
         without JS nothing would ever un-hide it -->
    <noscript>
      <style>
        .rv { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <link
      rel="preload"
      href="/fonts/general-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/general-sans-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
  </head>
  <body>
    <slot />
    <PointerRide />
    <script src="../scripts/motion.js"></script>
  </body>
</html>
