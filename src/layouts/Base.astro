---
import '../styles/global.css';
import PointerRide from '../components/PointerRide.astro';

// Load order (perf pass 2026-10-02). Everything the browser needs for the first
// paint is declared in the head, in the first ~2KB of every page:
// - The three General Sans faces are all on the first screen of every page —
//   600 for the wordmark, headings and the hero's bold beats, 400 for the hero
//   lead and body copy (the largest text on the page), 500 for the nav — so all
//   three are preloaded and the first paint is in the right face rather than a
//   swapped fallback. Caveat is a caption, not the lead, and is left to the CSS.
// - The site motion is a module (deferred), so declaring it in the head costs
//   no parsing and lets the fetch start with the first bytes of the page rather
//   than after the last. A page can add its own head entries through the head
//   slot — the homepage adds the hero's GSAP chunk (HeroMotion).
// - The <noscript> for the scroll reveals lives in the body on purpose: a
//   <noscript> inside <head> makes the Astro compiler close the head early,
//   which used to push every stylesheet link to after </body>.

// Search and link previews (domain trust pass, 2026-10-03; CLAUDE.md, "Domain
// trust"): every page names its one address on the apex, so the www and
// workers.dev copies fold into it; the Open Graph and Twitter tags give
// LinkedIn, Slack and WhatsApp a titled card with a picture; a page can add
// its own JSON-LD. Titles and descriptions come from src/lib/seo.ts.
import { SITE, ogHome, checkLengths, type OgImage } from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  image?: OgImage; // the link-preview card; defaults to the home card
  type?: 'website' | 'article';
  jsonLd?: object; // schema.org data for this page
  noindex?: boolean; // the 404 page: no canonical, kept out of the index
}

const {
  title,
  description = 'Uttham Udatthu: design leadership for commerce at India scale.',
  image = ogHome,
  type = 'website',
  jsonLd,
  noindex = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE).href;
const imageUrl = new URL(image.src, SITE).href;
if (!noindex) checkLengths(Astro.url.pathname, title, description);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <!-- The header's avatar, cropped square to the head so it still reads as a
         face at 16px. The touch icon sits on the white sheet stock (--paper-1): iOS paints a
         transparent icon black. -->
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link
      rel="preload"
      href="/fonts/general-sans-600.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/general-sans-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/general-sans-500.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <script src="../scripts/motion.js"></script>
    <slot name="head" />
    <!-- Search and link previews, after the preloads, so those stay in the
         page's first ~1KB. Astro appends the stylesheets after this block,
         ~3.5KB in: still inside the first round trip. -->
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:site_name" content="Uttham Udatthu" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {!noindex && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content={String(image.width)} />
    <meta property="og:image:height" content={String(image.height)} />
    <meta property="og:image:alt" content={image.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={image.alt} />
    {jsonLd && <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <!-- scroll-reveal content starts at opacity 0 for the IntersectionObserver;
         without JS nothing would ever un-hide it -->
    <noscript>
      <style>
        .rv { opacity: 1 !important; transform: none !important; }
      </style>
    </noscript>
    <slot />
    <PointerRide />
  </body>
</html>
