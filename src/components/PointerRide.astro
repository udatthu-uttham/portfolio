---
// The visitor rides the paper (plans/014). One click-through canvas driven by
// pointer-ride.js: soft exhaust gas in viewport space, above the header. Fine
// mouse only; nothing on touch. The rubber marks layer came off on 2026-10-05
// (Uttham: "lets get rid of the tire marks, that is distracting").
---
<canvas class="ride-smoke" aria-hidden="true"></canvas>

<style>
  .ride-smoke {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    contain: strict;
    z-index: calc(var(--z-header) + 1);
  }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .ride-smoke { display: none; }
  }
</style>

<script>
  import { initPointerRide } from '../scripts/pointer-ride.js';
  const dispose = initPointerRide({
    smoke: document.querySelector('.ride-smoke'),
  });
  if (import.meta.hot) import.meta.hot.dispose(dispose);
</script>
