---
// The visitor rides the paper (plans/014). Two click-through canvases driven by
// one sampler in pointer-ride.js: rubber marks in page space below the header,
// smoke in viewport space above it. Fine mouse only; nothing on touch.
---
<canvas class="ride-marks" aria-hidden="true"></canvas>
<canvas class="ride-smoke" aria-hidden="true"></canvas>

<style>
  .ride-marks,
  .ride-smoke {
    position: fixed;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    contain: strict;
  }

  .ride-marks { z-index: var(--z-surface-fx); }
  .ride-smoke { z-index: calc(var(--z-header) + 1); }

  @media (prefers-reduced-motion: reduce), (hover: none), (pointer: coarse) {
    .ride-marks,
    .ride-smoke { display: none; }
  }

  /* Rubber lowers text contrast a little; high-contrast readers get none. */
  @media (prefers-contrast: more) {
    .ride-marks { display: none; }
  }
</style>

<script>
  import { initPointerRide } from '../scripts/pointer-ride.js';
  const dispose = initPointerRide({
    marks: document.querySelector('.ride-marks'),
    smoke: document.querySelector('.ride-smoke'),
  });
  if (import.meta.hot) import.meta.hot.dispose(dispose);
</script>
