---
// The realistic prototype, previewed by running the actual build (CLAUDE.md: a
// preview renders the tool's real UI, not a restyled version of it). The phone
// holds an iframe of /proto/feed-ux at a real 320px handset viewport, scaled to
// whatever width it is given — so the app's own responsive rules behave
// exactly as they do in a session, and the Resona card's phone, this one and
// the Projects deck covers are all the same object at the same zoom.
//
// ON THE HOMEPAGE CARD it is only a running preview (Uttham, 2026-10-01: "no
// need to add view prototype link, clicking on the card will move to ai space
// teaser page"): no link and no pill of its own, and the frame does not take
// the pointer, so a click anywhere on the card lands on the card's own link to
// /ai/realistic-prototype. A half-scale shop is worse to use than the real
// thing, and an interactive iframe would eat the page's scroll.
//
// ON THE TEASER PAGE it stands in the teaser's sticky phone (`fill`) at close
// to a handset's own size, so it is `interactive`: the reader can scroll the
// feed and tap through it right there. The teaser's left column carries the
// link to open it full size.
//
// CATALOGUE IS MOCK (locked 2026-09-20): the products, prices and ratings in the
// sandbox are stand-ins that read like the real thing. No Meesho business
// figures appear here or anywhere on the page.
interface Props {
  src: string; // the running build
  fill?: boolean; // fill the frame it is given (the teaser's phone) instead of drawing its own
  interactive?: boolean; // let the reader use it
}
const { src, fill = false, interactive = false } = Astro.props;
---

<div class:list={['pp', { 'pp--fill': fill, 'pp--live': interactive }]}>
  <div class="pp__phone">
    <span class="pp__stage" data-proto-stage>
      {interactive ? (
        <iframe class="pp__frame" src={src} title="The shopping sandbox, running — scroll and tap through it" loading="eager"></iframe>
      ) : (
        <iframe
          class="pp__frame"
          data-src={src}
          title="The shopping sandbox, running"
          tabindex="-1"
          aria-hidden="true"
          scrolling="no"
        ></iframe>
      )}
    </span>
  </div>
</div>

<script>
  // The scale is the phone's width over the app's own 320px viewport, and --vh
  // is the frame's height in those same units — so the app is handed a viewport
  // that ends exactly where the frame does and its fixed bottom bar lands on
  // the edge instead of being cut off. Exact at every card breakpoint.
  const VW = 320;
  document.querySelectorAll<HTMLElement>('[data-proto-stage]').forEach((stage) => {
    const fit = () => {
      const k = stage.clientWidth / VW;
      if (!k) return;
      stage.style.setProperty('--k', String(k));
      stage.style.setProperty('--vh', `${stage.clientHeight / k}px`);
    };
    new ResizeObserver(fit).observe(stage);
    fit();
  });

  // The card's phone holds its address in data-src and is only handed it once
  // the card is within a screen of the viewport: the sandbox is a ~1MB build,
  // and a native loading="lazy" iframe still fetched it on page load, because
  // AI Space sits inside the browser's own look-ahead distance. One screen is
  // enough for the app to boot before a reader scrolling at reading pace
  // reaches it; the teaser page's live phone keeps its src and loads at once
  // (perf pass 2026-10-02).
  const pending = document.querySelectorAll<HTMLIFrameElement>('iframe[data-src]');
  const hand = (frame: HTMLIFrameElement) => {
    if (!frame.src && frame.dataset.src) frame.src = frame.dataset.src;
  };
  if ('IntersectionObserver' in window) {
    const near = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          entry.target.querySelectorAll<HTMLIFrameElement>('iframe[data-src]').forEach(hand);
          near.unobserve(entry.target);
        });
      },
      { rootMargin: '100% 0px' }
    );
    pending.forEach((frame) => near.observe(frame.closest('[data-proto-stage]') ?? frame));
  } else {
    pending.forEach(hand);
  }
</script>

<style>
  .pp {
    display: flex;
    justify-content: center;
    align-items: flex-end;
    width: 100%;
    height: 100%;
    text-align: left;
    text-transform: none;
    letter-spacing: 0;
  }

  /* Same frame as the Resona card and as the Projects deck covers, so the two
     sections read as one shelf: 9/15, flush on the bottom edge. */
  .pp__phone {
    position: relative;
    flex: 0 1 auto;
    height: 100%;
    aspect-ratio: 9 / 15;
    max-width: 100%;
    overflow: hidden;
    border: 1px solid var(--line-1);
    border-bottom: 0;
    border-radius: 18px 18px 0 0;
    background: #fff;
    box-shadow: var(--shadow-rest);
  }

  /* In the teaser's phone the frame is the teaser's: the app fills it. */
  .pp--fill { display: block; }
  .pp--fill .pp__phone {
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }

  /* The app gets a real 320px phone viewport — the same one the Resona screen
     is laid out in — and is scaled down as one piece, so its own breakpoints
     fire as they do on a phone. --k and --vh are written by the observer above;
     the fallbacks hold until it runs. */
  .pp__stage {
    --k: 0.8;
    position: absolute;
    inset: 0;
    display: block;
    overflow: hidden;
  }
  .pp__frame {
    position: absolute;
    top: 0;
    left: 0;
    width: 320px;
    height: var(--vh, 533px);
    border: 0;
    transform-origin: top left;
    scale: var(--k);
    pointer-events: none;
  }
  .pp--live .pp__frame { pointer-events: auto; }
  .pp--live .pp__frame:focus-visible { outline: 2px solid var(--amber-text); outline-offset: -2px; }
</style>
