---
// A teaser page as Uttham laid it out (2026-10-01): a two-minute read on the
// left, a sticky preview on the right that follows the reading, and — where a
// study has one — the full case study expanding in place behind a light
// password gate. Built from the site's own pieces: paper for the words, glass
// for the screens, the sticker CTA. Content comes in as CaseTeaserData
// (src/data/case-teaser.ts); the product-cards and Meesho Mall case studies and
// the AI Space tool pages all render through here.
//
// Two kinds of preview. Screens: Uttham's Figma exports, picked per state from
// src/assets/<screens.dir>/ (a state with no screen shows the nearest earlier
// one; the dev server names the missing one), shown in a phone mock of one
// constant size (CaseDevice) and never cropped: a 1 : 2 screen fills its
// display, a shorter one fits and is filled with its own edge colours, a page
// taller than a phone pans, a still with a clip plays it, a reference board
// stands in the device's place. Live: a `preview` slot — a running tool —
// which hears each state as a `case:state` event. With `frame="phone"` the
// slot stands in the teaser's own phone (a handset's 9/19.5, the mini player's
// tap-to-enlarge) and the tool just fills it; without it the tool sizes its own
// frame.
import { Image, getImage } from 'astro:assets';
import CaseDevice from './CaseDevice.astro';
import { rich } from '../lib/rich';
import { screenEdges } from '../lib/screen-edges';
import type { Edge } from '../lib/edge-colour';
import clipEdges from '../data/clip-edges.json';
import { CASE_PASSWORD_SHA256 } from '../data/case-gate';
import type { CaseTeaserData } from '../data/case-teaser';

interface Props {
  data: CaseTeaserData;
  frame?: 'phone'; // live mode only: stand the tool in the teaser's own phone
}
const { data, frame } = Astro.props;
const live = Astro.slots.has('preview');
const livePhone = live && frame === 'phone';

// the case studies' phone screens: plp/ and mall-case/ hold only what Uttham
// supplies for them (2026-10-02: "remove them and ask me I will give all of
// them"). mall/ (the Mall deck's own exports, for the homepage tile) is not
// globbed here: an eager glob emits every file it matches into the build.
const files = import.meta.glob<ImageMetadata>('../assets/{plp,mall-case}/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' });
const library: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(files).map(([path, img]) => {
    const [dir, name] = path.split('/').slice(-2);
    return [`${dir}/${name.replace(/\.(png|jpe?g|webp)$/, '')}`, img];
  })
);
// every state on the page, in reading order
const states = [
  ...new Set([
    ...data.sections.flatMap((s) => [s.state, ...s.blocks.flatMap((b) => (b.kind === 'steps' ? b.steps.map((st) => st.state) : b.kind === 'rows' ? b.rows.map((r) => r.state) : []))]),
    ...(data.experiments ?? []).map((e) => e.state),
  ].filter((x): x is string => Boolean(x))),
];
// state → the screen files that show it, in the order they play, for the
// states that have any. A state can name several (`screens.map`, e.g. the Mall
// tab's onboarding modal, then its PiP): they play in turn.
const stateFiles: Record<string, string[]> = {};
if (data.screens && !live) {
  const { dir, map } = data.screens;
  for (const state of states) {
    const mapped = map?.[state] ?? state;
    const keys = (Array.isArray(mapped) ? mapped : [mapped]).map((name) => `${dir}/${name}`).filter((key) => library[key]);
    if (keys.length) stateFiles[state] = keys;
  }
}
const shots = [...new Set(Object.values(stateFiles).flat())];
const nameOf = (key: string) => key.slice(key.indexOf('/') + 1);
// What a screen file shows, from a record keyed by state (alts, titles): the
// file's own entry first (v3-nav-pip), unless a state of that name shows other
// files; else the first state in reading order that shows it and has an entry.
// Reading only the first state left a borrowed file blank: Mall's v3-labels row
// borrows v3-pill and comes first (fixed 2026-10-03).
const forScreen = (record: Record<string, string> | undefined, key: string) => {
  if (!record) return undefined;
  const file = nameOf(key);
  if (record[file] && (stateFiles[file]?.includes(key) ?? true)) return record[file];
  return Object.keys(stateFiles)
    .filter((s) => stateFiles[s].includes(key))
    .map((s) => record[s])
    .find(Boolean);
};
const altFor = (key: string) => {
  const alt = forScreen(data.screens?.alts, key);
  // every screen is a content image: say so at build time if one has no words
  if (!alt) console.warn(`[case] ${key}: no alt text in screens.alts`);
  return alt ?? '';
};
const dev = import.meta.env.DEV;
const back = data.back ?? { href: '/#work', label: '← All projects' };
const hasFull = Boolean(data.gate && data.experiments?.length);

const sourceLink = data.source
  ? `<a class="ct-source" href="${data.source.href}" target="_blank" rel="noopener" title="${data.source.title}">${data.source.label}</a>`
  : '';
const dek = rich(data.dek).replace('{source}', sourceLink);

// Every section and full-study block gets an id, so the scroll points can jump
// to it. Prefixed, so none can collide with the homepage scrollspy's about /
// work / ai / contact.
const idFor = (text: string) => `s-${text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;

// The scroll points, in reading order: each section, each sub-group heading
// inside it, and — once the full study is open — the study and its blocks.
// A page with `rail` keeps only the top of the page and the sections it names
// (the full study opens inside Outcome, so Outcome stays lit while it is read).
type Mark = { id: string; title: string; sub?: boolean; full?: boolean };
// A tooltip names its tick in a few words (Uttham, 2026-10-03: "please
// truncate these"): a heading's lead-in before its colon ("Before v3: what
// shoppers told us" → "Before v3"), the whole heading when it has none. The
// link's accessible name keeps the full heading.
const shortFor = (title: string) => title.split(/:\s/)[0];
const rail = data.rail;
const marks: Mark[] = rail
  ? [
      ...(rail.top ? [{ id: 'ct-top', title: data.title }] : []),
      ...data.sections.filter((s) => rail.sections.includes(s.heading)).map((s) => ({ id: idFor(s.heading), title: s.heading })),
    ]
  : data.sections.flatMap((section) => [
      { id: idFor(section.heading), title: section.heading },
      ...section.blocks.flatMap((b) =>
        (b.kind === 'steps' || b.kind === 'rows') && b.heading ? [{ id: idFor(b.heading), title: b.heading, sub: true }] : []
      ),
    ]);
if (data.gate && data.experiments?.length && !rail) {
  marks.push({ id: 'full-title', title: 'The full case study', full: true });
  data.experiments.forEach((e) => marks.push({ id: idFor(e.title), title: e.title, sub: true, full: true }));
}
// the title on the card over the phone: per screen, as its alt is found
// (forScreen), so a state that borrows an earlier screen borrows its title too
const titles = data.screens?.titles;
const titleFor = (key: string) => forScreen(titles, key);
// A screen is a phone screen (tall) or a reference board (landscape or square,
// e.g. an annotated framework; Uttham, 2026-10-03: "I will give reference
// image (figure out a way on how to place this)"). A board is never put in the
// phone: it stands in the device's place, whole, on the card's paper.
const ratioOf = (key: string) => library[key].height / library[key].width;
const kindFor = (key: string) => (1 / ratioOf(key) > 0.62 ? 'board' : 'phone');
// ONE CONSTANT SIZE (Uttham, 2026-10-03: "all the aspect ratio should be fixed
// for this card, and the content inside … everything should have constant
// height and width"). The phone's display is 1 : 2, the exports' own
// proportion, at every state, beat, clip and board; and NOTHING IS CROPPED OR
// STRETCHED ("when I give big images I dont want you to just paste them or
// crop them abruptly making its content gone (this is for all images you are
// using)"). How a screen fits that display:
//   fit — a 1 : 2 screen fills it to the pixel; a shorter one (the 9 : 16
//         order confirmation) fits its width and the display around it takes
//         the screen's own top and bottom edge colours, so it reads as one
//         screen rather than one with bars (anchorFor, below, says where)
//   pan — a page capture taller than the display (a whole home feed) stands
//         at its width and pans down and back; with reduced motion it scrolls
//         by hand instead
const SCREEN = 2; // the display's height over its width
const fitFor = (key: string) => (kindFor(key) === 'phone' && ratioOf(key) > SCREEN * 1.01 && !videoFor(key) ? 'pan' : 'fit');
// how far a pan travels: what lies under the display, as a share of the
// page's own height (a translate in % is of the element's own height)
const panFor = (key: string) => ((1 - SCREEN / ratioOf(key)) * 100).toFixed(2);
// Screens that move: Figma animations exported as MP4 (screens.videos, keyed by
// file). The file's own still, optimised like every screen, is the clip's
// poster — what reduced motion shows, and the frame the clip settles on once it
// has played: for most clips the closing frame; for the order confirmation,
// whose clip ends mid-transition, the confirmed screen. Being an ending, it is
// never what a clip opens on, so the <video> carries no poster attribute: the
// still sits under it instead.
const videoFor = (key: string) => data.screens?.videos?.[nameOf(key)];
const stills: Record<string, string> = {};
for (const key of shots) {
  if (videoFor(key)) stills[key] = (await getImage({ src: library[key], width: 720, format: 'webp' })).src;
}
// the phone's screens and the boards that stand in its place, in reading order
const phones = shots.filter((key) => kindFor(key) === 'phone');
const boards = shots.filter((key) => kindFor(key) === 'board');
// each phone screen's top and bottom edge colour, read from the export at
// build time (src/lib/screen-edges.ts): the status bar and home strip take
// them, and so does the display around a screen shorter than it
const edges: Record<string, Edge> = {};
for (const key of phones) edges[key] = await screenEdges((library[key] as ImageMetadata & { fsPath?: string }).fsPath);
// WHERE A SHORTER SCREEN STANDS in the display: centred, unless one of its
// edges is patterned and the other flat — then it stands against the patterned
// edge and all the fill falls on the flat one, where it is the same colour as
// the screen and leaves no seam. The order confirmation's top is a field of
// stars (its commonest colour covers ~57% of it) over a flat purple foot:
// centred, the stars stopped in a hard line ~30px under the status bar, on a
// band of flat purple that read as a picture laid on purple; set to the top,
// its header meets the status bar the way an app's does and its foot runs on
// into the fill (2026-10-03, review of the handset).
const FLAT = 0.9; // an edge whose commonest colour covers this much is flat
const anchorFor = (key: string) => {
  const edge = edges[key];
  if (fitFor(key) !== 'fit' || ratioOf(key) > SCREEN * 0.99 || !edge) return undefined;
  const top = (edge.topShare ?? 1) >= FLAT;
  const foot = (edge.footShare ?? 1) >= FLAT;
  return top === foot ? undefined : top ? 'bottom' : 'top';
};
// A CLIP'S STRIPS FOLLOW ITS FRAMES from a timeline read once, frame by frame,
// with the stills' own rule (scripts/clip-edges.mjs → src/data/clip-edges.json:
// [seconds, top, top ink, foot, foot ink] at each moment the edges change), not
// from a canvas in the browser, which reads Chromium's video darker than a Mac
// shows it. A clip missing from the file keeps its still's colours throughout.
const timelines = clipEdges as Record<string, { frames: number; edges: [number, string, string, string, string][] }>;
const edgesOfClip = (key: string) => {
  const src = videoFor(key);
  if (!src) return undefined;
  const timeline = timelines[src]?.edges;
  if (!timeline?.length) console.warn(`[case] ${src}: no colour timeline in src/data/clip-edges.json (npm run clip-edges); its strips keep the still's colours`);
  return timeline?.length ? JSON.stringify(timeline) : undefined;
};
// a board is shown at most the device's width on the card, and whole in the
// enlarged view: its sources stop at the export's own width
const boardWidths = (key: string) => [...new Set([480, 960, 1600].map((w) => Math.min(w, library[key].width)))];
// HANDWRITTEN NOTES beside the phone, per screen file (screens.notes), as the
// homepage tiles have them (Uttham, 2026-10-03: "the framework card should
// come inside the image, and the wordings outside as you did on home page"):
// only on a phone screen, which fills the display, so a note's `y` is a share
// of the display's height. A page with notes keeps a notes column on its card
// at every state (ct-panel--notes), so the card never changes size for them.
const notesFor = (key: string) => (kindFor(key) === 'phone' ? data.screens?.notes?.[nameOf(key)] ?? [] : []);
const noted = live ? [] : shots.filter((key) => notesFor(key).length);
---

<div class="ct">
  <header class="ct-hero" id={rail?.top ? 'ct-top' : undefined}>
    <a class="back-link text-link" href={back.href}>{back.label}</a>
    <h1>{data.title}</h1>
    <p class="ct-dek" set:html={dek} />
    {data.facts.length > 0 && (
      <dl class="ct-facts">
        {data.facts.map((f) => (
          <div class="ct-facts__row"><dt>{f.label}</dt><dd set:html={rich(f.value)} /></div>
        ))}
      </dl>
    )}{data.visit && (
      <a class="text-link ct-visit" href={data.visit.href} target="_blank" rel="noopener">{data.visit.label} <span aria-hidden="true">↗</span></a>
    )}
  </header>

  <div class="ct-layout">
    <div class="ct-story">
      {data.sections.map((section) => (
        <section class="ct-section" id={idFor(section.heading)} data-state={section.state}>
          <h2>{section.heading}</h2>
          {section.blocks.map((block) =>
            block.kind === 'p' ? (
              <p class="ct-body" set:html={rich(block.text)} />
            ) : block.kind === 'steps' ? (
              <>
                {block.heading && <h3 id={idFor(block.heading)}>{block.heading}</h3>}
                {block.lead && <p class="ct-body ct-sublead" set:html={rich(block.lead)} />}
                <ul class="ct-steps">
                  {block.steps.map((s) => (
                    <li class="ct-step" data-state={s.state}><b>{s.label}</b><span set:html={rich(s.text)} /></li>
                  ))}
                </ul>
              </>
            ) : block.kind === 'quote' ? (
              block.consent !== false && (
                <aside class="ct-note">
                  <p>{block.text}</p>
                  <small>{block.source}</small>
                </aside>
              )
            ) : block.kind === 'inside' ? (
              /* in a section with the gate, the list goes inside the gate card */
              data.gate && section.blocks.some((b) => b.kind === 'gate') ? null : (
              <div class="ct-inside-block" data-inside>
                <p class="ct-body ct-inside-lead">{block.lead}</p>
                <ul class="ct-inside">
                  {block.items.map((item) => <li>{item}</li>)}
                </ul>
              </div>
              )
            ) : block.kind === 'rows' ? (
              <>
                {block.heading && <h3 id={idFor(block.heading)}>{block.heading}</h3>}
                {block.lead && <p class="ct-body ct-sublead" set:html={rich(block.lead)} />}
                <ul class="ct-steps ct-rows">
                  {block.rows.map((r) => (
                    <li class="ct-step ct-row" data-state={r.state} set:html={rich(r.text)} />
                  ))}
                </ul>
              </>
            ) : block.kind === 'prompt' ? (
              <div class="ct-prompt" data-prompt>
                <div class="ct-prompt__head">
                  <button class="cta cta--primary" type="button" data-copy-prompt data-copied="Copied">{block.copy}</button>
                  <span class="sr-only" role="status" data-copy-status></span>
                </div>
                <pre class="ct-prompt__text" id="ct-prompt-text" data-prompt-text>{block.text}</pre>
                <button class="ct-prompt__more text-link" type="button" data-prompt-more aria-controls="ct-prompt-text" aria-expanded="true" hidden>
                  <span data-more-label>Show less</span> <span aria-hidden="true" data-more-arr>↑</span>
                </button>
              </div>
            ) : (
              data.gate && (
                <div class="ct-gate" data-gate data-hash={CASE_PASSWORD_SHA256} data-dev={dev ? '1' : undefined}>
                  <p class="ct-gate__text">{data.gate.text}</p>
                  {/* what the full study holds, on the card that opens it
                      (Uttham, 2026-10-02: "I want the full case study
                      information in the white card") */}
                  {section.blocks.filter((b) => b.kind === 'inside').map((b) => b.kind === 'inside' && (
                    <div class="ct-gate__inside">
                      <p class="ct-gate__lead">{b.lead}</p>
                      <ul class="ct-inside">
                        {b.items.map((item) => <li>{item}</li>)}
                      </ul>
                    </div>
                  ))}
                  {hasFull && (
                    <>
                      <button class="cta cta--primary" type="button" data-gate-open aria-expanded="false" aria-controls="full">{data.gate.cta}</button>
                      <form class="ct-gate__form" data-gate-form hidden>
                        <label class="ct-gate__label" for="case-pass">Password</label>
                        <div class="ct-gate__row">
                          <input class="ct-gate__input" id="case-pass" name="password" type="password" autocomplete="current-password" required />
                          <button class="cta cta--secondary" type="submit">Open</button>
                        </div>
                        <p class="ct-gate__msg" data-gate-msg role="status" aria-live="polite"></p>
                      </form>
                    </>
                  )}
                </div>
              )
            )
          )}
        </section>
      ))}

      {hasFull && (
        <section class="ct-full" id="full" aria-labelledby="full-title" hidden>
          {/* where the added content starts (Uttham, 2026-10-02: "once I enter
              the password the whole page should refresh, with seperator to show
              the added content") */}
          <div class="ct-full__rule" aria-hidden="true"><span>The full case study</span></div>
          <h2 class="sr-only" id="full-title" tabindex="-1">The full case study</h2>
          {data.experiments!.map((e) => (
            <article class="ct-exp" id={idFor(e.title)} data-state={e.state}>
              <div class="ct-exp__head">
                <h3>{e.title}</h3>
                {e.status && <p class="ct-exp__status">{e.status}</p>}
              </div>
              <div class="ct-exp__part"><p class="ct-exp__label">Why</p><p class="ct-body" set:html={rich(e.why)} /></div>
              {e.how && <div class="ct-exp__part"><p class="ct-exp__label">How</p><p class="ct-body" set:html={rich(e.how)} /></div>}
              {e.worked && <div class="ct-exp__part"><p class="ct-exp__label">What worked</p><p class="ct-body" set:html={rich(e.worked)} /></div>}
            </article>
          ))}
        </section>
      )}
    </div>

    <aside class:list={['ct-panel', { 'ct-panel--live': live, 'ct-panel--device': !live, 'ct-panel--titled': titles && !live, 'ct-panel--visit': data.visit, 'ct-panel--notes': noted.length > 0 }]} aria-label={data.panelLabel ?? 'Preview'} data-case-panel data-map={JSON.stringify(stateFiles)} data-titles={titles && !live ? JSON.stringify(titles) : undefined}>
      <div class="ct-pane">
        {/* one line in a slot of its own height: a long title ends in an
            ellipsis and keeps its whole text as the element's title */}
        {titles && !live && <p class="ct-pane__title" data-pane-title aria-live="polite"></p>}
        <div class="ct-stage">
          {livePhone ? (
            <div class="ct-phone ct-phone--live">
              <div class="ct-live ct-live--framed"><slot name="preview" /></div>
              {/* phones only: the mini phone grows to full size in place (an
                  iframe moved into a dialog would reload) */}
              <button class="ct-pip__enlarge" type="button" aria-label="Enlarge the preview" data-pip-enlarge></button>
            </div>
          ) : live ? (
            <div class="ct-live"><slot name="preview" /></div>
          ) : (
            <>
              <CaseDevice data-device>
                <div class="ct-phone">
                  {phones.map((key, i) => {
                    // what every screen tells the script: its file, title,
                    // kind, how it fits the display and its edge colours (the
                    // device's strips take them); a shorter screen's fill
                    // above and below it is its own edges
                    const edge = edges[key];
                    const meta = {
                      'data-screen': key, 'data-title': titleFor(key), 'data-kind': 'phone', 'data-ratio': ratioOf(key).toFixed(4), 'data-fit': fitFor(key), 'data-anchor': anchorFor(key),
                      'data-top': edge.top, 'data-top-ink': edge.topInk, 'data-foot': edge.foot, 'data-foot-ink': edge.footInk, 'data-edges': edgesOfClip(key),
                      style: `--ct-fill-top: ${edge.top}; --ct-fill-foot: ${edge.foot}`,
                    };
                    const loading = i < 2 ? 'eager' : 'lazy';
                    return videoFor(key) ? (
                      /* a clip over its still: the clip shows from its first
                         frame, the still once it has played (or with reduced
                         motion, instead of it) */
                      <div class="ct-screen ct-screen--clip" {...meta} role="img" aria-label={altFor(key)}>
                        <img class="ct-screen__still" src={stills[key]} alt="" width="720" height={Math.round(720 * ratioOf(key))} loading={loading} decoding="async" />
                        <video class="ct-screen__clip" data-src={videoFor(key)} muted playsinline preload="none" disablepictureinpicture disableremoteplayback aria-hidden="true"></video>
                      </div>
                    ) : fitFor(key) === 'pan' ? (
                      /* a page taller than the display, in a window it pans
                         (or, with reduced motion, scrolls) */
                      <div class="ct-screen ct-screen--pan" {...meta} data-pan={panFor(key)}>
                        <div class="ct-screen__scroll" data-pan-scroll>
                          <Image class="ct-screen__page" src={library[key]} alt={altFor(key)} widths={[360, 720]} sizes="360px" loading={loading} />
                        </div>
                      </div>
                    ) : (
                      <Image class="ct-screen" {...meta} src={library[key]} alt={altFor(key)} widths={[360, 720]} sizes="360px" loading={loading} />
                    );
                  })}
                  {/* while a screen is still to come: its state's name on the
                      dev server, a quiet line in the build */}
                  <p class="ct-phone__dev" data-dev-label data-dev={dev ? '1' : undefined}></p>
                </div>
                {/* reduced motion: a page that scrolls by hand says so in the
                    home strip, never over the screen */}
                <span class="ct-hint" slot="home" aria-hidden="true">Scroll <span>↓</span></span>
              </CaseDevice>
              {boards.length > 0 && (
                /* REFERENCE BOARDS stand in the device's place, whole, on the
                   card's paper, never wider or taller than the device — so the
                   card keeps its size — with a line under each that it opens
                   full size (nothing is laid over the board itself) */
                <div class="ct-boards">
                  {boards.map((key) => (
                    <div class="ct-screen ct-board" data-screen={key} data-title={titleFor(key)} data-kind="board" data-ratio={ratioOf(key).toFixed(4)} data-width={library[key].width} style={`--ct-board-r: ${ratioOf(key).toFixed(4)}`}>
                      <Image class="ct-board__img" src={library[key]} alt={altFor(key)} widths={boardWidths(key)} sizes="(min-width: 768px) 400px, 112px" loading="lazy" />
                      <span class="ct-board__hint" aria-hidden="true">
                        <svg viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"><circle cx="7" cy="7" r="4.6" /><path d="M10.4 10.4 14 14M7 5v4M5 7h4" /></svg>
                        <span class="ct-board__hint-label"><span class="ct-board__fine">Click</span><span class="ct-board__coarse">Tap</span> to enlarge</span>
                      </span>
                    </div>
                  ))}
                </div>
              )}
              {noted.length > 0 && (
                /* THE NOTES, outside the device on the card's paper: one set
                   per screen, laid over the display's box so a note's `y` lands
                   on the screen's own height, each note standing left of it with
                   its arrow's tip on the screen's left edge. A set fades with
                   its screen. Decoration: the screen's alt names its zones. */
                <div class="ct-annots" aria-hidden="true">
                  {noted.map((key) => (
                    <div class="ct-annots__set" data-notes-for={key}>
                      {notesFor(key).map((n) => (
                        <span class="ct-annot" style={`--y: ${n.y}`}>
                          <span class="ct-annot__text">{n.text}</span>
                          {/* the homepage tiles' arrow, drawn pointing left and
                              mirrored here; drawn twice, a paper halo under the
                              ink, so its tip still reads where it crosses the
                              graphite bezel onto the screen */}
                          <svg class="ct-annot__arrow" viewBox="0 0 44 22" fill="none">
                            <g class="ct-annot__halo">
                              <path d="M42 2.5c-5.5.5-11.6 1.5-17.6 5S10.6 15.8 3.5 20.5" />
                              <path d="M11.4 21.3 3.5 20.5l2.3-7.6" />
                            </g>
                            <path d="M42 2.5c-5.5.5-11.6 1.5-17.6 5S10.6 15.8 3.5 20.5" />
                            <path d="M11.4 21.3 3.5 20.5l2.3-7.6" />
                          </svg>
                        </span>
                      ))}
                    </div>
                  ))}
                </div>
              )}
              {/* opens the screen full size: the whole mini player on phones,
                  the board standing in the device's place from 768px */}
              <button class="ct-pip__enlarge" type="button" aria-label="Enlarge the preview" data-pip-enlarge></button>
            </>
          )}
          <button class="ct-pip__close" type="button" aria-label="Hide the preview" data-pip-close><span aria-hidden="true">×</span></button>
        </div>
        {/* next to the thing it opens (Uttham, 2026-10-02: "this should be in
            the proximity of the prototype. maybe bottom of the preview"); on
            phones it stays under the facts, where the mini player cannot hide it */}
        {data.visit && (
          <a class="text-link ct-visit ct-pane__visit" href={data.visit.href} target="_blank" rel="noopener">{data.visit.label} <span aria-hidden="true">↗</span></a>
        )}
      </div>
    </aside>
  </div>
  {/* Scroll points (Uttham, 2026-10-01: "section type scroll points, that we
      see in chatgpt and reference portfolio… so I can swiftly navigate inside
      the page"): a tick per section and sub-group in the right gutter, a
      sub-group's tick shorter, the one being read drawn longer and darker; a
      click jumps. The full study's blocks join once it is opened. Titles show
      as tooltips, one at a time — the current tick's, or the hovered or
      focused one's (Uttham, 2026-10-02: "the sticky notes as scroll points in
      l2 is weird lets do the one you initially made but the active or hover
      state show these as tooltips"). The link carries the title as its name;
      the tooltip is only its picture. */}
  <nav class="ct-points" aria-label="On this page" data-points>
    <ol class="ct-points__list">
      {marks.map((m) => (
        <li class:list={{ 'ct-points__item--sub': m.sub, 'ct-points__full': m.full }} hidden={m.full || undefined}>
          <a class="ct-points__link" href={`#${m.id}`} aria-label={m.title} data-point>
            <span class="ct-points__label" aria-hidden="true">{shortFor(m.title)}</span>
            <span class="ct-points__tick" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <span class="ct-end" data-case-end aria-hidden="true"></span>
  <button class="ct-pip__restore cta cta--secondary" type="button" data-pip-restore hidden>Show preview</button>{livePhone && <div class="ct-pip__scrim" data-pip-scrim hidden></div>}
  {!live && (
    /* data-lenis-prevent: the smooth scroll would otherwise take the wheel
       over the dialog and scroll the page behind it, so a page capture could
       never be scrolled with a mouse or trackpad; the page behind is locked
       while it is open (the style's html:has rule) */
    <dialog class="ct-zoom" data-pip-zoom data-lenis-prevent aria-label="Preview, enlarged">
      {/* a phone screen in the same handset, larger and still 1 : 2: a page
          capture scrolls inside it, a clip plays; a board on a paper card,
          whole */}
      <CaseDevice class="ct-zoom__device" data-zoom-device>
        <div class="ct-zoom__media" data-pip-zoom-media></div>
        <span class="ct-hint" slot="home" aria-hidden="true">Scroll <span>↓</span></span>
      </CaseDevice>
      <div class="ct-zoom__board" data-zoom-board></div>
      {/* autofocus: the dialog opens with the focus on its way out, not on a
          page that scrolls (which would draw a focus ring round the screen) */}
      <button class="ct-zoom__close" type="button" aria-label="Close the enlarged preview" data-pip-zoom-close autofocus><span aria-hidden="true">×</span></button>
    </dialog>
  )}
</div>

<script>
  import type { Edge } from '../lib/edge-colour';

  // ---- the device's strips take the screen's edge colours -----------------
  // A still's are read at build time (data-top / data-foot on the screen). A
  // clip's change as it plays — the splash opens on white and fills with
  // purple — so a clip carries its timeline (data-edges, read frame by frame
  // at build time: scripts/clip-edges.mjs), and while it plays the strips take
  // the colours of the frame on show; once it has played they settle on its
  // still's. Never read from a canvas here: Chromium hands a canvas the video
  // darker than a Mac shows it, which left the strips a shade off the screen
  // for the whole clip (2026-10-03).
  const tint = (device: HTMLElement | null, edge: Partial<Edge> | null) => {
    if (!device || !edge?.top || !edge.foot) return;
    device.style.setProperty('--ct-device-top', edge.top);
    device.style.setProperty('--ct-device-foot', edge.foot);
    device.dataset.topInk = edge.topInk ?? 'dark';
    device.dataset.footInk = edge.footInk ?? 'dark';
  };
  const edgeOf = (screen: HTMLElement): Partial<Edge> => ({
    top: screen.dataset.top,
    topInk: screen.dataset.topInk as Edge['topInk'],
    foot: screen.dataset.foot,
    footInk: screen.dataset.footInk as Edge['footInk'],
  });
  // a clip screen's timeline: [seconds, top, top ink, foot, foot ink] at each
  // moment its edges change; null for a still, or a clip with none
  type Moment = [number, string, Edge['topInk'], string, Edge['footInk']];
  const timelines = new WeakMap<HTMLElement, Moment[] | null>();
  const timelineOf = (screen: HTMLElement) => {
    if (!timelines.has(screen)) {
      let moments: Moment[] | null = null;
      try { moments = screen.dataset.edges ? JSON.parse(screen.dataset.edges) : null; } catch { /* none */ }
      timelines.set(screen, moments?.length ? moments : null);
    }
    return timelines.get(screen) ?? null;
  };
  // the edges of the frame at `time`: the last moment at or before it (a
  // frame's presentation time can land a hair before the moment it opens)
  const edgeAt = (screen: HTMLElement, time: number): Edge | null => {
    const moments = timelineOf(screen);
    if (!moments) return null;
    let at = moments[0];
    for (const moment of moments) {
      if (moment[0] <= time + 0.005) at = moment;
      else break;
    }
    return { top: at[1], topInk: at[2], foot: at[3], footInk: at[4] };
  };
  // While a clip plays, the strips follow it frame by frame, with no easing
  // of their own (data-following), so a colour arrives on the frame that
  // brings it; a newer call replaces an older one on the same device.
  const followers = new WeakMap<HTMLElement, number>();
  const follow = (device: HTMLElement | null, screen: HTMLElement, video: HTMLVideoElement, keep: () => boolean) => {
    if (!device || !timelineOf(screen)) return;
    const token = (followers.get(device) ?? 0) + 1;
    followers.set(device, token);
    device.dataset.following = '';
    const step = (time: number) => {
      if (followers.get(device) !== token) return;
      if (!keep()) { delete device.dataset.following; return; }
      tint(device, edgeAt(screen, time));
      schedule();
    };
    const schedule = () => {
      if ('requestVideoFrameCallback' in video) video.requestVideoFrameCallback((_, frame) => step(frame.mediaTime));
      else requestAnimationFrame(() => step(video.currentTime));
    };
    tint(device, edgeAt(screen, video.currentTime));
    schedule();
  };
  const unfollow = (device: HTMLElement | null) => {
    if (!device) return;
    followers.set(device, (followers.get(device) ?? 0) + 1);
    delete device.dataset.following;
  };

  // ---- the phone follows the reading -------------------------------------
  // Every [data-state] on the left is a trigger. The one crossing the reading
  // band — the middle tenth of the screen on a laptop, the middle of what the
  // sticky phone leaves on a phone — picks the screen. A state without a screen
  // keeps the last one, so the phone never goes blank mid-read.
  const panel = document.querySelector<HTMLElement>('[data-case-panel]');
  const root = document.querySelector<HTMLElement>('.ct');
  if (panel && root) {
    const byKey = new Map(
      [...panel.querySelectorAll<HTMLElement>('[data-screen]')].map((el) => [el.dataset.screen!, el])
    );
    // state → its screens, in the order they play, resolved at build time
    // (data-map); empty in live mode
    const stateMap: Record<string, string[]> = JSON.parse(panel.dataset.map || '{}');
    const filesOf = (state: string) =>
      (stateMap[state] ?? []).map((key) => byKey.get(key)).filter((el): el is HTMLElement => Boolean(el));
    const devLabel = panel.querySelector<HTMLElement>('[data-dev-label]');
    const paneTitle = panel.querySelector<HTMLElement>('[data-pane-title]');
    const stateTitles: Record<string, string> = JSON.parse(panel.dataset.titles ?? '{}');
    const triggers = [...root.querySelectorAll<HTMLElement>('[data-state]')];
    // A state with no screen yet shows the nearest earlier state's screens, in
    // reading order — the same whether the reader scrolled down to it, jumped
    // to it or reloaded on it.
    const lender = new Map<HTMLElement, string | undefined>();
    let lastOwn: string | undefined;
    triggers.forEach((t) => {
      if (filesOf(t.dataset.state!).length) lastOwn = t.dataset.state;
      lender.set(t, lastOwn);
    });
    const screensFor = (trigger: HTMLElement) => {
      const from = lender.get(trigger);
      return from ? filesOf(from) : [];
    };

    const still = window.matchMedia('(prefers-reduced-motion: reduce)');
    // the slideshow's beat, and how long a clip's last frame (or its still)
    // stays before the slideshow moves on
    const BEAT = 2600;
    const HOLD = 1200;
    // a clip that has not started this long after it was asked to (a slow or
    // failed load) stops holding the slideshow up; its still stands in
    const CLIP_WAIT = 6000;

    let current: HTMLElement | null = null; // the row being shown
    let seq: HTMLElement[] = []; // its screens, in the order they play
    let seqAt = 0;
    let seqOwn = false; // the screens are the row's own, not borrowed
    let shown: HTMLElement | null = null; // the screen on the phone
    let shownAt = 0;
    let stepAt = 0; // when the slideshow last moved (a row, or a screen within one)
    // the handset the phone screens stand in (null in live mode)
    const device = panel.querySelector<HTMLElement>('[data-device]');

    // ---- screens that move -------------------------------------------------
    // A page capture pans: down, a hold, and back, looping while it is shown.
    // A clip plays once from its first frame each time its screen arrives, then
    // fades back to its still. Both wait while the phone cannot be seen (a
    // hidden tab, the panel scrolled away, the mini player hidden) and neither
    // runs with reduced motion: the page then scrolls by hand and the clip shows
    // its still. A clip that arrives where it cannot be seen (a jump from the
    // top lands it before the phone is reported in view) waits on its first
    // frame and plays once the phone can be seen.
    const pans = new Map<HTMLElement, { anim: Animation; total: number }>();
    const ended = new Map<HTMLElement, number>();
    const clipOf = (el: HTMLElement | null) => el?.querySelector<HTMLVideoElement>('video') ?? null;
    let seen = true;
    let pipOn = true;
    const canCue = () => !still.matches && !document.hidden;
    const canPlay = () => canCue() && seen && pipOn;
    // a clip's file is fetched only once its row is near the reading, or its
    // screen is asked to play — never with reduced motion
    const load = (video: HTMLVideoElement) => {
      if (video.getAttribute('src') || !video.dataset.src || still.matches) return;
      video.preload = 'auto';
      video.src = video.dataset.src;
    };
    // a clip that has played (or cannot) settles on its still, and the
    // device's strips on the still's colours
    const settle = (el: HTMLElement) => {
      ended.set(el, performance.now());
      el.classList.add('is-ended');
      clipOf(el)?.pause();
      if (el === shown) {
        unfollow(device);
        tint(device, edgeOf(el));
        plan();
      }
    };
    // a clip on show and running: the strips follow its frames
    const followClip = (el: HTMLElement) => {
      const video = clipOf(el);
      if (!video || el !== shown || !el.classList.contains('is-cued') || ended.has(el)) return;
      follow(device, el, video, () => el === shown && !ended.has(el) && !video.paused);
    };
    // A CLIP NEVER OPENS ON ITS STILL. The still is its ending (the order
    // confirmation's is the confirmed screen), so showing it first would give
    // the ending away and then cut back to the start. A clip's screen arrives
    // only once the clip's first frame is ready — the screen before it stays
    // up until then, its title with it — and plays from there. Preloaded as its
    // row nears the reading, that is a frame or two; on a cold jump it is the
    // first chunk of the file. A clip whose first frame has not come within
    // CUE_WAIT (a slow line) arrives as its still and does not play this time.
    const CUE_WAIT = 1500;
    let pending: HTMLElement | null = null; // the clip screen waiting for its first frame
    let cueTimer = 0;
    const atStart = (video: HTMLVideoElement) => video.readyState >= 2 && !video.seeking && video.currentTime < 0.1;
    const cued = (el: HTMLElement, ok: boolean) => {
      if (pending !== el) return;
      pending = null;
      window.clearTimeout(cueTimer);
      ended.delete(el);
      el.classList.remove('is-ended');
      el.classList.toggle('is-cued', ok);
      if (!ok) settle(el);
      swap(el);
      plan();
      followClip(el);
    };
    const cue = (el: HTMLElement, video: HTMLVideoElement) => {
      pending = el;
      load(video);
      window.clearTimeout(cueTimer);
      cueTimer = window.setTimeout(() => cued(el, false), CUE_WAIT);
      if (atStart(video)) { cued(el, true); return; }
      // played before: back to its first frame ('seeked' cues it)
      if (video.readyState >= 2) {
        try { video.currentTime = 0; } catch { /* not seekable: the wait runs out */ }
        return;
      }
      // nothing loaded yet: playing it is what fetches it everywhere (iOS
      // ignores preload), and muted it may; its first 'playing' cues it
      video.play().catch((error: unknown) => { if ((error as DOMException)?.name === 'NotAllowedError') cued(el, false); });
    };
    const uncue = () => {
      if (!pending) return;
      const el = pending;
      pending = null;
      window.clearTimeout(cueTimer);
      clipOf(el)?.pause();
    };
    // a browser that refuses to play it (a battery saver) leaves the still,
    // and the slideshow treats it as one; an interrupted play just waits
    const play = (el: HTMLElement, video: HTMLVideoElement) => {
      video.play().catch((error: unknown) => { if ((error as DOMException)?.name === 'NotAllowedError') settle(el); });
    };

    const startPan = (el: HTMLElement) => {
      const page = el.querySelector<HTMLElement>('.ct-screen__page');
      const travel = Number(el.dataset.pan);
      if (!page || !(travel > 0)) return;
      pans.get(el)?.anim.cancel();
      // slow enough to read: about a tenth of a second per percent of the page
      // it travels (2–5s down), back up in half that, a hold at each end
      const down = Math.min(5000, Math.max(2000, travel * 100));
      const up = down / 2;
      const total = HOLD + down + HOLD + up;
      const ease = 'cubic-bezier(0.65, 0, 0.35, 1)';
      const top = 'translateY(0)';
      const bottom = `translateY(-${travel}%)`;
      const anim = page.animate(
        [
          { transform: top, offset: 0 },
          { transform: top, offset: HOLD / total, easing: ease },
          { transform: bottom, offset: (HOLD + down) / total },
          { transform: bottom, offset: (HOLD + down + HOLD) / total, easing: ease },
          { transform: top, offset: 1 },
        ],
        { duration: total, iterations: Infinity }
      );
      if (!canPlay()) anim.pause();
      pans.set(el, { anim, total });
    };
    // a clip arrives cued (its first frame up) and plays on from there, or,
    // out of sight, holds that frame until sync() starts it; one whose first
    // frame never came stays on its still
    const startClip = (el: HTMLElement) => {
      const video = clipOf(el);
      if (!video) return;
      if (!el.classList.contains('is-cued')) {
        if (!ended.has(el)) settle(el);
        return;
      }
      const go = canPlay();
      if (!go) video.pause();
      if (video.paused && video.currentTime >= 0.1) {
        try { video.currentTime = 0; } catch { /* it plays from where it is */ }
      }
      if (go) play(el, video);
    };
    // what a screen does as it arrives, and as it leaves (once its fade-out is
    // over, unless it has come straight back)
    const enter = (el: HTMLElement) => {
      const scroller = el.querySelector<HTMLElement>('[data-pan-scroll]');
      if (scroller) {
        scroller.scrollTop = 0;
        el.classList.remove('is-end');
        // only the page on show can be scrolled to, by hand, beside the text
        scroller.tabIndex = still.matches && wide.matches ? 0 : -1;
      }
      if (still.matches) return;
      if (el.dataset.fit === 'pan') startPan(el);
      startClip(el);
    };
    const leave = (el: HTMLElement) => {
      const scroller = el.querySelector<HTMLElement>('[data-pan-scroll]');
      if (scroller) scroller.tabIndex = -1;
      window.setTimeout(() => {
        if (el === shown || el === pending) return;
        pans.get(el)?.anim.cancel();
        pans.delete(el);
        clipOf(el)?.pause();
        el.classList.remove('is-cued', 'is-ended');
      }, 700);
    };
    // the shown screen keeps moving only while the phone can be seen
    const sync = () => {
      if (!shown) return;
      const go = canPlay();
      const pan = pans.get(shown)?.anim;
      if (pan) { if (go) pan.play(); else pan.pause(); }
      const video = clipOf(shown);
      if (video && shown.classList.contains('is-cued') && !ended.has(shown)) { if (go) play(shown, video); else video.pause(); }
    };
    byKey.forEach((el) => {
      const video = clipOf(el);
      if (video) {
        // the first frame is ready: back from a seek, or loaded fresh
        const ready = () => { if (pending === el && atStart(video)) cued(el, true); };
        video.addEventListener('loadeddata', ready);
        video.addEventListener('seeked', ready);
        video.addEventListener('playing', () => {
          // started to fetch it: it is at its first frame and running
          if (pending === el) { cued(el, true); return; }
          // a start that comes after its screen gave up on it, or left
          if (el !== shown || ended.has(el)) { video.pause(); return; }
          plan();
          followClip(el);
        });
        video.addEventListener('ended', () => settle(el));
        video.addEventListener('error', () => { if (pending === el) cued(el, false); else settle(el); });
      }
      const scroller = el.querySelector<HTMLElement>('[data-pan-scroll]');
      if (scroller) {
        // the "Scroll" hint stays until the page's foot is in view
        scroller.addEventListener('scroll', () => {
          el.classList.toggle('is-end', scroller.scrollTop + scroller.clientHeight >= scroller.scrollHeight - 4);
        }, { passive: true });
      }
    });

    // How long the shown screen still needs before it may be replaced: a pan
    // finishes its round trip, a clip plays and holds. A still image needs
    // nothing beyond the beat.
    const readyIn = (el: HTMLElement | null, now: number) => {
      if (!el || still.matches) return 0;
      const pan = pans.get(el);
      if (pan) {
        const t = Number(pan.anim.currentTime ?? 0);
        const into = t % pan.total;
        return t >= pan.total && into < HOLD ? 0 : pan.total - into;
      }
      const video = clipOf(el);
      if (video) {
        const end = ended.get(el);
        if (end !== undefined) return Math.max(0, end + HOLD - now);
        if (!video.paused && video.duration) return (video.duration - video.currentTime) * 1000 + HOLD;
        // not playing yet: wait for it ('playing' plans again), never forever
        return Math.max(0, CLIP_WAIT - (now - shownAt));
      }
      return 0;
    };

    // ---- what the phone shows ------------------------------------------------
    // The card's title names the screen on the phone: a row's first screen is
    // named by the row's own title, any later one by its file's (the Mall tab's
    // PiP), and a borrowed screen keeps the title it came with.
    const titleOf = (screen: HTMLElement | null) => {
      const state = current?.dataset.state ?? '';
      if (!screen) return stateTitles[state] ?? '';
      if (seqOwn && seqAt === 0) return stateTitles[state] ?? screen.dataset.title ?? '';
      return screen.dataset.title ?? stateTitles[state] ?? '';
    };
    // The card around a screen: its title, whether a board stands in the
    // device's place, and the device's strips. Nothing here changes a size:
    // the card, the device and its display are one constant size per screen
    // (Uttham, 2026-10-03: "everything should have constant height and width").
    const dress = (screen: HTMLElement | null) => {
      const title = titleOf(screen);
      // only a change is written, so the live title never repeats itself; the
      // whole of it stays as the title, for the line that ends in an ellipsis
      if (paneTitle && paneTitle.textContent !== title) {
        paneTitle.textContent = title;
        paneTitle.title = title;
      }
      const board = screen?.dataset.kind === 'board';
      panel.classList.toggle('is-board', board);
      // an empty phone is the device's own white, not the last screen's colours
      if (!screen) tint(device, { top: 'var(--paper-1)', topInk: 'dark', foot: 'var(--paper-1)', footInk: 'dark' });
      if (!screen || board) { unfollow(device); return; }
      // a clip that is running, or cued on its first frame, gives its frame's
      // colours; anything else its export's
      const video = clipOf(screen);
      const live = video && screen.classList.contains('is-cued') && !ended.has(screen) ? edgeAt(screen, video.currentTime) : null;
      if (!live) unfollow(device);
      tint(device, live ?? edgeOf(screen));
    };
    // a screen's handwritten notes, beside the device: they fade with it
    const noteSets = [...panel.querySelectorAll<HTMLElement>('[data-notes-for]')];
    const swap = (next: HTMLElement | null) => {
      dress(next);
      // the same screen stays: no new transition, its pan or clip runs on
      if (next === shown) return;
      const prev = shown;
      prev?.classList.remove('is-on');
      next?.classList.add('is-on');
      noteSets.forEach((set) => set.classList.toggle('is-on', Boolean(next) && set.dataset.notesFor === next?.dataset.screen));
      shown = next;
      shownAt = performance.now();
      if (prev) leave(prev);
      if (next) enter(next);
    };
    const render = () => {
      const next = seq[seqAt] ?? null;
      if (next && next === pending) return; // its first frame is on its way
      uncue();
      const video = next !== shown ? clipOf(next) : null;
      if (next && video && canCue()) cue(next, video);
      else swap(next);
    };

    const show = (trigger: HTMLElement, part?: number) => {
      if (trigger === current) return;
      current?.classList.remove('is-current');
      trigger.classList.add('is-current');
      current = trigger;
      const state = trigger.dataset.state!;
      panel.dataset.showing = state;
      // a live preview (a running tool in the slot) follows along by event
      document.dispatchEvent(new CustomEvent('case:state', { detail: { state } }));
      const own = filesOf(state);
      seq = own.length ? own : screensFor(trigger);
      seqOwn = own.length > 0;
      // a row's own screens start from the first (under reduced motion, from
      // wherever the reading is in the row); borrowed ones carry on from the
      // screen on show, so a row that borrows never replays its lender's
      seqAt = seqOwn ? Math.min(part ?? 0, seq.length - 1) : Math.max(0, shown ? seq.indexOf(shown) : 0);
      stepAt = performance.now();
      // Nothing is ever written over a screen (Uttham, 2026-10-03: "placeholder
      // text coming on top of images"): the label shows only on an empty phone,
      // and the dev server names a borrowed state in the console instead.
      if (devLabel) {
        if (devLabel.dataset.dev && !own.length && seq.length) console.info(`[case] No screen yet: ${state}`);
        devLabel.textContent = seq.length ? '' : devLabel.dataset.dev ? `No screen yet: ${state}` : 'Screen coming soon';
      }
      render();
    };

    const wide = window.matchMedia('(min-width: 768px)');
    const visible = new Set<HTMLElement>();
    let io: IntersectionObserver | null = null;

    const pick = () => {
      const tail = tailBand();
      const pool: Iterable<HTMLElement> = tail === null ? visible : triggers;
      if (tail === null && !visible.size) return;
      const mid = tail ?? bandCentre();
      let best: HTMLElement | null = null;
      let bestD = Infinity;
      for (const el of pool) {
        const r = el.getBoundingClientRect();
        const d = Math.abs((r.top + r.bottom) / 2 - mid);
        if (d < bestD) { bestD = d; best = el; }
      }
      if (best) choose(best, still.matches ? partOf(best, mid) : 0);
    };
    // With reduced motion nothing plays, so a row with several screens (the
    // Mall tab: its modal, then its PiP) shares itself out among them by the
    // reading: as the band passes from the row's top to its foot it shows
    // each in turn, and no screen of the row is out of reach.
    const partOf = (el: HTMLElement, mid: number) => {
      const n = filesOf(el.dataset.state!).length;
      if (n < 2) return 0;
      const r = el.getBoundingClientRect();
      return Math.min(n - 1, Math.max(0, Math.floor(((mid - r.top) / r.height) * n)));
    };

    // ---- each block plays as a slideshow -------------------------------------
    // (Uttham, 2026-10-02: "the section be understood where decisions happen,
    // there will be one gif, with 4 images, the preview runs these 4 slideshows,
    // accordingly the highlight changes in the left, implement this
    // functionality in all the blocks"). Once the reading reaches a block of
    // rows or steps that shows two or more different screens, the phone runs
    // through them in order, a beat each, and the row it is showing takes the
    // highlight; scrolling within the block leaves it playing, scrolling to
    // another block or section hands over. Hovering or focusing a row holds
    // the slideshow on that row. Reduced motion, or a hidden tab: no
    // autoplay — the reading picks the row, as before, and within a row with
    // several screens it picks the screen too (partOf, above).
    // A row with several screens plays them in turn, a beat each, and so does
    // a lone state with several (it loops them). A beat never takes a screen
    // away before it has finished: a pan completes its round trip, a clip
    // plays and holds. Rows that share a screen hand it on as it is.
    const groupOf = (el: HTMLElement) => {
      const list = el.parentElement;
      if (!list?.classList.contains('ct-steps')) return null;
      const items = [...list.children].filter((c): c is HTMLElement => c instanceof HTMLElement && Boolean(c.dataset.state));
      return new Set(items.map((i) => i.dataset.state)).size > 1 ? { list, items } : null;
    };
    let playing: { list: Element; items: HTMLElement[] } | null = null;
    let at = 0;
    let held = false;
    let beat = 0;
    const stopBeat = () => { window.clearTimeout(beat); beat = 0; };
    // the next step: the row's next screen, else the block's next row, else
    // (a held row, a lone state) back to the first of several screens
    const upcoming = (): { row?: HTMLElement; screen: HTMLElement | null } | null => {
      if (seqAt < seq.length - 1) return { screen: seq[seqAt + 1] };
      if (playing && !held) {
        const row = playing.items[(at + 1) % playing.items.length];
        return { row, screen: screensFor(row)[0] ?? null };
      }
      if (seq.length > 1) return { screen: seq[0] };
      return null;
    };
    const plan = () => {
      stopBeat();
      if (still.matches || document.hidden) return;
      const next = upcoming();
      if (!next) return;
      const now = performance.now();
      const wait = next.screen === shown ? 0 : readyIn(shown, now);
      const due = Math.max(stepAt + BEAT, now + wait);
      beat = window.setTimeout(step, Math.max(0, due - now));
    };
    const step = () => {
      beat = 0;
      // a clip that stalled or paused since the beat was set is still owed
      // its time: plan again rather than cut it off
      const next = upcoming();
      if (next && next.screen !== shown && readyIn(shown, performance.now()) > 50) { plan(); return; }
      if (seqAt < seq.length - 1) seqAt += 1;
      else if (playing && !held) {
        at = (at + 1) % playing.items.length;
        show(playing.items[at]);
        plan();
        return;
      } else if (seq.length > 1) seqAt = 0;
      else return;
      stepAt = performance.now();
      render();
      plan();
    };
    const choose = (trigger: HTMLElement, part = 0) => {
      const group = groupOf(trigger);
      const sameBlock = Boolean(playing && group && group.list === playing.list);
      // the block plays on — unless nothing plays (reduced motion), when the
      // reading picks each row and each of a row's screens, as it always did
      if (sameBlock && !still.matches) return;
      if (!sameBlock) {
        playing = group;
        held = false;
      }
      at = group ? group.items.indexOf(trigger) : 0;
      if (trigger === current) {
        // the same row: the reading has moved on to its next screen (reduced
        // motion), or a new block has taken the row on as it is
        if (still.matches && seqOwn && part < seq.length) seqAt = part;
        render();
      } else show(trigger, part);
      plan();
    };
    document.querySelectorAll<HTMLElement>('.ct-steps').forEach((list) => {
      const hold = (event: Event) => {
        // reduced motion: nothing plays, so there is nothing to hold — the
        // reading alone picks, and a pointer resting on the text while the
        // wheel turns cannot pull the phone away from it
        if (still.matches) return;
        const item = (event.target as HTMLElement).closest<HTMLElement>('.ct-step[data-state]');
        if (!item || !playing || playing.list !== list) return;
        held = true;
        at = playing.items.indexOf(item);
        show(item);
        plan();
      };
      const release = () => {
        if (!playing || playing.list !== list) return;
        held = false;
        stepAt = performance.now();
        plan();
      };
      list.addEventListener('pointerover', hold);
      list.addEventListener('focusin', hold);
      list.addEventListener('pointerleave', release);
      list.addEventListener('focusout', release);
    });
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) stepAt = performance.now();
      sync();
      plan();
    });
    // reduced motion switched on or off mid-read: the shown screen arrives
    // again under the new rule
    still.addEventListener('change', () => {
      uncue();
      const el = shown;
      if (el) {
        pans.get(el)?.anim.cancel();
        pans.delete(el);
        clipOf(el)?.pause();
        ended.delete(el);
        el.classList.remove('is-cued', 'is-ended');
        enter(el);
      }
      render(); // a clip that was waiting for its first frame arrives under the new rule
      stepAt = performance.now();
      plan();
    });
    // the phone in view, and (on phones) the mini player out
    const phoneEl = panel.querySelector<HTMLElement>('.ct-phone');
    if (phoneEl) new IntersectionObserver(([e]) => { seen = e.isIntersecting; sync(); }).observe(phoneEl);
    document.addEventListener('case:pip', (event) => { pipOn = (event as CustomEvent<{ on: boolean }>).detail.on; sync(); });
    // clips are fetched as their rows come within a screen of the reading
    const near = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement;
        screensFor(el).forEach((s) => { const video = clipOf(s); if (video) load(video); });
      });
    }, { rootMargin: '100% 0px' });
    triggers.forEach((t) => { if (screensFor(t).some((s) => clipOf(s))) near.observe(t); });

    // The reading band's centre, in viewport px: the middle of the screen at
    // every width now that phones float the preview instead of stacking it.
    const bandCentre = () => innerHeight / 2;

    // Where a page ends on its last rows (the AI Space pages have nothing
    // after them), those rows can never scroll up to the middle, so the
    // preview would never reach them. Only then, over the last half screen of
    // scrolling, the band slides from the middle down to the last row's centre
    // and every trigger is a candidate. A page whose rows all reach the middle
    // (a case study, with "More cases" after it) never takes this path.
    const tailBand = (): number | null => {
      const last = triggers[triggers.length - 1];
      if (!last) return null;
      const half = innerHeight / 2;
      const maxScroll = document.documentElement.scrollHeight - innerHeight;
      const r = last.getBoundingClientRect();
      const lastMid = r.top + scrollY + r.height / 2;
      if (lastMid <= maxScroll + half) return null;
      const remaining = maxScroll - scrollY;
      if (remaining >= half) return null;
      const t = 1 - Math.max(0, remaining) / half;
      return half + t * (lastMid - maxScroll - half);
    };

    const observe = () => {
      io?.disconnect();
      visible.clear();
      const mid = bandCentre();
      const half = innerHeight * 0.05;
      const top = Math.max(0, Math.round(mid - half));
      const bottom = Math.max(0, Math.round(innerHeight - mid - half));
      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const el = e.target as HTMLElement;
            if (e.isIntersecting) visible.add(el);
            else visible.delete(el);
          });
          pick();
        },
        { rootMargin: `-${top}px 0px -${bottom}px 0px`, threshold: 0 }
      );
      triggers.forEach((t) => io!.observe(t));
    };

    // The observer only speaks when a row crosses the band's edge, and smooth
    // scrolling keeps moving after it has spoken — so the choice is re-made on
    // every scroll frame too, from the rows the observer says are in the band.
    let frame = 0;
    window.addEventListener('scroll', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; pick(); });
    }, { passive: true });

    if (triggers[0]) choose(triggers[0]);
    observe();
    wide.addEventListener('change', observe);
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(observe, 150);
    });
    document.addEventListener('case:full-open', observe);
  }

  // ---- phones: the preview floats (learnt from the bus-discovery reference) --
  // Below 768px there is no room beside the text, so the phone becomes a mini
  // player in the bottom-right corner: it appears once the hero has gone, keeps
  // following the reading, opens full size on a tap, hides on ×, and steps out
  // of the way at the end of the study. A live tool in the teaser's phone
  // (frame="phone") opens full size in place instead of in the dialog — moving
  // an iframe reloads it — and × or the dimmed page shrinks it back.
  {
    const panelEl = document.querySelector<HTMLElement>('[data-case-panel]');
    const heroEl = document.querySelector<HTMLElement>('.ct-hero');
    const endEl = document.querySelector<HTMLElement>('[data-case-end]');
    const restore = document.querySelector<HTMLButtonElement>('[data-pip-restore]');
    const close = document.querySelector<HTMLButtonElement>('[data-pip-close]');
    const enlarge = document.querySelector<HTMLButtonElement>('[data-pip-enlarge]');
    const zoom = document.querySelector<HTMLDialogElement>('[data-pip-zoom]');
    const zoomMedia = document.querySelector<HTMLElement>('[data-pip-zoom-media]');
    const zoomClose = document.querySelector<HTMLButtonElement>('[data-pip-zoom-close]');
    const scrim = document.querySelector<HTMLElement>('[data-pip-scrim]');
    if (panelEl && heroEl && endEl && restore && close) {
      const phone = window.matchMedia('(max-width: 767.98px)');
      let heroGone = false;
      let atEnd = false;
      let dismissed = false;
      // live phone only: the mini player grown to full size where it stands
      let big = false;
      const hideLabel = close.getAttribute('aria-label') ?? '';
      const grow = (on: boolean) => {
        if (!scrim || big === on) return;
        big = on;
        panelEl.classList.toggle('is-pip-big', on);
        scrim.hidden = !on;
        close.setAttribute('aria-label', on ? 'Shrink the preview' : hideLabel);
      };
      const sync = () => {
        const inPlay = phone.matches && heroGone && !atEnd;
        if (!inPlay) grow(false);
        panelEl.classList.toggle('is-pip-on', inPlay && !dismissed);
        restore.hidden = !(inPlay && dismissed);
        // the phone's moving screens wait while the mini player is away
        document.dispatchEvent(new CustomEvent('case:pip', { detail: { on: !phone.matches || (inPlay && !dismissed) } }));
      };
      new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.bottom <= 0; sync(); }).observe(heroEl);
      new IntersectionObserver(([e]) => { atEnd = e.isIntersecting || e.boundingClientRect.top < 0; sync(); }).observe(endEl);
      phone.addEventListener('change', sync);

      close.addEventListener('click', () => {
        if (big) { grow(false); enlarge?.focus(); return; }
        dismissed = true; sync(); restore.focus();
      });
      restore.addEventListener('click', () => { dismissed = false; sync(); (enlarge ?? close).focus(); });

      // screens: the current screen opens in the dialog — from the mini
      // player on phones, and from a board standing in the device's place on
      // the card. A live tool has no single screen to show there, so the
      // teaser's live phone grows in place.
      // A phone screen opens in the same handset, larger, by the same rules:
      // the display is 1 : 2 and the device one size for every screen; a
      // 1 : 2 screen fills it, a shorter one fits and is filled with its edge
      // colours, a page capture scrolls by hand (the "Scroll ↓" chip in the
      // home strip until its foot is in view), a clip plays once from its first
      // frame and settles on its still, or with reduced motion shows the
      // still. As on the card, the clip opens on its first frame, never on its
      // still (its ending): the display stays its edge colour until that frame
      // is in, CUE_WAIT at most, past which the still stands in and the clip
      // does not play. A board opens whole on a paper card, as large as the
      // screen allows and never past its own pixels.
      const zoomDevice = zoom?.querySelector<HTMLElement>('[data-zoom-device]') ?? null;
      const zoomBoard = zoom?.querySelector<HTMLElement>('[data-zoom-board]') ?? null;
      if (enlarge && zoom && zoomMedia && zoomClose && zoomDevice && zoomBoard) {
        const stillMotion = window.matchMedia('(prefers-reduced-motion: reduce)');
        const CUE_WAIT = 1500;
        let cueTimer = 0;
        let opener: HTMLElement | null = null;
        zoomMedia.addEventListener('scroll', () => {
          zoom.classList.toggle('is-end', zoomMedia.scrollTop + zoomMedia.clientHeight >= zoomMedia.scrollHeight - 4);
        }, { passive: true });
        const openBoard = (on: HTMLElement, src: HTMLImageElement) => {
          const pic = document.createElement('img');
          pic.className = 'ct-zoom__board-img';
          if (src.srcset) {
            pic.srcset = src.srcset;
            pic.sizes = 'min(100vw, 1200px)';
          }
          pic.src = src.currentSrc || src.src;
          pic.alt = src.alt;
          zoomBoard.replaceChildren(pic);
          zoom.style.setProperty('--zoom-board-r', on.dataset.ratio ?? '1');
          zoom.style.setProperty('--zoom-board-max', `${on.dataset.width ?? 1200}px`);
        };
        const openScreen = (on: HTMLElement, src: HTMLImageElement) => {
          const pan = on.dataset.fit === 'pan';
          const pic = document.createElement('img');
          pic.className = 'ct-zoom__img';
          pic.src = src.currentSrc || src.src;
          pic.alt = src.alt || on.getAttribute('aria-label') || '';
          zoomMedia.replaceChildren(pic);
          zoomMedia.style.setProperty('--ct-fill-top', on.dataset.top ?? '');
          zoomMedia.style.setProperty('--ct-fill-foot', on.dataset.foot ?? '');
          // a page capture's own proportion: the dialog's handset grows as
          // tall as a real one (19.5 : 9, in the style) to show more of it
          zoom.style.setProperty('--ct-zoom-page-r', on.dataset.ratio ?? '2');
          // a shorter screen stands where it does on the card (anchorFor)
          if (on.dataset.anchor) zoom.dataset.anchor = on.dataset.anchor;
          else delete zoom.dataset.anchor;
          unfollow(zoomDevice);
          tint(zoomDevice, edgeOf(on));
          zoom.classList.toggle('is-pan', pan);
          const clip = on.querySelector<HTMLVideoElement>('video');
          if (clip?.dataset.src && !stillMotion.matches) {
            const video = document.createElement('video');
            video.className = 'ct-zoom__clip';
            video.muted = true;
            video.playsInline = true;
            video.src = clip.dataset.src;
            video.setAttribute('aria-hidden', 'true');
            zoom.classList.add('is-cueing');
            const begun = () => zoom.classList.remove('is-cueing');
            const rest = () => { unfollow(zoomDevice); tint(zoomDevice, edgeOf(on)); };
            const fail = () => { video.pause(); video.classList.add('is-ended'); begun(); rest(); };
            // the clip's first frame, and from then on the frame on show
            video.addEventListener('loadeddata', () => { begun(); tint(zoomDevice, edgeAt(on, 0) ?? edgeOf(on)); }, { once: true });
            video.addEventListener('playing', () => {
              begun();
              follow(zoomDevice, on, video, () => zoom.open && video.isConnected && !video.paused);
            });
            video.addEventListener('ended', () => { video.classList.add('is-ended'); rest(); });
            video.addEventListener('error', fail);
            cueTimer = window.setTimeout(() => { if (video.readyState < 2) fail(); }, CUE_WAIT);
            zoomMedia.append(video);
            video.play().catch((error: unknown) => { if ((error as DOMException)?.name === 'NotAllowedError') fail(); });
          }
        };
        enlarge.addEventListener('click', () => {
          const on = panelEl.querySelector<HTMLElement>('.ct-screen.is-on');
          const src = on instanceof HTMLImageElement ? on : on?.querySelector<HTMLImageElement>('img');
          if (!on || !src) return;
          window.clearTimeout(cueTimer);
          zoom.classList.remove('is-cueing', 'is-end', 'is-pan');
          const board = on.dataset.kind === 'board';
          zoom.classList.toggle('is-board', board);
          zoomMedia.replaceChildren();
          zoomBoard.replaceChildren();
          if (board) openBoard(on, src);
          else openScreen(on, src);
          zoomMedia.scrollTop = 0;
          opener = document.activeElement instanceof HTMLElement ? document.activeElement : enlarge;
          zoom.showModal();
        });
        zoomClose.addEventListener('click', () => zoom.close());
        // a tap on the dimmed backdrop closes it too
        zoom.addEventListener('click', (event) => { if (event.target === zoom) zoom.close(); });
        zoom.addEventListener('close', () => {
          window.clearTimeout(cueTimer);
          unfollow(zoomDevice);
          zoom.classList.remove('is-cueing');
          zoomMedia.replaceChildren();
          zoomBoard.replaceChildren();
          // back to what opened it, if it can still take the focus (a board
          // the slideshow has since moved on from hides its button)
          const back = opener && opener.isConnected && opener.offsetParent !== null ? opener : enlarge;
          back.focus({ preventScroll: true });
        });
      } else if (enlarge && scrim) {
        const shrink = () => { grow(false); enlarge.focus(); };
        enlarge.addEventListener('click', () => { grow(true); close.focus(); });
        scrim.addEventListener('click', shrink);
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && big) shrink(); });
      }
    }
  }

  // ---- scroll points: which section or sub-group is being read ------------
  // The current point is the last heading whose top has passed 40% of the
  // screen — re-checked each scroll frame, and when the full study opens (its
  // blocks join the rail then). On a screen too short for the whole rail the
  // list scrolls, and keeps the current tick (and its tooltip) in view.
  {
    const nav = document.querySelector<HTMLElement>('[data-points]');
    if (nav) {
      const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-point]')];
      const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
      let current: HTMLAnchorElement | null = null;

      // The tooltips keep clear of the card (see .ct-points__label): the
      // gutter between the card's right edge and the rail, less a --space-2
      // of air, is the most a tooltip and its tick may take (--pt-room). A
      // title that misses by a --space-1 or less takes that much of the air
      // (--pt-give) rather than lose its last letters to an ellipsis; a longer
      // one ends in an ellipsis, and one that would keep fewer than --space-8
      // of its title stays off. A cut or hidden title is still named on hover
      // by the link's own title (the browser's tooltip), and its accessible
      // name is the whole heading. Measured again on a resize, when the card
      // changes size, when the fonts arrive, when the current tick (and so its
      // length) changes and when the full study's ticks join.
      const pane = document.querySelector<HTMLElement>('.ct-pane');
      const px = (name: string, fallback: number) => parseFloat(getComputedStyle(nav).getPropertyValue(name)) || fallback;
      const fit = () => {
        const shown = links.filter((a) => a.offsetParent !== null);
        if (!pane || !shown.length) return;
        const card = pane.getBoundingClientRect();
        const rail = shown[0].getBoundingClientRect();
        if (!card.width || !rail.width) return;
        const air = px('--space-2', 8);
        const give = px('--space-1', 4);
        const least = px('--space-8', 64);
        nav.style.setProperty('--pt-room', `${Math.max(0, Math.floor(rail.right - card.right - air))}px`);
        shown.forEach((a) => {
          const label = a.querySelector<HTMLElement>('.ct-points__label');
          const tick = a.querySelector<HTMLElement>('.ct-points__tick');
          if (!label || !tick) return;
          a.removeAttribute('data-tip-off');
          // the label's right edge is a --space-2 left of its tick
          const room = Math.floor(tick.getBoundingClientRect().left - air - card.right - air);
          const whole = Math.ceil(label.scrollWidth + 2); // its 1px border each side
          const short = whole - room;
          label.style.setProperty('--pt-give', `${short > 0 && short <= give ? short : 0}px`);
          const off = room < Math.min(whole, least);
          a.toggleAttribute('data-tip-off', off);
          // cut or off: the whole heading on hover, from the browser
          if (off || short > give) a.title = a.getAttribute('aria-label') ?? '';
          else a.removeAttribute('title');
        });
      };
      if (pane) new ResizeObserver(() => fit()).observe(pane);
      window.addEventListener('resize', fit);
      document.fonts?.ready.then(fit);
      const update = () => {
        const line = innerHeight * 0.4;
        let next: HTMLAnchorElement | null = null;
        targets.forEach((t, i) => {
          if (t && !t.closest('[hidden]') && t.getBoundingClientRect().top <= line) next = links[i];
        });
        if (next === current) return;
        current?.removeAttribute('aria-current');
        (next as HTMLAnchorElement | null)?.setAttribute('aria-current', 'location');
        current = next;
        fit(); // the current tick is longer, so its tooltip has less room
        const list = nav.querySelector<HTMLElement>('.ct-points__list');
        const point = current as HTMLAnchorElement | null;
        if (list && point && list.scrollHeight > list.clientHeight) {
          const lr = list.getBoundingClientRect();
          const tr = point.getBoundingClientRect();
          if (tr.top < lr.top || tr.bottom > lr.bottom) list.scrollTop += tr.top - lr.top - lr.height / 2 + tr.height / 2;
        }
      };
      let frame = 0;
      window.addEventListener('scroll', () => {
        if (frame) return;
        frame = requestAnimationFrame(() => { frame = 0; update(); });
      }, { passive: true });
      window.addEventListener('resize', update);
      document.addEventListener('case:full-open', () => {
        nav.querySelectorAll<HTMLElement>('.ct-points__full').forEach((li) => { li.hidden = false; });
        update();
        fit();
      });
      update();
    }
  }

  // ---- the prompt: copied word for word --------------------------------------
  // The panel's <pre> is the source, so what is read and what is copied are the
  // same text. Clipboard blocked (an insecure origin, a denied permission): the
  // prompt is selected and the old copy command tried, so the reader can still
  // take it.
  document.querySelectorAll<HTMLElement>('[data-prompt]').forEach((panel) => {
    const btn = panel.querySelector<HTMLButtonElement>('[data-copy-prompt]');
    const text = panel.querySelector<HTMLElement>('[data-prompt-text]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!btn || !text) return;

    // Expand / collapse. A prompt only a few lines past the collapsed height
    // is simply shown open: folding away three lines is not worth a control.
    const more = panel.querySelector<HTMLButtonElement>('[data-prompt-more]');
    const moreLabel = more?.querySelector<HTMLElement>('[data-more-label]');
    const moreArr = more?.querySelector<HTMLElement>('[data-more-arr]');
    if (more && moreLabel && moreArr) {
      const set = (open: boolean) => {
        panel.toggleAttribute('data-collapsed', !open);
        more.setAttribute('aria-expanded', String(open));
        moreLabel.textContent = open ? 'Show less' : 'Show the full prompt';
        moreArr.textContent = open ? '↑' : '↓';
      };
      const full = text.scrollHeight;
      set(false);
      if (full - text.clientHeight < 4 * parseFloat(getComputedStyle(text).lineHeight)) set(true);
      else more.hidden = false;
      more.addEventListener('click', () => set(panel.hasAttribute('data-collapsed')));
    }

    const label = btn.textContent ?? '';
    const done = btn.dataset.copied ?? 'Copied';
    let timer = 0;
    btn.addEventListener('click', async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(text.textContent ?? '');
      } catch {
        const range = document.createRange();
        range.selectNodeContents(text);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        try { ok = document.execCommand('copy'); } catch { ok = false; }
      }
      if (!ok) return;
      btn.textContent = done;
      if (status) status.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = label;
        if (status) status.textContent = '';
      }, 1600);
    });
  });

  // ---- the light gate ------------------------------------------------------
  // Uttham chose a light gate (2026-10-01): a speed bump, not protection — the
  // full study is in the page. The password is compared by its SHA-256, which
  // `npm run case-password` writes to src/data/case-gate.ts. With no password
  // set, the dev server opens it with any entry and a production build for no one.
  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const full = document.getElementById('full');
  if (gate && full) {
    const openBtn = gate.querySelector<HTMLButtonElement>('[data-gate-open]')!;
    const form = gate.querySelector<HTMLFormElement>('[data-gate-form]')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const msg = form.querySelector<HTMLElement>('[data-gate-msg]')!;
    const hash = gate.dataset.hash ?? '';
    const dev = gate.dataset.dev === '1';
    const KEY = 'plp-case-full-open';
    const JUMP = 'case-full-jump';

    // Open: the full study takes the place of the card that promised it — the
    // gate and the "In the full case study" list step aside.
    const reveal = (focus: boolean) => {
      full.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      openBtn.hidden = true;
      form.hidden = true;
      gate.classList.add('is-open');
      gate.hidden = true;
      document.querySelectorAll<HTMLElement>('[data-inside]').forEach((el) => { el.hidden = true; });
      document.dispatchEvent(new Event('case:full-open'));
      if (focus) document.getElementById('full-title')?.focus({ preventScroll: true });
    };

    // A right password reloads the whole page (Uttham, 2026-10-02: "once I
    // enter the password the whole page should refresh"), which then opens on
    // load and lands on the separator above the added content. Storage blocked:
    // no reload, the study simply opens in place.
    let stored = false;
    try { stored = sessionStorage.getItem(KEY) === '1'; } catch { /* storage blocked */ }
    if (stored) {
      reveal(false);
      let jump = false;
      try { jump = sessionStorage.getItem(JUMP) === '1'; sessionStorage.removeItem(JUMP); } catch { /* storage blocked */ }
      if (jump) {
        requestAnimationFrame(() => requestAnimationFrame(() => {
          full.scrollIntoView({ block: 'start' });
          document.getElementById('full-title')?.focus({ preventScroll: true });
        }));
      }
    }

    openBtn.addEventListener('click', () => {
      form.hidden = false;
      if (!hash && dev) msg.textContent = 'No password set yet (npm run case-password). On the dev server any entry opens it.';
      input.focus();
    });

    const sha256 = async (text: string) => {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const value = input.value;
      const ok = hash ? (await sha256(value)) === hash : dev && value.length > 0;
      if (ok) {
        input.value = '';
        msg.textContent = '';
        try {
          sessionStorage.setItem(KEY, '1');
          sessionStorage.setItem(JUMP, '1');
          location.reload();
        } catch {
          reveal(true);
        }
      } else {
        msg.textContent = 'That password doesn’t match.';
        input.select();
      }
    });
  }
</script>

<style>
  .ct {
    position: relative;
    z-index: 1;
    width: min(calc(100% - var(--margin-side) * 2), var(--container-max));
    margin: 0 auto;
    /* a whole section gap before "More cases", as between every section */
    padding-bottom: var(--section-y);
    /* ONE RUNG MORE AIR, every step of the ladder (Uttham, 2026-10-02: "the
       texts are closely placed making it too textual please use ample spacings
       and consistent spacings"). The order of the steps is unchanged, so the
       grouping still reads; only the reading pages breathe more.
       the sub-group step: 48–64, two rungs over the heading's 32 */
    --ct-sub: max(var(--space-7), calc(var(--group-gap) * 4 / 3));
    /* heading → its text, one rung over --head-gap */
    --ct-head: var(--space-6);
    /* paragraph → paragraph, sub-group heading → its rows */
    --ct-para: var(--space-5);
  }

  /* ---- hero: the case page's own entrance, the reference's content ---- */
  .ct-hero > * {
    transition: opacity var(--dur-3) var(--ease-enter), transform var(--dur-3) var(--ease-enter);
  }
  .ct-hero > :nth-child(2) { transition-delay: var(--stagger-1); }
  .ct-hero > :nth-child(3) { transition-delay: calc(var(--stagger-1) * 2); }
  .ct-hero > :nth-child(4) { transition-delay: calc(var(--stagger-1) * 3); }
  .ct-hero > :nth-child(5) { transition-delay: calc(var(--stagger-1) * 4); }
  @starting-style {
    .ct-hero > * { opacity: 0; transform: translateY(12px); }
  }
  .back-link { margin-bottom: var(--group-gap); }
  h1 {
    max-width: 19ch;
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 600;
    letter-spacing: var(--track-display);
    line-height: var(--lh-display);
    text-wrap: balance;
  }
  .ct-dek {
    max-width: 600px;
    margin: var(--content-gap) 0 0;
    color: var(--ink-600);
    font-size: var(--text-body-lg);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }
  /* the one figure on the page, linked to where Meesho states it */
  .ct-dek :global(.ct-source) {
    color: var(--ink-900);
    text-decoration: underline;
    text-decoration-color: var(--amber-700);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .ct-dek :global(.ct-source:focus-visible) { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  /* Facts: label and value on one line each, the rules dashed like the
     measure — never solid (the site draws no solid rules on paper). */
  .ct-facts {
    max-width: 600px;
    margin: var(--group-gap) 0 0;
    padding: var(--space-5) 0;
    display: grid;
    gap: var(--space-2);
    border-block: 1px dashed var(--line-mark);
  }
  .ct-facts__row { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: var(--space-5); align-items: baseline; }
  .ct-facts dt {
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .ct-facts dd { margin: 0; color: var(--ink-900); font-size: var(--text-body); line-height: var(--lh-body); }
  .ct-facts dd :global(.em) { font-weight: 600; } /* a long fact (Value added) carries its highlight too */
  /* a live thing the reader can open themselves: under the facts on phones,
     on the card under the phone from 768px */
  .ct-visit { margin-top: var(--group-gap); }
  .ct-pane__visit { display: none; }

  /* ---- the reading column and the phone beside it ---- */
  /* THE SPACING LADDER, the homepage's own (CLAUDE.md), stepped up for reading
     — Uttham, 2026-10-01: "as the reference website shared, make sure there is
     lot of spacing… it should match that system". The reference pads each
     chapter 80px top and bottom (160 apart), heading 18px over its text, intro
     32–48px over what follows. The stack, largest first — each a clear step
     under the one above at every width, so a heading always sits nearer its
     own text than the section before it (law of proximity):
       between sections, hero → story, story → More cases   --section-y (96–160)
       text → a sub-group (rows, note, list, gate), and
       above a sub-group's heading              --ct-sub (48–64)
       heading → its text                       --ct-head (32)
       sub-group heading → its rows; paragraph → paragraph   --ct-para (24)
       row label → its line; inside a card                   --space-3 / --space-4
     Insets, apart from the stack: below the header --section-pad, row padding
     --space-6, the gate card --card-padding. One rung up on 2026-10-02. */
  .ct-layout { margin-top: var(--section-y); }
  .ct-story { display: grid; gap: var(--section-y); min-width: 0; }
  .ct-section, .ct-full { min-width: 0; }
  h2 {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--track-heading);
    line-height: var(--lh-heading);
    text-wrap: balance;
  }
  h3 {
    margin: var(--ct-sub) 0 0;
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: var(--track-heading);
    line-height: var(--lh-heading);
  }
  .ct-body {
    max-width: 62ch;
    margin: var(--ct-para) 0 0;
    color: var(--ink-600);
    font-size: var(--text-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }
  .ct-body :global(.em) { color: var(--ink-900); font-weight: 600; }
  .ct-body :global(.em--lg) { font-size: 1.28em; line-height: 1.25; }

  /* Ruled rows, the case index's dashed recipe: the label on its own line, the
     line under it. The row being read takes an amber tick in the gutter —
     colour only, nothing moves. */
  h2 + .ct-body { margin-top: var(--ct-head); }
  .ct-steps { margin: var(--ct-sub) 0 0; padding: 0; list-style: none; }
  h3 + .ct-steps { margin-top: var(--ct-para); }
  /* a sub-group's lead line belongs to its rows: heading → lead → rows all
     at the within-group step, so the group reads as one block */
  .ct-sublead + .ct-steps { margin-top: var(--ct-para); }
  .ct-step {
    position: relative;
    padding: var(--space-6) 0;
    border-top: 1px dashed var(--line-mark);
    color: var(--ink-600);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }
  .ct-step:last-child { border-bottom: 1px dashed var(--line-mark); }
  .ct-step b { display: block; margin-bottom: var(--space-3); color: var(--ink-900); font-weight: 600; }
  .ct-step::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: var(--space-5);
    bottom: var(--space-5);
    width: 2px;
    background: transparent;
    transition: background-color var(--dur-2) var(--ease-standard);
  }
  .ct-step.is-current::before { background: var(--amber-700); }
  /* the highlight in a row, or in a step's line under its label, is the bold */
  .ct-step :global(.em) { color: var(--ink-900); font-weight: 600; }
  /* rows or the prompt straight under a section's h2 take the heading's own
     gap, as a first paragraph does; after text they are a sub-group */
  .ct-section > h2 + .ct-rows,
  .ct-section > h2 + .ct-prompt { margin-top: var(--ct-head); }

  /* the verbatim, once consent is confirmed: the case page's sticky note */
  .ct-note {
    max-width: 34ch;
    margin: var(--ct-sub) 0 0 var(--space-4);
    padding: var(--space-5) var(--space-5) var(--space-4);
    background: var(--amber-400);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-stuck);
    rotate: -2deg;
    font-family: var(--font-hand);
    color: var(--ink-900);
  }
  .ct-note p { margin: 0; font-size: var(--text-note); font-weight: 500; line-height: var(--lh-heading); }
  .ct-note small { display: block; margin-top: var(--space-3); font-family: var(--font-paper); font-size: var(--text-small); color: var(--ink-900); }
  /* a paragraph after a tilted note clears its corner by a group step */
  .ct-note + .ct-body { margin-top: var(--ct-sub); }

  /* live mode: a running tool fills the stage; the tool sizes its own frame */
  .ct-live { position: relative; width: 100%; height: 100%; }
  /* …unless it stands in the teaser's own phone (frame="phone"): then the
     phone is the frame, sized like the screens, and the tool fills it */
  .ct-live--framed { position: absolute; inset: 0; width: auto; height: auto; }

  /* ---- the prompt: a paper card with the page's one primary sticker ---- */
  /* a paper card, not glass — glass is for something kept between (Uttham,
     2026-10-01); the prompt sits in the sheet's recessed well (--paper-2).
     The well opens on the prompt's first ten lines and fades out, with "Show
     the full prompt" under it (Uttham, 2026-10-02: "let their be a way to
     expand the prmopt … the compressed one I am not liking" — this replaces the
     six-line preview of the same day). The whole prompt is always in the <pre>,
     so the button copies all of it and a screen reader reads all of it. The
     script collapses it, so without the script it is simply open. */
  .ct-prompt {
    position: relative;
    margin-top: var(--group-gap);
    padding: var(--card-padding);
    display: grid;
    gap: var(--space-4);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
  }
  .ct-prompt__head { display: flex; align-items: center; }
  .ct-prompt__text {
    margin: 0;
    padding: var(--card-padding);
    background: var(--paper-2);
    border-radius: var(--radius-inset);
    color: var(--ink-900);
    /* the site's two families only — no monospace (locked 2026-09-07) */
    font-family: var(--font-paper);
    font-size: var(--text-small);
    line-height: var(--lh-body);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
    --pv-line: calc(var(--text-small) * var(--lh-body));
    position: relative;
  }
  /* collapsed: ten lines inside the well's padding, then the text fades into
     the well over the last two — the well itself stays solid */
  .ct-prompt[data-collapsed] .ct-prompt__text {
    max-height: calc(2 * var(--card-padding) + 10 * var(--pv-line));
    overflow: hidden;
  }
  .ct-prompt[data-collapsed] .ct-prompt__text::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: calc(var(--card-padding) + 2 * var(--pv-line));
    background: linear-gradient(to bottom, transparent, var(--paper-2) calc(100% - var(--card-padding)));
    pointer-events: none;
  }
  /* the toggle is a text link, like "Read the case study", under the well */
  .ct-prompt__more {
    justify-self: start;
    padding: 0;
    background: none;
    border: 0;
    cursor: pointer;
  }
  .ct-prompt__more[hidden] { display: none; }
  .ct-prompt__more:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 4px; }

  .ct-inside-lead { margin-top: var(--ct-sub); }
  .ct-inside {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0 0 0 var(--space-4);
    list-style: '— ';
    color: var(--ink-600);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  /* ---- the gate: a paper card (the tiles' white stock, not glass — Uttham,
     2026-10-01: "no need of glass for this, just use the card structure")
     holding the one primary sticker ---- */
  .ct-gate {
    position: relative;
    max-width: 560px;
    margin-top: var(--ct-sub);
    padding: var(--card-padding);
    display: grid;
    justify-items: start;
    /* the homepage tile's within-a-card step: never wider than the inset */
    gap: var(--space-4);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
  }
  .ct-gate__text { margin: 0; color: var(--ink-600); font-size: var(--text-body); line-height: var(--lh-body); }
  /* the list of what is inside: the lead in ink, the items a within-card step under it */
  .ct-gate__lead { margin: 0; color: var(--ink-900); font-size: var(--text-body); font-weight: 500; line-height: var(--lh-body); }
  .ct-gate__inside .ct-inside { margin-top: var(--space-2); }
  .ct-gate__form { display: grid; gap: var(--space-2); width: 100%; }
  /* the global sticker sets display, which beats the hidden attribute */
  .ct-gate [hidden] { display: none; }
  .ct-gate__label {
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .ct-gate__row { display: flex; flex-wrap: wrap; gap: var(--control-gap); align-items: center; }
  /* a control, so the controls' square corner (--radius-control) */
  .ct-gate__input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: var(--space-7);
    padding: 0 var(--space-4);
    /* ink-400 is ~3.5:1 on white: a control's edge must reach 3:1 (WCAG 1.4.11);
       the ruler's --line-mark is 1.9:1 and left the field invisible on paper */
    border: 1px solid var(--ink-400);
    border-radius: var(--radius-control);
    background: var(--paper-1);
    color: var(--ink-900);
    font: inherit;
    font-size: var(--text-body);
  }
  .ct-gate__input:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  .ct-gate__msg { min-height: calc(var(--text-small) * var(--lh-body)); margin: 0; color: var(--ink-900); font-size: var(--text-small); }

  /* ---- the full case study: one block per experiment, on paper ---- */
  .ct-full { display: grid; gap: var(--section-y); scroll-margin-top: calc(var(--header-height) + var(--content-gap)); }
  .ct-full[hidden] { display: none; }
  .ct-gate[hidden], .ct-inside-block[hidden] { display: none; }
  /* the separator: the homepage ruler's dashed hairline and tracked label,
     drawn across the reading column; the first block starts one heading gap
     under it rather than a whole section gap */
  .ct-full__rule {
    position: relative;
    height: 0;
    margin-bottom: calc(var(--head-gap) + var(--space-7) - var(--section-y));
    border-top: 1px dashed var(--line-mark);
  }
  .ct-full__rule span {
    position: absolute;
    top: 0;
    left: calc(var(--space-2) * -1);
    translate: 0 -50%;
    padding: 0 var(--space-2);
    background: var(--paper-0);
    color: var(--ink-900);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
  }
  .ct-exp { display: grid; gap: var(--space-7); }
  .ct-exp__head { display: grid; justify-items: start; gap: var(--space-3); }
  .ct-exp__head h3 { margin: 0; font-size: var(--text-h3); }
  /* status as the case index's pill — the one place a pill belongs */
  .ct-exp__status {
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-pill);
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .ct-exp__part { display: grid; gap: var(--space-3); }
  .ct-exp__part .ct-body { margin: 0; }
  .ct-exp__label {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  /* ---- the phone, on a paper card (Uttham, 2026-10-01: "no need to use the
     glass, use the card component, glass is only used when you want to keep
     something between"). ---- */
  .ct-pane {
    position: relative;
    height: 100%;
    padding: var(--card-padding);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
  }

  /* THE HANDSET'S PROPORTIONS (CaseDevice), as shares of its display's width,
     W: an even bezel of 0.03 W, a 0.12 W status bar over the 1 : 2 screen, a
     0.10 W home strip under it, the display's corner 0.10 W. Whatever holds a
     device (the card, the mini player, the dialog) sets W — --ct-device-screen
     — once for its viewport, from the room it has: the body is k-wide × W
     across and k-tall × W high, so a scale drawing at every size. */
  .ct {
    --ct-device-k-bezel: 0.03;
    --ct-device-k-status: 0.12;
    --ct-device-k-home: 0.1;
    --ct-device-k-radius: 0.1;
    --ct-device-k-wide: calc(1 + 2 * var(--ct-device-k-bezel));
    --ct-device-k-tall: calc(2 + var(--ct-device-k-status) + var(--ct-device-k-home) + 2 * var(--ct-device-k-bezel));
    /* the tallest the card may be, and so the widest its display gets: what
       is left of 720px under the card's widest inset, edge and title (~272px).
       Nothing outside the card draws the phone wider than this (the enlarged
       dialog; Uttham, 2026-10-03: "you can increase the phone size but not
       the width") */
    --ct-pane-max: 720px;
    --ct-device-screen-max: calc((var(--ct-pane-max) - 2 * var(--space-6) - 2px - var(--text-small) * var(--lh-statement) - var(--space-3)) / var(--ct-device-k-tall));
  }
  /* the device's footprint, for the card around it and the boards that stand
     in its place */
  .ct-panel--device {
    --ct-device-w: calc(var(--ct-device-screen) * var(--ct-device-k-wide));
    --ct-device-h: calc(var(--ct-device-screen) * var(--ct-device-k-tall));
  }

  /* THE LIVE PHONE (the AI Space pages): a running tool in a handset's
     9 : 19.5, sized off the stage's height AND width so it always stands
     whole, never cut and never stretched. The case pages' device leaves it as
     it was: an iframe moved or rescaled would reload or blur, and Resona keeps
     its own dark chrome (from 768px the card hugs it; see --ct-phone-w). */
  .ct-panel--live { --ct-ratio: calc(19.5 / 9); --ct-edge: 0px; }
  .ct-stage { height: 100%; container-type: size; display: grid; place-items: center; }
  .ct-phone--live {
    position: relative;
    width: min(100cqw, calc(100cqh / var(--ct-ratio)));
    aspect-ratio: 1 / var(--ct-ratio);
    overflow: hidden;
    border: 1px solid var(--line-1);
    border-radius: var(--radius-media);
    background: var(--paper-1);
    box-shadow: var(--shadow-rest);
  }

  /* ---- the case pages' screens, in the device's 1 : 2 display ---- */
  /* the stage is the device's footprint: the device, or a board in its place */
  .ct-panel--device .ct-stage {
    position: relative;
    display: block;
    width: var(--ct-device-w);
    height: var(--ct-device-h);
    margin-inline: auto;
    container-type: normal;
  }
  /* the display's middle row: the screen, exactly 1 : 2 at every state */
  .ct-panel--device .ct-phone {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: var(--paper-1);
  }
  /* A screen fits the display whole, never cropped and never stretched: a
     1 : 2 screen meets all four edges, a shorter one stands centred at the
     display's width on its own edge colours (--ct-fill-*, read from the
     export at build time), so the order confirmation is one purple screen,
     not a screen with bars. Screens cross-fade and never scale: a zoom-settle
     would crop a screen's edges in the display (or push a board past the
     device's footprint) for the length of the fade. */
  .ct-screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-exit);
  }
  .ct-screen[data-fit='fit'] { background: linear-gradient(var(--ct-fill-top) 50%, var(--ct-fill-foot) 50%); }
  /* a shorter screen stands against its patterned edge, the fill on its flat
     one (anchorFor in the frontmatter); centred when both edges match */
  .ct-screen[data-anchor='top'],
  .ct-screen[data-anchor='top'] :is(.ct-screen__still, .ct-screen__clip) { object-position: center top; }
  .ct-screen[data-anchor='bottom'],
  .ct-screen[data-anchor='bottom'] :is(.ct-screen__still, .ct-screen__clip) { object-position: center bottom; }
  .ct-screen.is-on {
    opacity: 1;
    pointer-events: auto;
    transition: opacity var(--dur-4) var(--ease-enter);
  }
  /* a page taller than the display: the whole page at the display's width,
     in a window the script pans it through (down, a hold, back) */
  .ct-screen--pan, .ct-screen--clip { overflow: hidden; }
  .ct-screen__scroll { height: 100%; overflow: hidden; }
  .ct-screen__page { display: block; width: 100%; height: auto; }
  /* a clip over its still: shown once cued (its first frame is up, and the
     screen arrives only then), faded back to the still once it has played.
     While the clip shows, the still under it is hidden outright, so not even
     a frame the clip is late to paint can show its ending through it. Both
     fit like any screen: a 1 : 2 clip (the splash) fills the display, the
     9 : 16 confirmation stands on its purple. */
  .ct-screen__still, .ct-screen__clip {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }
  .ct-screen__clip { opacity: 0; }
  .ct-screen--clip.is-cued .ct-screen__clip { opacity: 1; }
  .ct-screen--clip.is-cued:not(.is-ended) .ct-screen__still { visibility: hidden; }
  .ct-screen--clip.is-ended .ct-screen__clip { opacity: 0; transition: opacity var(--dur-3) var(--ease-standard); }
  /* AN EMPTY PHONE (a state whose screen is still to come, and no earlier one
     to borrow): its display shows one quiet line in the middle, like an app's
     own empty state — "Screen coming soon" in the build, the state's name on
     the dev server. It is never written over a screen (Uttham, 2026-10-03:
     "some places I have seen some placeholder text coming on top of images"):
     the script writes it only while the phone has nothing to show, and it
     fades in only once the last screen has faded out (--dur-2, the screen's
     exit), so not even the outgoing frame sits under it. */
  .ct-phone__dev {
    position: absolute;
    inset: 0;
    display: grid;
    place-content: center;
    margin: 0;
    /* the same line in the 112px mini player, at its scale (it had been
       hidden there, leaving a blank white handset; 2026-10-03, review) */
    padding: min(var(--space-4), calc(var(--ct-device-screen, 200px) * 0.08));
    color: var(--ink-600);
    font-size: min(var(--text-eyebrow), calc(var(--ct-device-screen, 200px) * 0.085));
    font-weight: 500;
    letter-spacing: var(--track-label);
    line-height: var(--lh-heading);
    text-transform: uppercase;
    text-align: center;
    text-wrap: balance;
    opacity: 0;
    pointer-events: none;
  }
  .ct-phone__dev:not(:empty) { opacity: 1; transition: opacity var(--dur-3) var(--ease-enter) var(--dur-2); }

  /* the device steps aside while a board stands in its place, and back —
     coming back only once the board and its "Click to enlarge" chip have
     faded (--dur-2, their exit), so the chip never stands over the incoming
     screen, as the empty phone's line waits for the last screen */
  .ct-panel--device :global(.ct-device) {
    transition: opacity var(--dur-4) var(--ease-enter) var(--dur-2), visibility 0s linear var(--dur-2);
  }
  .ct-panel.is-board :global(.ct-device) {
    opacity: 0;
    visibility: hidden;
    transition: opacity var(--dur-2) var(--ease-exit), visibility 0s linear var(--dur-2);
  }

  /* REFERENCE BOARDS stand in the device's footprint, whole, on the card's
     paper: as wide as the device, or as tall as it allows with the chip under
     it, whichever binds — so the card never changes size for one, and a board
     is never wider or taller than the handset it replaces. A board starts
     where the device's top edge stands, one --space-3 under the title, with
     its chip under it and the spare paper below (centred in the footprint, a
     wide board floated 117–235px from the title that names it; 2026-10-03,
     review of the handset). The chip says it opens full size; nothing sits on
     the board. */
  .ct-boards {
    /* the room a board has: the footprint less its inset (none on the card,
       where the card's own padding is the margin), the chip and the gap */
    --ct-board-inset: 0px;
    --ct-board-gap: var(--space-3);
    --ct-board-hint-h: var(--space-5);
    position: absolute;
    inset: 0;
    pointer-events: none;
  }
  .ct-board {
    inset: var(--ct-board-inset);
    width: auto;
    height: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    gap: var(--ct-board-gap);
    visibility: hidden;
    transition: opacity var(--dur-2) var(--ease-exit), visibility 0s linear var(--dur-2);
  }
  /* a board arrives once whatever it replaces has gone (--dur-2): the
     device's screen, or another board and its chip */
  .ct-board.is-on {
    visibility: visible;
    transition: opacity var(--dur-4) var(--ease-enter) var(--dur-2), visibility 0s linear var(--dur-2);
  }
  .ct-board__img {
    display: block;
    flex: none;
    width: min(100%, calc((var(--ct-device-h) - 2 * var(--ct-board-inset) - var(--ct-board-hint-h) - var(--ct-board-gap)) / var(--ct-board-r)));
    height: auto;
    border-radius: var(--radius-sm);
    /* the image's edge: 1px of pure black at low opacity, just inside */
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
  }
  /* "Click to enlarge" (or "Tap", on a touch screen): a paper chip, the
     "Scroll ↓" chip's twin, under the board */
  .ct-board__hint {
    display: inline-flex;
    align-items: center;
    gap: var(--space-1);
    height: var(--ct-board-hint-h);
    padding: 0 var(--space-3);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-pill);
    box-shadow: var(--shadow-rest);
    color: var(--ink-900);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    transition: border-color var(--dur-1) var(--ease-standard);
  }
  .ct-board__hint svg { flex: none; width: 1.2em; height: 1.2em; }
  .ct-board__coarse { display: none; }
  @media (pointer: coarse) {
    .ct-board__fine { display: none; }
    .ct-board__coarse { display: inline; }
  }
  /* the board takes the pointer through the button laid over its footprint:
     its chip's edge darkens, nothing moves */
  .ct-stage:has(.ct-pip__enlarge:is(:hover, :focus-visible)) .ct-board.is-on .ct-board__hint { border-color: var(--ink-400); }

  /* THE NOTES (Uttham, 2026-10-03: "the framework card should come inside the
     image, and the wordings outside as you did on home page"): the homepage
     tiles' handwriting — Caveat in ink, a few words, the same hand-drawn arrow
     — on the card's paper LEFT of the device, each arrow's tip on the part of
     the screen it names (`y`, a share of the screen's height). Left, because
     every screen they annotate sets its content against its left edge (a
     card's chips, price, rating and delivery line; a list row's picture), and
     because that side faces the reading, so the eye goes text, note, screen.
     A note is one line where it can be: the words stand on the arrow's tail,
     so a note is about a line and a half tall and the framework's four rows,
     a little over that apart, never collide; a longer note wraps upwards.
     The type and the arrow scale with the display (--ct-device-screen), so a
     note keeps its place against the screen at every size. Never over the
     screen, never between the device and the title.
     THE COLUMN is constant: a page with notes gives its card --ct-notes-w at
     every state, empty while a screen has none, so no state changes the
     card's size. It is 0.46 of the display's width — the room the
     framework's longest one-line note ("Fast programme") takes beside its
     arrow — and only where the card's columns hold it beside a device of its
     full size; anywhere narrower (a small laptop, a tablet) the column is 0
     and the notes are off, rather than the phone shrinking for them (as the
     homepage's narrow wells drop theirs). round(down, room, column) is the
     column once the room holds it, and 0 before; a browser without round()
     keeps 0. */
  .ct-panel--notes { --ct-notes-w: 0px; }
  @supports (width: round(down, 10px, 3px)) {
    @media (min-width: 768px) {
      .ct-panel--notes {
        --ct-notes-col: calc(var(--ct-device-screen) * 0.46);
        --ct-notes-room: calc(100cqw - var(--ct-device-w) - 2 * var(--card-padding) - var(--ct-card-edge));
        --ct-notes-w: min(var(--ct-notes-col), max(0px, round(down, var(--ct-notes-room), var(--ct-notes-col))));
      }
    }
  }
  /* the notes' box: the display's height, from the card's paper (a --space-3
     in from its edge) to the display's left edge, over which the arrows land */
  .ct-annots {
    position: absolute;
    top: calc(var(--ct-device-screen) * (var(--ct-device-k-bezel) + var(--ct-device-k-status)));
    right: calc(100% - var(--ct-device-screen) * var(--ct-device-k-bezel));
    width: calc(var(--ct-notes-w, 0px) + var(--card-padding) + var(--ct-device-screen) * var(--ct-device-k-bezel) - var(--space-3));
    height: calc(var(--ct-device-screen) * 2);
    /* a container, so a column too narrow to hold the notes hides them; its
       own lengths still resolve against the panel, and the notes inside it
       use only em and % (their type is set here, where the display's width
       can be read) */
    container: ct-annots / inline-size;
    color: var(--ink-900);
    font-family: var(--font-hand);
    font-size: clamp(15px, calc(var(--ct-device-screen) * 0.072), 22px);
    font-weight: 600;
    line-height: 1.15;
    pointer-events: none;
  }
  /* a screen's notes fade with it, on the screens' own timing */
  .ct-annots__set {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity var(--dur-2) var(--ease-exit);
  }
  .ct-annots__set.is-on { opacity: 1; transition: opacity var(--dur-4) var(--ease-enter); }
  .ct-annot {
    /* the arrow is 2em × 1em; its tip sits 0.16em in from its right end and
       0.07em up from its foot (the tiles' drawing, mirrored) */
    --tip-x: 0.16em;
    --tip-y: 0.07em;
    position: absolute;
    right: calc(-1 * var(--tip-x) - 1px);
    bottom: calc((1 - var(--y)) * 100% - var(--tip-y));
    max-width: calc(100% + var(--tip-x));
    display: flex;
    align-items: flex-end;
  }
  /* the words stand on the arrow's tail (0.11em under its top), a hair clear
     of it, so a note's words never touch the arrow of the note above */
  .ct-annot__text {
    min-width: 0;
    margin: 0 0.15em 0.4em 0;
    text-align: right;
    text-wrap: balance;
    rotate: -2deg;
  }
  .ct-annot__arrow {
    flex: none;
    display: block;
    width: 2em;
    height: 1em;
    scale: -1 1;
    overflow: visible;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .ct-annot__halo { stroke: var(--paper-1); stroke-width: 4.4; }
  /* no column (it did not fit): no notes */
  @container ct-annots (width < 96px) {
    .ct-annot { display: none; }
  }

  /* "Scroll ↓": a paper chip in the device's home strip, for a page that
     scrolls by hand (the card's page with reduced motion, the enlarged view),
     until the page's foot is in view — beside the screenshot, never on it.
     It stands over the home indicator (which, at 0.9 opacity, is a layer of
     its own and would otherwise paint over the chip). */
  .ct-hint {
    position: relative;
    z-index: 1;
    display: none;
    align-items: center;
    gap: var(--space-1);
    height: min(var(--space-5), calc(var(--ct-device-screen) * var(--ct-device-k-home) - var(--space-1)));
    padding: 0 var(--space-2);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-pill);
    color: var(--ink-900);
    font-size: min(var(--text-eyebrow), calc(var(--ct-device-screen) * var(--ct-device-k-home) * 0.5));
    font-weight: 500;
    letter-spacing: var(--track-label);
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    transition: opacity var(--dur-2) var(--ease-standard);
  }

  /* ---- scroll points: a rail of ticks in the right gutter, titles as
     tooltips ---- */
  .ct-section, .ct-exp, .ct-section h3[id] { scroll-margin-top: calc(var(--header-height) + var(--content-gap)); }
  /* the rail's top point lands on the page's own top */
  .ct-hero[id] { scroll-margin-top: calc(var(--header-height) + var(--section-pad)); }
  .ct-points { display: none; }
  @media (min-width: 768px) {
    .ct-points {
      /* the rail's inner padding; halved on the 8-column grid, where the
         gutter is 40px, so the rail's ticks never reach the phone pane */
      --pt-pad: var(--space-4);
      /* room inside the rail, left of the ticks, for the widest tooltip: on a
         short screen the list scrolls, and a scroller clips what overflows it */
      --pt-tip: 320px;
      display: block;
      position: fixed;
      top: 50%;
      /* centred in the gutter beside the container, clear of the phone pane */
      /* the list's own 16px padding sits inside this, so the ticks end up
         centred in the gutter */
      right: max(0px, calc((var(--margin-side) - var(--space-5)) / 2 - var(--pt-pad)));
      translate: 0 -50%;
      z-index: var(--z-float);
      /* the rail's box is mostly that tooltip room: only the ticks take the
         pointer, so the page and the phone under it stay in reach */
      pointer-events: none;
    }
    .ct-points__list {
      display: grid;
      justify-items: end;
      /* clear of the header, and as far clear of the bottom, as it is centred */
      max-height: calc(100svh - 2 * var(--header-height));
      margin: 0;
      padding: var(--space-3) var(--pt-pad) var(--space-3) var(--pt-tip);
      list-style: none;
      overflow-y: auto;
      scrollbar-width: none;
    }
    .ct-points__list::-webkit-scrollbar { display: none; }
    .ct-points__full[hidden] { display: none; }
    /* a hit area wider and taller than the tick, the rows touching so the
       pointer never falls between two ticks: 32 × 28px per point */
    .ct-points__link {
      /* the tick's length: a sub-group's shorter, so it reads as under its
         section's; the one being read longer */
      --pt-tick: var(--space-3);
      position: relative;
      display: flex;
      align-items: center;
      justify-content: flex-end;
      width: var(--space-6);
      min-height: calc(var(--space-5) + var(--space-1));
      text-decoration: none;
      pointer-events: auto;
    }
    .ct-points__item--sub .ct-points__link { --pt-tick: var(--space-2); }
    .ct-points__tick {
      flex: none;
      width: var(--pt-tick);
      height: 2px;
      background: var(--line-mark);
      transition: background-color var(--dur-2) var(--ease-standard);
    }
    /* the section being read: a longer, darker tick (state, not hover) */
    .ct-points__link[aria-current='location'] { --pt-tick: var(--space-5); }
    .ct-points__link[aria-current='location'] .ct-points__tick { background: var(--ink-900); }
    /* the title: a small paper tooltip left of its tick, centred on it. It
       fades in place and never moves; reduced motion drops the fade with
       every other transition (global.css). Hidden, it takes no pointer.
       IT NEVER COVERS THE CARD (2026-10-03: the current tick's tooltip lay
       ~49px over the phone at 1280×720): the script measures the gutter
       between the card's right edge and the rail, less a --space-2 of air
       (--pt-room), and the tooltip is never wider than what that leaves left
       of its tick; a title a --space-1 too long borrows that much of the air
       (--pt-give), a longer one ends in an ellipsis (Uttham, 2026-10-03:
       "please truncate these"), and where the gutter cannot hold a readable
       word (data-tip-off: under --space-8 for a title that would be cut) the
       tooltip stays off — the tick, its length and its accessible name still
       say where the reader is, and the link's own title names it on hover. */
    .ct-points__label {
      position: absolute;
      top: 50%;
      right: calc(var(--pt-tick) + var(--space-2));
      translate: 0 -50%;
      max-width: min(var(--pt-tip), calc(var(--pt-room, var(--pt-tip)) - var(--pt-tick) - var(--space-2) + var(--pt-give, 0px)));
      overflow: hidden;
      padding: var(--space-1) var(--space-2);
      background: var(--paper-1);
      border: 1px solid var(--line-1);
      border-radius: var(--radius-inset);
      box-shadow: var(--shadow-rest);
      color: var(--ink-900);
      font-size: var(--text-eyebrow);
      font-weight: 500;
      line-height: var(--lh-heading);
      text-overflow: ellipsis;
      white-space: nowrap;
      pointer-events: none;
      opacity: 0;
      visibility: hidden;
      transition: opacity var(--dur-2) var(--ease-standard), visibility var(--dur-2) var(--ease-standard);
    }
    /* one tooltip at a time: the current tick's, unless another tick has the
       keyboard (or, below, the pointer) — then only that one's */
    .ct-points__link:is([aria-current='location'], :focus-visible) .ct-points__label { opacity: 1; visibility: visible; }
    .ct-points__list:has(:focus-visible) .ct-points__link:not(:focus-visible) .ct-points__label { opacity: 0; visibility: hidden; }
    @media (hover: hover) and (pointer: fine) {
      .ct-points__link:hover .ct-points__tick { background: var(--ink-600); }
      .ct-points__link[aria-current='location']:hover .ct-points__tick { background: var(--ink-900); }
      .ct-points__list:hover .ct-points__link:not(:hover) .ct-points__label { opacity: 0; visibility: hidden; }
      .ct-points__list:hover .ct-points__link:hover .ct-points__label { opacity: 1; visibility: visible; }
    }
    .ct-points__link[data-tip-off] .ct-points__label { display: none; }
    .ct-points__link:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  }
  @media (min-width: 768px) and (max-width: 900px) {
    .ct-points { --pt-pad: var(--space-2); }
  }

  /* THE CARD'S TITLE: what the phone is showing, one line in a slot of its
     own height, so a long title never pushes the device down — it ends in an
     ellipsis and keeps its whole text as the element's title. Small, medium
     weight and in ink, so it names the screen without competing with the
     dark handset under it; CENTRED, because the device is symmetrical and
     its top corners are deeply rounded — a title set to its left edge would
     hang past the curve and read as off-centre. One within-card step
     (--space-3) to the device. */
  .ct-pane__title {
    height: calc(var(--text-small) * var(--lh-statement));
    margin: 0 0 var(--space-3);
    color: var(--ink-900);
    font-size: var(--text-small);
    font-weight: 500;
    line-height: var(--lh-statement);
    text-align: center;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* the mini-player controls exist only on phones */
  .ct-pip__enlarge, .ct-pip__close, .ct-pip__restore, .ct-pip__scrim { display: none; }
  /* the button that opens a screen full size covers what it opens */
  .ct-pip__enlarge {
    position: absolute;
    inset: 0;
    z-index: 2;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .ct-pip__enlarge:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }

  /* Laptops and tablets: the phone stands beside the text, sticky under the
     header. On the site's 12-column grid the story takes 7 columns and the
     phone 5; on the 8-column tablet grid (≤900px) 5 and 3, which still leaves
     a ~190px phone at 768px — bigger than any strip on top could. */
  @media (min-width: 768px) {
    .ct-layout {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
    }
    .ct-story { grid-column: 1 / 8; }
    .ct-panel {
      grid-column: 8 / -1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--content-gap));
      /* THE CARD HUGS THE PHONE (Uttham, 2026-10-02: "the prototype pane on
         right has too much padding on left right of the mobile preview, we
         should optimise this space"). The phone is as tall as the screen
         allows; the card is the phone plus one card inset all round, centred
         in its columns, so the spare width falls between text and card instead
         of inside it. --ct-pane-h is the tallest the card may be. */
      --ct-pane-h: min(calc(100svh - var(--header-height) - 2 * var(--content-gap)), var(--ct-pane-max));
      /* THE CARD SITS CENTRED in the screen under the header (Uttham,
         2026-10-02: "the phone preview on l2 pages is not center aligned, there
         is less spacing on top than bottom when the header disappears"). The
         sticky box is the whole visible height below the header — dvh, so it
         follows a tablet browser's address bar as it slides away — and the card
         is centred in it. The phone's own size stays on svh, so it never jumps
         while the bar moves; only the spare height around it is shared out. */
      height: calc(100svh - var(--header-height) - 2 * var(--content-gap));
      height: calc(100dvh - var(--header-height) - 2 * var(--content-gap));
      display: grid;
      align-content: center;
      --ct-title-h: 0px;
      --ct-foot-h: 0px;
      /* Both budgets take off the card's own 1px border each side
         (--ct-card-edge): left in, the card stood 2px taller than the sticky
         box at 1280×720, 1px over each end. */
      --ct-card-edge: 2px;
      container-type: inline-size;
    }
    /* the live phone stands as tall as the card allows and takes the width
       its proportion gives it — unless the column is narrower (a tablet),
       when it takes the column and its height follows */
    .ct-panel--live {
      --ct-phone-w: min(
        calc(100cqw - 2 * var(--card-padding) - var(--ct-card-edge)),
        calc((var(--ct-pane-h) - 2 * var(--card-padding) - var(--ct-card-edge) - var(--ct-title-h) - var(--ct-foot-h) - var(--ct-edge)) / var(--ct-ratio) + var(--ct-edge))
      );
    }
    /* THE DEVICE IS ONE SIZE PER VIEWPORT (Uttham, 2026-10-03: "all the aspect
       ratio should be fixed for this card … everything should have constant
       height and width"). Its display's width is whichever binds first: the
       column, or the card's tallest height less its insets, edge and title,
