---
// A teaser page as Uttham laid it out (2026-10-01): a two-minute read on the
// left, a sticky preview on the right that follows the reading, and — where a
// study has one — the full case study expanding in place behind a light
// password gate. Built from the site's own pieces: paper for the words, glass
// for the screens, the sticker CTA. Content comes in as CaseTeaserData
// (src/data/case-teaser.ts); the product-cards and Meesho Mall case studies and
// the AI Space tool pages all render through here.
//
// Two kinds of preview. Screens: Uttham's Figma exports, picked per state from
// src/assets/<screens.dir>/ (a state with no screen shows the nearest earlier
// one; the dev server names the missing one). Live: a `preview` slot — a
// running tool — which hears each state as a `case:state` event. With
// `frame="phone"` the slot stands in the teaser's own phone (the screens' 9/19.5
// frame, the mini player's tap-to-enlarge) and the tool just fills it; without
// it the tool sizes its own frame.
import { Image } from 'astro:assets';
import { rich } from '../lib/rich';
import { CASE_PASSWORD_SHA256 } from '../data/case-gate';
import type { CaseTeaserData } from '../data/case-teaser';

interface Props {
  data: CaseTeaserData;
  frame?: 'phone'; // live mode only: stand the tool in the teaser's own phone
}
const { data, frame } = Astro.props;
const live = Astro.slots.has('preview');
const livePhone = live && frame === 'phone';

const files = import.meta.glob<ImageMetadata>('../assets/{plp,mall}/*.{png,jpg,jpeg,webp}', { eager: true, import: 'default' });
const library: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(files).map(([path, img]) => {
    const [dir, name] = path.split('/').slice(-2);
    return [`${dir}/${name.replace(/\.(png|jpe?g|webp)$/, '')}`, img];
  })
);
// every state on the page, in reading order
const states = [
  ...new Set([
    ...data.sections.flatMap((s) => [s.state, ...s.blocks.flatMap((b) => (b.kind === 'steps' ? b.steps.map((st) => st.state) : b.kind === 'rows' ? b.rows.map((r) => r.state) : []))]),
    ...(data.experiments ?? []).map((e) => e.state),
  ].filter((x): x is string => Boolean(x))),
];
// state → the screen file that shows it, for the states that have one
const stateToShot: Record<string, string> = {};
if (data.screens && !live) {
  for (const state of states) {
    const key = `${data.screens.dir}/${data.screens.map?.[state] ?? state}`;
    if (library[key]) stateToShot[state] = key;
  }
}
const shots = [...new Set(Object.values(stateToShot))];
const altFor = (key: string) => {
  const state = Object.keys(stateToShot).find((s) => stateToShot[s] === key)!;
  return data.screens?.alts[state] ?? '';
};
const dev = import.meta.env.DEV;
const back = data.back ?? { href: '/#work', label: '← All projects' };
const hasFull = Boolean(data.gate && data.experiments?.length);

const sourceLink = data.source
  ? `<a class="ct-source" href="${data.source.href}" target="_blank" rel="noopener" title="${data.source.title}">${data.source.label}</a>`
  : '';
const dek = rich(data.dek).replace('{source}', sourceLink);

// Every section and full-study block gets an id, so the scroll points can jump
// to it. Prefixed, so none can collide with the homepage scrollspy's about /
// work / ai / contact.
const idFor = (text: string) => `s-${text.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
---

<div class="ct">
  <header class="ct-hero">
    <a class="back-link text-link" href={back.href}>{back.label}</a>
    <h1>{data.title}</h1>
    <p class="ct-dek" set:html={dek} />
    {data.facts.length > 0 && (
      <dl class="ct-facts">
        {data.facts.map((f) => (
          <div class="ct-facts__row"><dt>{f.label}</dt><dd>{f.value}</dd></div>
        ))}
      </dl>
    )}{data.visit && (
      <a class="text-link ct-visit" href={data.visit.href} target="_blank" rel="noopener">{data.visit.label} <span aria-hidden="true">↗</span></a>
    )}
  </header>

  <div class="ct-layout">
    <div class="ct-story">
      {data.sections.map((section) => (
        <section class="ct-section" id={idFor(section.heading)} data-state={section.state}>
          <h2>{section.heading}</h2>
          {section.blocks.map((block) =>
            block.kind === 'p' ? (
              <p class="ct-body" set:html={rich(block.text)} />
            ) : block.kind === 'steps' ? (
              <>
                {block.heading && <h3>{block.heading}</h3>}
                <ul class="ct-steps">
                  {block.steps.map((s) => (
                    <li class="ct-step" data-state={s.state}><b>{s.label}</b>{s.text}</li>
                  ))}
                </ul>
              </>
            ) : block.kind === 'quote' ? (
              block.consent !== false && (
                <aside class="ct-note">
                  <p>{block.text}</p>
                  <small>{block.source}</small>
                </aside>
              )
            ) : block.kind === 'inside' ? (
              <>
                <p class="ct-body ct-inside-lead">{block.lead}</p>
                <ul class="ct-inside">
                  {block.items.map((item) => <li>{item}</li>)}
                </ul>
              </>
            ) : block.kind === 'rows' ? (
              <>
                {block.heading && <h3>{block.heading}</h3>}
                <ul class="ct-steps ct-rows">
                  {block.rows.map((r) => (
                    <li class="ct-step ct-row" data-state={r.state} set:html={rich(r.text)} />
                  ))}
                </ul>
              </>
            ) : block.kind === 'prompt' ? (
              <div class="ct-prompt glass" data-prompt>
                <span class="bolt bolt--tl" aria-hidden="true"></span>
                <span class="bolt bolt--tr" aria-hidden="true"></span>
                <span class="bolt bolt--bl" aria-hidden="true"></span>
                <span class="bolt bolt--br" aria-hidden="true"></span>
                <div class="ct-prompt__head">
                  <button class="cta cta--primary" type="button" data-copy-prompt data-copied="Copied">{block.copy}</button>
                  <span class="sr-only" role="status" data-copy-status></span>
                </div>
                <pre class="ct-prompt__text" data-prompt-text>{block.text}</pre>
              </div>
            ) : (
              data.gate && (
                <div class="ct-gate" data-gate data-hash={CASE_PASSWORD_SHA256} data-dev={dev ? '1' : undefined}>
                  <p class="ct-gate__text">{data.gate.text}</p>
                  {hasFull && (
                    <>
                      <button class="cta cta--primary" type="button" data-gate-open aria-expanded="false" aria-controls="full">{data.gate.cta}</button>
                      <form class="ct-gate__form" data-gate-form hidden>
                        <label class="ct-gate__label" for="case-pass">Password</label>
                        <div class="ct-gate__row">
                          <input class="ct-gate__input" id="case-pass" name="password" type="password" autocomplete="current-password" required />
                          <button class="cta cta--secondary" type="submit">Open</button>
                        </div>
                        <p class="ct-gate__msg" data-gate-msg role="status" aria-live="polite"></p>
                      </form>
                    </>
                  )}
                </div>
              )
            )
          )}
        </section>
      ))}

      {hasFull && (
        <section class="ct-full" id="full" aria-labelledby="full-title" hidden>
          <h2 class="sr-only" id="full-title" tabindex="-1">The full case study</h2>
          {data.experiments!.map((e) => (
            <article class="ct-exp" id={idFor(e.title)} data-state={e.state}>
              <div class="ct-exp__head">
                <h3>{e.title}</h3>
                {e.status && <p class="ct-exp__status">{e.status}</p>}
              </div>
              <div class="ct-exp__part"><p class="ct-exp__label">Why</p><p class="ct-body" set:html={rich(e.why)} /></div>
              {e.how && <div class="ct-exp__part"><p class="ct-exp__label">How</p><p class="ct-body" set:html={rich(e.how)} /></div>}
              {e.worked && <div class="ct-exp__part"><p class="ct-exp__label">What worked</p><p class="ct-body" set:html={rich(e.worked)} /></div>}
            </article>
          ))}
        </section>
      )}
    </div>

    <aside class:list={['ct-panel', { 'ct-panel--live': live }]} aria-label={data.panelLabel ?? 'Preview'} data-case-panel data-map={JSON.stringify(stateToShot)}>
      <div class="ct-pane glass">
        <span class="bolt bolt--tl" aria-hidden="true"></span>
        <span class="bolt bolt--tr" aria-hidden="true"></span>
        <span class="bolt bolt--bl" aria-hidden="true"></span>
        <span class="bolt bolt--br" aria-hidden="true"></span>
        <div class="ct-stage">
          {livePhone ? (
            <div class="ct-phone ct-phone--live">
              <div class="ct-live ct-live--framed"><slot name="preview" /></div>
              {/* phones only: the mini phone grows to full size in place (an
                  iframe moved into a dialog would reload) */}
              <button class="ct-pip__enlarge" type="button" aria-label="Enlarge the preview" data-pip-enlarge></button>
            </div>
          ) : live ? (
            <div class="ct-live"><slot name="preview" /></div>
          ) : (
            <div class="ct-phone">
              {shots.map((key, i) => (
                <Image
                  class="ct-screen"
                  data-screen={key}
                  src={library[key]}
                  alt={altFor(key)}
                  widths={[360, 720]}
                  sizes="360px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                />
              ))}
              {dev && <p class="ct-phone__dev" data-dev-label></p>}
              {/* phones only: the mini phone opens the screen full size */}
              <button class="ct-pip__enlarge" type="button" aria-label="Enlarge the preview" data-pip-enlarge></button>
            </div>
          )}
          <button class="ct-pip__close" type="button" aria-label="Hide the preview" data-pip-close><span aria-hidden="true">×</span></button>
        </div>
      </div>
    </aside>
  </div>
  {/* Scroll points (Uttham, 2026-10-01: "section type scroll points, that we
      see in chatgpt and reference portfolio… so I can swiftly navigate inside
      the page"): a tick per section in the right gutter, the one being read
      drawn longer and darker; hover or focus opens the names; a click jumps.
      The full study's blocks join once it is opened. */}
  <nav class="ct-points" aria-label="On this page" data-points>
    <ol class="ct-points__list">
      {data.sections.map((section) => (
        <li>
          <a class="ct-points__link" href={`#${idFor(section.heading)}`} data-point>
            <span class="ct-points__label">{section.heading}</span>
            <span class="ct-points__tick" aria-hidden="true"></span>
          </a>
        </li>
      ))}
      {hasFull && data.experiments!.map((e) => (
        <li class="ct-points__full" hidden>
          <a class="ct-points__link" href={`#${idFor(e.title)}`} data-point>
            <span class="ct-points__label">{e.title}</span>
            <span class="ct-points__tick" aria-hidden="true"></span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
  <span class="ct-end" data-case-end aria-hidden="true"></span>
  <button class="ct-pip__restore cta cta--secondary" type="button" data-pip-restore hidden>Show preview</button>{livePhone && <div class="ct-pip__scrim" data-pip-scrim hidden></div>}
  {!live && (
    <dialog class="ct-zoom" data-pip-zoom aria-label="Preview, enlarged">
      <img class="ct-zoom__img" data-pip-zoom-img alt="" />
      <button class="ct-zoom__close" type="button" aria-label="Close the enlarged preview" data-pip-zoom-close><span aria-hidden="true">×</span></button>
    </dialog>
  )}
</div>

<script>
  // ---- the phone follows the reading -------------------------------------
  // Every [data-state] on the left is a trigger. The one crossing the reading
  // band — the middle tenth of the screen on a laptop, the middle of what the
  // sticky phone leaves on a phone — picks the screen. A state without a screen
  // keeps the last one, so the phone never goes blank mid-read.
  const panel = document.querySelector<HTMLElement>('[data-case-panel]');
  const root = document.querySelector<HTMLElement>('.ct');
  if (panel && root) {
    const byKey = new Map(
      [...panel.querySelectorAll<HTMLElement>('[data-screen]')].map((el) => [el.dataset.screen!, el])
    );
    // state → its screen, resolved at build time (data-map); empty in live mode
    const stateMap: Record<string, string> = JSON.parse(panel.dataset.map || '{}');
    const shots = { get: (state: string) => byKey.get(stateMap[state]) };
    const devLabel = panel.querySelector<HTMLElement>('[data-dev-label]');
    const triggers = [...root.querySelectorAll<HTMLElement>('[data-state]')];
    // A state with no screen yet shows the nearest earlier state's screen, in
    // reading order — the same whether the reader scrolled down to it, jumped
    // to it or reloaded on it.
    const fallback = new Map<HTMLElement, HTMLElement | undefined>();
    let lastShot: HTMLElement | undefined;
    triggers.forEach((t) => {
      lastShot = shots.get(t.dataset.state!) ?? lastShot;
      fallback.set(t, lastShot);
    });
    let shown: HTMLElement | null = null;
    let current: HTMLElement | null = null;

    const show = (trigger: HTMLElement) => {
      if (trigger === current) return;
      current?.classList.remove('is-current');
      trigger.classList.add('is-current');
      current = trigger;
      const state = trigger.dataset.state!;
      panel.dataset.showing = state;
      // a live preview (a running tool in the slot) follows along by event
      document.dispatchEvent(new CustomEvent('case:state', { detail: { state } }));
      const own = shots.get(state);
      const next = own ?? fallback.get(trigger) ?? null;
      if (devLabel) devLabel.textContent = own ? '' : `No screen yet: ${state}`;
      if (next === shown) return;
      shown?.classList.remove('is-on');
      next?.classList.add('is-on');
      shown = next;
    };

    const wide = window.matchMedia('(min-width: 768px)');
    const visible = new Set<HTMLElement>();
    let io: IntersectionObserver | null = null;

    const pick = () => {
      const tail = tailBand();
      const pool: Iterable<HTMLElement> = tail === null ? visible : triggers;
      if (tail === null && !visible.size) return;
      const mid = tail ?? bandCentre();
      let best: HTMLElement | null = null;
      let bestD = Infinity;
      for (const el of pool) {
        const r = el.getBoundingClientRect();
        const d = Math.abs((r.top + r.bottom) / 2 - mid);
        if (d < bestD) { bestD = d; best = el; }
      }
      if (best) show(best);
    };

    // The reading band's centre, in viewport px: the middle of the screen at
    // every width now that phones float the preview instead of stacking it.
    const bandCentre = () => innerHeight / 2;

    // Where a page ends on its last rows (the AI Space pages have nothing
    // after them), those rows can never scroll up to the middle, so the
    // preview would never reach them. Only then, over the last half screen of
    // scrolling, the band slides from the middle down to the last row's centre
    // and every trigger is a candidate. A page whose rows all reach the middle
    // (a case study, with "More cases" after it) never takes this path.
    const tailBand = (): number | null => {
      const last = triggers[triggers.length - 1];
      if (!last) return null;
      const half = innerHeight / 2;
      const maxScroll = document.documentElement.scrollHeight - innerHeight;
      const r = last.getBoundingClientRect();
      const lastMid = r.top + scrollY + r.height / 2;
      if (lastMid <= maxScroll + half) return null;
      const remaining = maxScroll - scrollY;
      if (remaining >= half) return null;
      const t = 1 - Math.max(0, remaining) / half;
      return half + t * (lastMid - maxScroll - half);
    };

    const observe = () => {
      io?.disconnect();
      visible.clear();
      const mid = bandCentre();
      const half = innerHeight * 0.05;
      const top = Math.max(0, Math.round(mid - half));
      const bottom = Math.max(0, Math.round(innerHeight - mid - half));
      io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            const el = e.target as HTMLElement;
            if (e.isIntersecting) visible.add(el);
            else visible.delete(el);
          });
          pick();
        },
        { rootMargin: `-${top}px 0px -${bottom}px 0px`, threshold: 0 }
      );
      triggers.forEach((t) => io!.observe(t));
    };

    // The observer only speaks when a row crosses the band's edge, and smooth
    // scrolling keeps moving after it has spoken — so the choice is re-made on
    // every scroll frame too, from the rows the observer says are in the band.
    let frame = 0;
    window.addEventListener('scroll', () => {
      if (frame) return;
      frame = requestAnimationFrame(() => { frame = 0; pick(); });
    }, { passive: true });

    if (triggers[0]) show(triggers[0]);
    observe();
    wide.addEventListener('change', observe);
    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      window.clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(observe, 150);
    });
    document.addEventListener('case:full-open', observe);
  }

  // ---- phones: the preview floats (learnt from the bus-discovery reference) --
  // Below 768px there is no room beside the text, so the phone becomes a mini
  // player in the bottom-right corner: it appears once the hero has gone, keeps
  // following the reading, opens full size on a tap, hides on ×, and steps out
  // of the way at the end of the study. A live tool in the teaser's phone
  // (frame="phone") opens full size in place instead of in the dialog — moving
  // an iframe reloads it — and × or the dimmed page shrinks it back.
  {
    const panelEl = document.querySelector<HTMLElement>('[data-case-panel]');
    const heroEl = document.querySelector<HTMLElement>('.ct-hero');
    const endEl = document.querySelector<HTMLElement>('[data-case-end]');
    const restore = document.querySelector<HTMLButtonElement>('[data-pip-restore]');
    const close = document.querySelector<HTMLButtonElement>('[data-pip-close]');
    const enlarge = document.querySelector<HTMLButtonElement>('[data-pip-enlarge]');
    const zoom = document.querySelector<HTMLDialogElement>('[data-pip-zoom]');
    const zoomImg = document.querySelector<HTMLImageElement>('[data-pip-zoom-img]');
    const zoomClose = document.querySelector<HTMLButtonElement>('[data-pip-zoom-close]');
    const scrim = document.querySelector<HTMLElement>('[data-pip-scrim]');
    if (panelEl && heroEl && endEl && restore && close) {
      const phone = window.matchMedia('(max-width: 767.98px)');
      let heroGone = false;
      let atEnd = false;
      let dismissed = false;
      // live phone only: the mini player grown to full size where it stands
      let big = false;
      const hideLabel = close.getAttribute('aria-label') ?? '';
      const grow = (on: boolean) => {
        if (!scrim || big === on) return;
        big = on;
        panelEl.classList.toggle('is-pip-big', on);
        scrim.hidden = !on;
        close.setAttribute('aria-label', on ? 'Shrink the preview' : hideLabel);
      };
      const sync = () => {
        const inPlay = phone.matches && heroGone && !atEnd;
        if (!inPlay) grow(false);
        panelEl.classList.toggle('is-pip-on', inPlay && !dismissed);
        restore.hidden = !(inPlay && dismissed);
      };
      new IntersectionObserver(([e]) => { heroGone = !e.isIntersecting && e.boundingClientRect.bottom <= 0; sync(); }).observe(heroEl);
      new IntersectionObserver(([e]) => { atEnd = e.isIntersecting || e.boundingClientRect.top < 0; sync(); }).observe(endEl);
      phone.addEventListener('change', sync);

      close.addEventListener('click', () => {
        if (big) { grow(false); enlarge?.focus(); return; }
        dismissed = true; sync(); restore.focus();
      });
      restore.addEventListener('click', () => { dismissed = false; sync(); (enlarge ?? close).focus(); });

      // screens: the current screen opens in the dialog. A live tool has no
      // single screen to show there, so the teaser's live phone grows in place.
      if (enlarge && zoom && zoomImg && zoomClose) {
        enlarge.addEventListener('click', () => {
          const on = panelEl.querySelector<HTMLImageElement>('.ct-screen.is-on');
          if (!on) return;
          zoomImg.src = on.currentSrc || on.src;
          zoomImg.alt = on.alt;
          zoom.showModal();
        });
        zoomClose.addEventListener('click', () => zoom.close());
        // a tap on the dimmed backdrop closes it too
        zoom.addEventListener('click', (event) => { if (event.target === zoom) zoom.close(); });
        zoom.addEventListener('close', () => enlarge.focus());
      } else if (enlarge && scrim) {
        const shrink = () => { grow(false); enlarge.focus(); };
        enlarge.addEventListener('click', () => { grow(true); close.focus(); });
        scrim.addEventListener('click', shrink);
        document.addEventListener('keydown', (event) => { if (event.key === 'Escape' && big) shrink(); });
      }
    }
  }

  // ---- scroll points: which section is being read --------------------------
  // The current point is the last section whose top has passed 40% of the
  // screen — re-checked each scroll frame, and when the full study opens (its
  // blocks join the rail then).
  {
    const nav = document.querySelector<HTMLElement>('[data-points]');
    if (nav) {
      const links = [...nav.querySelectorAll<HTMLAnchorElement>('a[data-point]')];
      const targets = links.map((a) => document.getElementById(decodeURIComponent(a.hash.slice(1))));
      let current: HTMLAnchorElement | null = null;
      const update = () => {
        const line = innerHeight * 0.4;
        let next: HTMLAnchorElement | null = null;
        targets.forEach((t, i) => {
          if (t && !t.closest('[hidden]') && t.getBoundingClientRect().top <= line) next = links[i];
        });
        if (next === current) return;
        current?.removeAttribute('aria-current');
        (next as HTMLAnchorElement | null)?.setAttribute('aria-current', 'location');
        current = next;
      };
      let frame = 0;
      window.addEventListener('scroll', () => {
        if (frame) return;
        frame = requestAnimationFrame(() => { frame = 0; update(); });
      }, { passive: true });
      window.addEventListener('resize', update);
      document.addEventListener('case:full-open', () => {
        nav.querySelectorAll<HTMLElement>('.ct-points__full').forEach((li) => { li.hidden = false; });
        update();
      });
      update();
    }
  }

  // ---- the prompt: copied word for word --------------------------------------
  // The panel's <pre> is the source, so what is read and what is copied are the
  // same text. Clipboard blocked (an insecure origin, a denied permission): the
  // prompt is selected and the old copy command tried, so the reader can still
  // take it.
  document.querySelectorAll<HTMLElement>('[data-prompt]').forEach((panel) => {
    const btn = panel.querySelector<HTMLButtonElement>('[data-copy-prompt]');
    const text = panel.querySelector<HTMLElement>('[data-prompt-text]');
    const status = panel.querySelector<HTMLElement>('[data-copy-status]');
    if (!btn || !text) return;
    const label = btn.textContent ?? '';
    const done = btn.dataset.copied ?? 'Copied';
    let timer = 0;
    btn.addEventListener('click', async () => {
      let ok = true;
      try {
        await navigator.clipboard.writeText(text.textContent ?? '');
      } catch {
        const range = document.createRange();
        range.selectNodeContents(text);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        try { ok = document.execCommand('copy'); } catch { ok = false; }
      }
      if (!ok) return;
      btn.textContent = done;
      if (status) status.textContent = done;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        btn.textContent = label;
        if (status) status.textContent = '';
      }, 1600);
    });
  });

  // ---- the light gate ------------------------------------------------------
  // Uttham chose a light gate (2026-10-01): a speed bump, not protection — the
  // full study is in the page. The password is compared by its SHA-256, which
  // `npm run case-password` writes to src/data/case-gate.ts. With no password
  // set, the dev server opens it with any entry and a production build for no one.
  const gate = document.querySelector<HTMLElement>('[data-gate]');
  const full = document.getElementById('full');
  if (gate && full) {
    const openBtn = gate.querySelector<HTMLButtonElement>('[data-gate-open]')!;
    const form = gate.querySelector<HTMLFormElement>('[data-gate-form]')!;
    const input = form.querySelector<HTMLInputElement>('input')!;
    const msg = form.querySelector<HTMLElement>('[data-gate-msg]')!;
    const hash = gate.dataset.hash ?? '';
    const dev = gate.dataset.dev === '1';
    const KEY = 'plp-case-full-open';

    const reveal = (focus: boolean) => {
      full.hidden = false;
      openBtn.setAttribute('aria-expanded', 'true');
      openBtn.hidden = true;
      form.hidden = true;
      gate.classList.add('is-open');
      try { sessionStorage.setItem(KEY, '1'); } catch { /* storage blocked: it just won't stay open on reload */ }
      document.dispatchEvent(new Event('case:full-open'));
      if (focus) document.getElementById('full-title')?.focus({ preventScroll: false });
    };

    try { if (sessionStorage.getItem(KEY) === '1') reveal(false); } catch { /* storage blocked */ }

    openBtn.addEventListener('click', () => {
      form.hidden = false;
      if (!hash && dev) msg.textContent = 'No password set yet (npm run case-password). On the dev server any entry opens it.';
      input.focus();
    });

    const sha256 = async (text: string) => {
      const buf = await crypto.subtle.digest('SHA-256', new TextEncoder().encode(text));
      return [...new Uint8Array(buf)].map((b) => b.toString(16).padStart(2, '0')).join('');
    };

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const value = input.value;
      const ok = hash ? (await sha256(value)) === hash : dev && value.length > 0;
      if (ok) {
        input.value = '';
        msg.textContent = '';
        reveal(true);
      } else {
        msg.textContent = 'That password doesn’t match.';
        input.select();
      }
    });
  }
</script>

<style>
  .ct {
    position: relative;
    z-index: 1;
    width: min(calc(100% - var(--margin-side) * 2), var(--container-max));
    margin: 0 auto;
    /* a whole section gap before "More cases", as between every section */
    padding-bottom: var(--section-y);
    /* the sub-group step: --group-gap, floored at --space-6 so a group heading
       keeps 2:1 over its 16px to its rows even where --group-gap is 24 */
    --ct-sub: max(var(--group-gap), var(--space-6));
  }

  /* ---- hero: the case page's own entrance, the reference's content ---- */
  .ct-hero > * {
    transition: opacity var(--dur-3) var(--ease-enter), transform var(--dur-3) var(--ease-enter);
  }
  .ct-hero > :nth-child(2) { transition-delay: var(--stagger-1); }
  .ct-hero > :nth-child(3) { transition-delay: calc(var(--stagger-1) * 2); }
  .ct-hero > :nth-child(4) { transition-delay: calc(var(--stagger-1) * 3); }
  .ct-hero > :nth-child(5) { transition-delay: calc(var(--stagger-1) * 4); }
  @starting-style {
    .ct-hero > * { opacity: 0; transform: translateY(12px); }
  }
  .back-link { margin-bottom: var(--group-gap); }
  h1 {
    max-width: 19ch;
    margin: 0;
    font-size: var(--text-hero);
    font-weight: 600;
    letter-spacing: var(--track-display);
    line-height: var(--lh-display);
    text-wrap: balance;
  }
  .ct-dek {
    max-width: 600px;
    margin: var(--content-gap) 0 0;
    color: var(--ink-600);
    font-size: var(--text-body-lg);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }
  /* the one figure on the page, linked to where Meesho states it */
  .ct-dek :global(.ct-source) {
    color: var(--ink-900);
    text-decoration: underline;
    text-decoration-color: var(--amber-700);
    text-decoration-thickness: 2px;
    text-underline-offset: 4px;
  }
  .ct-dek :global(.ct-source:focus-visible) { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  /* Facts: label and value on one line each, the rules dashed like the
     measure — never solid (the site draws no solid rules on paper). */
  .ct-facts {
    max-width: 600px;
    margin: var(--group-gap) 0 0;
    padding: var(--space-5) 0;
    display: grid;
    gap: var(--space-2);
    border-block: 1px dashed var(--line-mark);
  }
  .ct-facts__row { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: var(--space-5); align-items: baseline; }
  .ct-facts dt {
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .ct-facts dd { margin: 0; color: var(--ink-900); font-size: var(--text-body); line-height: var(--lh-body); }
  /* a live thing the reader can open themselves, under the facts */
  .ct-visit { margin-top: var(--group-gap); }

  /* ---- the reading column and the phone beside it ---- */
  /* THE SPACING LADDER, the homepage's own (CLAUDE.md), stepped up for reading
     — Uttham, 2026-10-01: "as the reference website shared, make sure there is
     lot of spacing… it should match that system". The reference pads each
     chapter 80px top and bottom (160 apart), heading 18px over its text, intro
     32–48px over what follows. Here:
       between sections, hero → story, story → More cases   --section-y (96–160)
       heading → its text                                    --head-gap (24)
       text → a sub-group (rows, note, list, gate), and
       above a sub-group's heading              --ct-sub: --group-gap, ≥32 (32–48)
       sub-group heading → its rows                          --space-4 (16)
       paragraph → paragraph                                 --space-4 (16)
       row padding / label → line                            --space-5 / --space-2
     Each step is a clear step under the one above, so a heading always sits
     nearer its own text than the section before it (law of proximity). */
  .ct-layout { margin-top: var(--section-y); }
  .ct-story { display: grid; gap: var(--section-y); min-width: 0; }
  .ct-section, .ct-full { min-width: 0; }
  h2 {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 600;
    letter-spacing: var(--track-heading);
    line-height: var(--lh-heading);
    text-wrap: balance;
  }
  h3 {
    margin: var(--ct-sub) 0 0;
    font-size: var(--text-h4);
    font-weight: 600;
    letter-spacing: var(--track-heading);
    line-height: var(--lh-heading);
  }
  .ct-body {
    max-width: 62ch;
    margin: var(--space-4) 0 0;
    color: var(--ink-600);
    font-size: var(--text-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }
  .ct-body :global(.em) { color: var(--ink-900); font-weight: 600; }
  .ct-body :global(.em--lg) { font-size: 1.28em; line-height: 1.25; }

  /* Ruled rows, the case index's dashed recipe: the label on its own line, the
     line under it. The row being read takes an amber tick in the gutter —
     colour only, nothing moves. */
  h2 + .ct-body { margin-top: var(--head-gap); }
  .ct-steps { margin: var(--ct-sub) 0 0; padding: 0; list-style: none; }
  h3 + .ct-steps { margin-top: var(--space-4); }
  .ct-step {
    position: relative;
    padding: var(--space-5) 0;
    border-top: 1px dashed var(--line-mark);
    color: var(--ink-600);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }
  .ct-step:last-child { border-bottom: 1px dashed var(--line-mark); }
  .ct-step b { display: block; margin-bottom: var(--space-2); color: var(--ink-900); font-weight: 600; }
  .ct-step::before {
    content: '';
    position: absolute;
    left: calc(-1 * var(--space-4));
    top: var(--space-5);
    bottom: var(--space-5);
    width: 2px;
    background: transparent;
    transition: background-color var(--dur-2) var(--ease-standard);
  }
  .ct-step.is-current::before { background: var(--amber-700); }
  /* a row of prose rather than a label and its line: the highlight is the bold */
  .ct-row :global(.em) { color: var(--ink-900); font-weight: 600; }
  /* rows or the prompt straight under a section's h2 take the heading's own
     gap, as a first paragraph does; after text they are a sub-group */
  .ct-section > h2 + .ct-rows,
  .ct-section > h2 + .ct-prompt { margin-top: var(--head-gap); }

  /* the verbatim, once consent is confirmed: the case page's sticky note */
  .ct-note {
    max-width: 34ch;
    margin: var(--ct-sub) 0 0 var(--space-4);
    padding: var(--space-5) var(--space-5) var(--space-4);
    background: var(--amber-400);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-stuck);
    rotate: -2deg;
    font-family: var(--font-hand);
    color: var(--ink-900);
  }
  .ct-note p { margin: 0; font-size: var(--text-note); font-weight: 500; line-height: var(--lh-heading); }
  .ct-note small { display: block; margin-top: var(--space-3); font-family: var(--font-paper); font-size: var(--text-small); color: var(--ink-900); }
  /* a paragraph after a tilted note clears its corner by a group step */
  .ct-note + .ct-body { margin-top: var(--ct-sub); }

  /* live mode: a running tool fills the stage; the tool sizes its own frame */
  .ct-live { position: relative; width: 100%; height: 100%; }
  /* …unless it stands in the teaser's own phone (frame="phone"): then the
     phone is the frame, sized like the screens, and the tool fills it */
  .ct-live--framed { position: absolute; inset: 0; width: auto; height: auto; }

  /* ---- the prompt: the guide's bolted glass panel, the prompt as a white
     card ON it (CLAUDE.md, Images) and the page's one primary sticker ---- */
  .ct-prompt {
    position: relative;
    margin-top: var(--group-gap);
    padding: var(--bolt-content-inset) var(--panel-padding);
    border-radius: var(--radius-sm);
    display: grid;
    gap: var(--space-4);
  }
  .ct-prompt__head { display: flex; align-items: center; }
  .ct-prompt__text {
    margin: 0;
    padding: var(--card-padding);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    color: var(--ink-900);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: var(--text-small);
    line-height: var(--lh-body);
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }

  .ct-inside-lead { margin-top: var(--ct-sub); }
  .ct-inside {
    display: grid;
    gap: var(--space-2);
    margin: var(--space-3) 0 0;
    padding: 0 0 0 var(--space-4);
    list-style: '— ';
    color: var(--ink-600);
    font-size: var(--text-body);
    line-height: var(--lh-body);
  }

  /* ---- the gate: a paper card (the tiles' white stock, not glass — Uttham,
     2026-10-01: "no need of glass for this, just use the card structure")
     holding the one primary sticker ---- */
  .ct-gate {
    position: relative;
    max-width: 560px;
    margin-top: var(--ct-sub);
    padding: var(--card-padding);
    display: grid;
    justify-items: start;
    gap: var(--space-5);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
  }
  .ct-gate__text { margin: 0; color: var(--ink-600); font-size: var(--text-body); line-height: var(--lh-body); }
  .ct-gate__form { display: grid; gap: var(--space-2); width: 100%; }
  /* the global sticker sets display, which beats the hidden attribute */
  .ct-gate [hidden] { display: none; }
  .ct-gate__label {
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .ct-gate__row { display: flex; flex-wrap: wrap; gap: var(--control-gap); align-items: center; }
  /* a control, so the controls' square corner (--radius-control) */
  .ct-gate__input {
    flex: 1 1 200px;
    min-width: 0;
    min-height: var(--space-7);
    padding: 0 var(--space-4);
    /* ink-400 is ~3.5:1 on white: a control's edge must reach 3:1 (WCAG 1.4.11);
       the ruler's --line-mark is 1.9:1 and left the field invisible on paper */
    border: 1px solid var(--ink-400);
    border-radius: var(--radius-control);
    background: var(--paper-1);
    color: var(--ink-900);
    font: inherit;
    font-size: var(--text-body);
  }
  .ct-gate__input:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  .ct-gate__msg { min-height: calc(var(--text-small) * var(--lh-body)); margin: 0; color: var(--ink-900); font-size: var(--text-small); }

  /* ---- the full case study: one block per experiment, on paper ---- */
  .ct-full { display: grid; gap: var(--section-y); scroll-margin-top: calc(var(--header-height) + var(--content-gap)); }
  .ct-full[hidden] { display: none; }
  .ct-exp { display: grid; gap: var(--space-6); }
  .ct-exp__head { display: grid; justify-items: start; gap: var(--space-3); }
  .ct-exp__head h3 { margin: 0; font-size: var(--text-h3); }
  /* status as the case index's pill — the one place a pill belongs */
  .ct-exp__status {
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-pill);
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }
  .ct-exp__part { display: grid; gap: var(--space-2); }
  .ct-exp__part .ct-body { margin: 0; }
  .ct-exp__label {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  /* ---- the phone: screens on glass, a card ON the pane ---- */
  .ct-pane {
    position: relative;
    height: 100%;
    padding: var(--bolt-content-inset) var(--panel-padding);
    border-radius: var(--radius-sm);
  }
  /* sized off the stage's height AND width, so the phone always stands whole
     inside the pane, never cut and never stretched */
  .ct-stage { height: 100%; container-type: size; display: grid; place-items: center; }
  .ct-phone {
    position: relative;
    width: min(100cqw, calc(100cqh * 9 / 19.5));
    aspect-ratio: 9 / 19.5;
    overflow: hidden;
    border: 1px solid var(--line-1);
    border-radius: var(--radius-media);
    background: var(--paper-1);
    box-shadow: var(--shadow-rest);
  }
  .ct-screen {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    opacity: 0;
    scale: 1.02;
    transition: opacity var(--dur-2) var(--ease-exit), scale var(--dur-2) var(--ease-exit);
  }
  .ct-screen.is-on {
    opacity: 1;
    scale: 1;
    transition: opacity var(--dur-4) var(--ease-enter), scale var(--dur-4) var(--ease-enter);
  }
  /* dev server only: which screen the phone is waiting for */
  .ct-phone__dev {
    position: absolute;
    inset: auto var(--space-3) var(--space-3);
    margin: 0;
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    text-align: center;
  }

  /* ---- scroll points: a rail of ticks in the right gutter ---- */
  .ct-section, .ct-exp { scroll-margin-top: calc(var(--header-height) + var(--content-gap)); }
  .ct-points { display: none; }
  @media (min-width: 768px) {
    .ct-points {
      /* the rail's inner padding; halved on the 8-column grid, where the
         gutter is 40px, so the rail's box never reaches the phone pane */
      --pt-pad: var(--space-4);
      display: block;
      position: fixed;
      top: 50%;
      /* centred in the gutter beside the container, clear of the phone pane */
      /* the list's own 16px padding sits inside this, so the ticks end up
         centred in the gutter */
      right: max(0px, calc((var(--margin-side) - var(--space-5)) / 2 - var(--pt-pad)));
      translate: 0 -50%;
      z-index: var(--z-float);
    }
    .ct-points__list {
      display: grid;
      justify-items: end;
      gap: var(--space-1);
      margin: 0;
      /* the same padding open and closed, so opening never shifts the ticks */
      padding: var(--space-3) var(--pt-pad);
      list-style: none;
      border: 1px solid transparent;
      border-radius: var(--radius-sm);
      transition: background-color var(--dur-2) var(--ease-standard), border-color var(--dur-2) var(--ease-standard), box-shadow var(--dur-2) var(--ease-standard);
    }
    .ct-points__full[hidden] { display: none; }
    /* a hit area taller than the tick: 24px per point */
    .ct-points__link {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: var(--space-3);
      min-height: var(--space-5);
      color: var(--ink-600);
      font-size: var(--text-small);
      line-height: var(--lh-heading);
      text-decoration: none;
    }
    .ct-points__tick {
      flex: none;
      width: var(--space-3);
      height: 2px;
      background: var(--line-mark);
      transition: background-color var(--dur-2) var(--ease-standard);
    }
    /* the section being read: a longer, darker tick (state, not hover) */
    .ct-points__link[aria-current='location'] { color: var(--ink-900); font-weight: 600; }
    .ct-points__link[aria-current='location'] .ct-points__tick { width: var(--space-5); background: var(--ink-900); }
    /* closed, the names take no room (so the rail never covers the page) but
       stay in the accessibility tree; open on hover or focus, on a paper card */
    .ct-points__label {
      max-width: 0;
      overflow: hidden;
      white-space: nowrap;
      opacity: 0;
      transition: opacity var(--dur-2) var(--ease-standard);
    }
    .ct-points:is(:hover, :focus-within) .ct-points__list {
      background: var(--paper-1);
      border-color: var(--line-1);
      box-shadow: var(--shadow-rest);
    }
    .ct-points:is(:hover, :focus-within) .ct-points__label { max-width: 26ch; opacity: 1; text-overflow: ellipsis; }
    @media (hover: hover) and (pointer: fine) {
      .ct-points__link:hover { color: var(--ink-900); }
      .ct-points__link:hover .ct-points__tick { background: var(--ink-600); }
      .ct-points__link[aria-current='location']:hover .ct-points__tick { background: var(--ink-900); }
    }
    .ct-points__link:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
  }
  @media (min-width: 768px) and (max-width: 900px) {
    .ct-points { --pt-pad: var(--space-2); }
  }

  /* the mini-player controls exist only on phones */
  .ct-pip__enlarge, .ct-pip__close, .ct-pip__restore, .ct-pip__scrim { display: none; }

  /* Laptops and tablets: the phone stands beside the text, sticky under the
     header. On the site's 12-column grid the story takes 7 columns and the
     phone 5; on the 8-column tablet grid (≤900px) 5 and 3, which still leaves
     a ~190px phone at 768px — bigger than any strip on top could. */
  @media (min-width: 768px) {
    .ct-layout {
      display: grid;
      grid-template-columns: repeat(var(--grid-columns), minmax(0, 1fr));
      column-gap: var(--grid-gap);
      align-items: start;
    }
    .ct-story { grid-column: 1 / 8; }
    .ct-panel {
      grid-column: 8 / -1;
      grid-row: 1;
      position: sticky;
      top: calc(var(--header-height) + var(--content-gap));
      height: min(calc(100svh - var(--header-height) - 2 * var(--content-gap)), 720px);
    }
  }
  @media (min-width: 768px) and (max-width: 900px) {
    .ct-story { grid-column: 1 / 6; }
    .ct-panel { grid-column: 6 / -1; }
  }

  /* Phones: the text takes the full width and the phone floats as a mini
     player in the bottom-right corner (the bus-discovery reference's answer).
     No pane at this size — the phone itself is the floating object. */
  @media (max-width: 767.98px) {
    .ct-layout { display: block; }
    .ct-panel {
      position: fixed;
      right: var(--margin-side);
      bottom: calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
      z-index: var(--z-float);
      width: 112px;
      opacity: 0;
      visibility: hidden;
      translate: 0 var(--space-4);
      transition:
        opacity var(--dur-3) var(--ease-enter),
        translate var(--dur-3) var(--ease-enter),
        visibility 0s linear var(--dur-3);
    }
    .ct-panel.is-pip-on { opacity: 1; visibility: visible; translate: 0 0; transition-delay: 0s; }
    .ct-pane {
      height: auto;
      padding: 0;
      background: none;
      border: 0;
      box-shadow: none;
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
    .ct-pane .bolt { display: none; }
    .ct-stage { position: relative; height: auto; container-type: normal; display: block; }
    .ct-phone { width: 100%; border-radius: var(--radius-sm); box-shadow: var(--shadow-lift); }
    .ct-phone__dev { display: none; }
    .ct-pip__enlarge {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      padding: 0;
      border: 0;
      background: none;
      cursor: zoom-in;
    }
    .ct-pip__enlarge:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
    /* a control, so the controls' square corner */
    .ct-pip__close {
      display: grid;
      place-items: center;
      position: absolute;
      top: calc(-1 * var(--space-3));
      right: calc(-1 * var(--space-3));
      z-index: 3;
      width: var(--space-6);
      height: var(--space-6);
      padding: 0;
      border: 0;
      border-radius: var(--radius-control);
      background: var(--ink-900);
      color: var(--paper-1);
      font-size: var(--text-body-lg);
      line-height: 1;
      box-shadow: var(--shadow-stuck);
      cursor: pointer;
    }
    .ct-pip__close:focus-visible { outline: 2px solid var(--amber-text); outline-offset: 2px; }
    .ct-pip__restore:not([hidden]) {
      display: inline-flex;
      position: fixed;
      right: var(--margin-side);
      bottom: calc(var(--space-5) + env(safe-area-inset-bottom, 0px));
      z-index: var(--z-float);
      background: var(--paper-1);
    }
    .ct-full { scroll-margin-top: calc(var(--header-height) + var(--content-gap)); }

    /* A live tool in the teaser's phone opens full size where it stands: the
       panel grows to a handset-sized phone centred in the screen under the
       header (never wider than the tool's own 320px viewport, never taller
       than the room the header leaves), over a dimmed page, and the tool takes
       the pointer. The teaser is its own stacking context under the header, so
       the header stays on top and in use. */
    .ct-panel.is-pip-big {
      --pip-big-w: min(calc(100vw - 2 * var(--margin-side)), 320px, calc((100svh - var(--header-height) - 2 * var(--space-5)) * 9 / 19.5));
      inset: var(--header-height) 0 0;
