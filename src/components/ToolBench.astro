---
// AI Space as one bench (plans/022): the list on the left picks a tool, the
// frame on the right runs its preview, three answers sit under the frame, and
// the replicate column ends in "Copy the prompt" and "Read the guide". Only one
// panel is shown at a time; hover previews, click commits.
import type { Tool } from '../data/tools';
import { guides } from '../data/guides';
import { rich } from '../lib/rich';
import ContextLayerPreview from './ContextLayerPreview.astro';
import ResonaPreview from './ResonaPreview.astro';

interface Props { tools: Tool[] }
const { tools } = Astro.props;
const first = Math.max(0, tools.findIndex((t) => t.featured));
const guideFor = (slug: string) => guides.find((g) => g.slug === slug);
---
<div class="bench glass rv" data-bench>
  <span class="bolt bolt--tl" aria-hidden="true"></span>
  <span class="bolt bolt--tr" aria-hidden="true"></span>
  <span class="bolt bolt--bl" aria-hidden="true"></span>
  <span class="bolt bolt--br" aria-hidden="true"></span>

  <div class="bench__list" role="tablist" aria-label="Tools">
    {tools.map((t, i) => (
      <button
        class="bench__tab" role="tab" type="button"
        id={`bench-tab-${t.slug}`} aria-controls={`bench-panel-${t.slug}`}
        aria-selected={i === first ? 'true' : 'false'} tabindex={i === first ? 0 : -1}
        data-tool={t.slug}>
        <span class="bench__tabtop"><span class="bench__pill">{t.kicker}</span><span class="bench__year">{t.year}</span></span>
        <span class="bench__name">{t.name}</span>
        <span class="bench__claim" set:html={rich(t.claim)} />
      </button>
    ))}
  </div>

  <div class="bench__stage">
    {tools.map((t, i) => {
      const guide = guideFor(t.slug);
      return (
        <div class="bench__panel" role="tabpanel" id={`bench-panel-${t.slug}`} aria-labelledby={`bench-tab-${t.slug}`} data-tool={t.slug} hidden={i !== first}>
          <div class="frame">
            <span class="frame__bar">
              <span class="frame__dots" aria-hidden="true"><i></i><i></i><i></i></span>
              <span class="frame__addr">{t.chrome}</span>
              <span class="frame__note">{t.status}</span>
            </span>
            <div class="frame__view">
              {t.slug === 'context-layer' && <ContextLayerPreview />}
              {t.slug === 'resona' && <ResonaPreview />}
            </div>
          </div>

          <dl class="bench__facts">
            <div><dt>What is this</dt><dd set:html={rich(t.what)} /></div>
            <div><dt>How it helps at Meesho</dt><dd set:html={rich(t.helps)} /></div>
            <div>
              <dt>How to replicate it</dt>
              <dd set:html={rich(t.replicate)} />
              <span class="bench__actions">
                {guide && <button class="bench__copy" type="button" data-copy-prompt data-copied="Copied">Copy the prompt</button>}
                {guide && <a class="text-link" href={`/ai/${t.slug}`}>Read the guide →</a>}
                {guide && <textarea class="bench__promptsrc" hidden readonly aria-hidden="true">{guide.prompt}</textarea>}
              </span>
              {t.used && <span class="bench__used">Used in <a class="text-link" href={t.used.href}>{t.used.label}</a></span>}
            </div>
          </dl>
        </div>
      );
    })}
  </div>
</div>

<script>
  // Hover previews a tool, click commits it; arrow keys move between tabs.
  // Only one panel is visible at a time, so one preview is ever alive.
  document.querySelectorAll<HTMLElement>('[data-bench]').forEach((bench) => {
    const tabs = [...bench.querySelectorAll<HTMLButtonElement>('.bench__tab')];
    const panels = [...bench.querySelectorAll<HTMLElement>('.bench__panel')];
    let committed = tabs.find((t) => t.getAttribute('aria-selected') === 'true')?.dataset.tool ?? tabs[0]?.dataset.tool;
    let hoverTimer = 0;
    const show = (slug: string | undefined, commit: boolean) => {
      if (!slug) return;
      tabs.forEach((t) => {
        const on = t.dataset.tool === slug;
        t.setAttribute('aria-selected', on ? 'true' : 'false');
        t.tabIndex = on ? 0 : -1;
        t.classList.toggle('is-peek', on && !commit);
      });
      panels.forEach((p) => { p.hidden = p.dataset.tool !== slug; });
      if (commit) committed = slug;
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => show(tab.dataset.tool, true));
      tab.addEventListener('mouseenter', () => { window.clearTimeout(hoverTimer); hoverTimer = window.setTimeout(() => show(tab.dataset.tool, false), 140); });
      tab.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp' && e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = tabs[(i + (e.key === 'ArrowDown' || e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        next.focus(); show(next.dataset.tool, true);
      });
    });
    bench.querySelector('.bench__list')?.addEventListener('mouseleave', () => { window.clearTimeout(hoverTimer); show(committed, true); });
    bench.querySelectorAll<HTMLButtonElement>('[data-copy-prompt]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const src = btn.parentElement?.querySelector<HTMLTextAreaElement>('.bench__promptsrc');
        if (!src) return;
        try { await navigator.clipboard.writeText(src.value); } catch { src.hidden = false; src.select(); document.execCommand('copy'); src.hidden = true; }
        const label = btn.textContent; btn.textContent = btn.dataset.copied ?? 'Copied';
        window.setTimeout(() => { btn.textContent = label; }, 1600);
      });
    });
  });
</script>

<style>
  .bench { position: relative; display: grid; grid-template-columns: minmax(220px, 0.32fr) minmax(0, 1fr); gap: var(--group-gap); padding: var(--bolted-board-padding); border-radius: var(--radius-sm); }
  .bench__list { display: flex; flex-direction: column; gap: var(--space-3); align-content: start; }
  .bench__tab {
    display: grid; gap: var(--space-2); justify-items: start; text-align: left;
    padding: var(--space-4) var(--space-5);
    background: var(--paper-1); border: 1px solid var(--line-1); border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest); color: var(--ink-900); font: inherit; cursor: pointer;
    transition: border-color var(--dur-2) var(--ease-standard), background var(--dur-2) var(--ease-standard);
  }
  .bench__tab[aria-selected="true"] { border-color: var(--ink-900); background: var(--paper-0); }
  .bench__tab.is-peek { border-style: dashed; }
  .bench__tab:focus-visible { outline: 2px solid var(--ink-900); outline-offset: 2px; }
  .bench__tabtop { display: flex; justify-content: space-between; align-items: center; width: 100%; gap: var(--space-3); }
  .bench__pill, .bench__year { font-family: var(--font-paper); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--ink-600); white-space: nowrap; }
  .bench__pill { padding: var(--space-1) var(--space-3); border: 1px solid var(--line-1); border-radius: var(--radius-pill); }
  .bench__year { font-variant-numeric: tabular-nums; }
  .bench__name { font-size: var(--text-h4); font-weight: 600; letter-spacing: var(--track-heading); line-height: var(--lh-heading); }
  .bench__claim { color: var(--ink-600); font-size: var(--text-small); line-height: var(--lh-body); text-wrap: pretty; }
  .bench__claim :global(.em), .bench__facts dd :global(.em) { color: var(--ink-900); font-weight: 600; }

  .bench__stage { min-width: 0; }
  .bench__panel { display: grid; gap: var(--content-gap); }
  .bench__panel[hidden] { display: none; }
  .frame { display: flex; flex-direction: column; min-width: 0; border: 1px solid var(--line-1); border-radius: var(--radius-inset); background: var(--paper-1); box-shadow: var(--shadow-rest); overflow: hidden; }
  .frame__bar { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-2) var(--space-3); background: var(--paper-2); border-bottom: 1px solid var(--line-1); }
  .frame__dots { display: inline-flex; gap: 4px; flex: none; }
  .frame__dots i { width: 7px; height: 7px; border-radius: 50%; background: rgba(22, 20, 14, 0.16); }
  .frame__addr { min-width: 0; flex: 1 1 auto; padding: 2px var(--space-3); border-radius: 999px; background: var(--paper-1); box-shadow: inset 0 0 0 1px var(--line-0); font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 10.5px; color: var(--ink-600); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .frame__note { flex: none; color: var(--ink-400); font-size: var(--text-eyebrow); letter-spacing: var(--track-label); text-transform: uppercase; }
  .frame__view { min-width: 0; max-height: 560px; overflow: hidden; background: var(--paper-0); }

  .bench__facts { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-6); margin: 0; }
  .bench__facts div { display: grid; gap: var(--space-2); align-content: start; padding-top: var(--space-3); border-top: 1px dashed var(--line-mark); }
  .bench__facts div + div { padding-left: var(--space-5); border-left: 1px dashed var(--line-mark); }
  .bench__facts dt { color: var(--ink-600); font-family: var(--font-paper); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; }
  .bench__facts dd { margin: 0; color: var(--ink-600); font-size: var(--text-small); line-height: var(--lh-body); text-wrap: pretty; }
  .bench__actions { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3) var(--space-5); margin-top: var(--space-2); font-size: var(--text-small); }
  .bench__copy { padding: var(--space-2) var(--space-4); background: var(--ink-900); color: var(--paper-0); border: 0; border-radius: var(--radius-control); font: inherit; font-size: var(--text-small); font-weight: 500; cursor: pointer; }
  .bench__copy:focus-visible { outline: 2px solid var(--ink-900); outline-offset: 2px; }
  .bench__used { color: var(--ink-600); font-size: var(--text-small); }
  .bench__promptsrc { position: absolute; left: -9999px; width: 1px; height: 1px; }

  @media (max-width: 900px) {
    .bench { grid-template-columns: 1fr; gap: var(--content-gap); }
    .bench__list { flex-direction: row; overflow-x: auto; padding-bottom: var(--space-2); }
    .bench__tab { flex: 0 0 min(72vw, 280px); }
    .bench__facts { grid-template-columns: 1fr; gap: var(--space-4); }
    .bench__facts div + div { padding-left: 0; border-left: 0; }
  }
</style>
