---
// Full-bleed glass nav — one of the two structural bookends (brief §4).
// Copy + structure from Figma frame 2003:156.
import { Image } from 'astro:assets';
// The one avatar file — the favicons are generated from it too (CLAUDE.md,
// Favicon) — served here as a webp at its own 170×242 instead of the 40KB
// PNG, which was ~5x the size the header shows it at (perf pass 2026-10-02).
import avatar from '../../public/assets/avatar.png';

interface Props {
  active?: 'about' | 'projects' | 'contact' | 'ai' | 'none'; // 'none': a page no nav item names (the 404)
  heroAvatar?: boolean; // the page opens on the hero portrait, so the avatar starts folded away (motion.js brings it back)
}

const { active = 'about', heroAvatar = false } = Astro.props;
---

<header class="site-header glass glass--nav" data-hero-nav>
  <div class="site-header__inner">
    <a class="site-header__brand" href="/" aria-label="Uttham Udatthu — home">
      <Image
        class:list={['site-header__avatar', { 'is-hidden': heroAvatar }]}
        data-header-avatar
        src={avatar}
        alt=""
        loading="eager"
      />
      <span class="site-header__wordmark on-glass">
        UTTHAM <span class="site-header__wordmark-last">UDATTHU</span>
      </span>
    </a>
    <nav class="site-header__nav" aria-label="Primary">
      <a class:list={[{ 'is-active': active === 'about' }]} data-nav="about" href="/#about">About Me</a>
      <a class:list={[{ 'is-active': active === 'projects' }]} data-nav="work" href="/#work">Projects</a>
      <a class:list={[{ 'is-active': active === 'ai' }]} data-nav="ai" href="/#ai">AI Space</a>
      <a class:list={[{ 'is-active': active === 'contact' }]} data-nav="contact" href="/#contact">Contact</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: var(--z-header);
    border-left: none;
    border-right: none;
    border-top: none;
  }

  /* The bar runs edge to edge; its CONTENT stands on the page's grid lines
     (Uttham, 2026-10-03: "the header content als should have the same spacing
     left and right along the grid lines"; it ran to the viewport's gutters
     from 2026-10-01). The inset is GridOverlay's own --edge — the side margin,
     or half of what the viewport leaves beside the 1200px container, rounded
     down to a pixel as the lines are — so the wordmark starts on the left line
     and the nav ends on the right one at every width. Height is untouched:
     --header-height still sets the rhythm (min-height below). */
  .site-header__inner {
    width: 100%;
    padding-inline: round(down, max(var(--margin-side), (100% - var(--container-max)) / 2), 1px);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-5);
    min-height: var(--header-height);
    padding-block: var(--space-2);
  }

  /* The avatar carries its own trailing gap instead of the brand's flex gap,
     so folding it away takes the gap with it. */
  .site-header__brand {
    display: flex;
    align-items: center;
    text-decoration: none;
  }

  .site-header__avatar {
    --avatar-h: clamp(38px, 3.75vw, 52px);
    --avatar-gap: var(--space-4);
    height: var(--avatar-h);
    width: calc(var(--avatar-h) * 170 / 242); /* the file's own 170×242, so the width can animate */
    margin-inline-end: var(--avatar-gap);
    transition:
      opacity var(--dur-2) var(--ease-standard),
      width var(--dur-2) var(--ease-standard),
      margin-inline-end var(--dur-2) var(--ease-standard);
  }

  /* On pages with the hero Instax photo the avatar starts hidden — a second
     small portrait right next to the big one reads as clutter — and motion.js
     brings it back once that photo scrolls out of view. Hidden, it takes no
     room: the name sits on the left gutter, and slides over as the avatar
     arrives (Uttham, 2026-10-03: "the name should be left aligned when no
     favicon, once it is there move the name"). */
  .site-header__avatar.is-hidden {
    opacity: 0;
    width: 0;
    margin-inline-end: 0;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .site-header__avatar { transition: opacity var(--dur-2) var(--ease-standard); }
  }

  .site-header__wordmark {
    /* heading/h3 token — brand lockup, no Figma sizes */
    font-family: var(--font-glass);
    font-weight: 600;
    font-size: var(--text-wordmark);
    letter-spacing: var(--track-heading);
    color: var(--ink-900);
    white-space: nowrap;
  }

  .site-header__wordmark-last {
    font-weight: 400;
    color: var(--ink-600);
    margin-inline-start: var(--space-1);
  }

  .site-header__nav {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: clamp(var(--space-4), 2vw, var(--space-6));
  }

  /* eyebrow-size type still needs a ≥44px tap target */
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-block: var(--space-2);
  }

  .site-header__nav a {
    /* Shared label: 12px, medium weight, 0.06em tracking. */
    font-family: var(--font-glass);
    font-weight: 500;
    font-size: var(--text-eyebrow);
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    text-decoration: none;
    color: var(--etch-ink);
    transition: color var(--dur-1) var(--ease-standard);
    text-shadow: var(--etch-shadow);
    position: relative;
  }

  /* link hover — underline draws left→right (brief §9) */
  .site-header__nav a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: var(--space-1);
    height: 1.5px;
    width: 100%;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform var(--dur-2) var(--ease-standard);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-header__nav a:hover::after {
      transform: scaleX(1);
    }
  }

  .site-header__nav a.is-active {
    color: var(--amber-text);
    text-shadow: var(--etch-shadow);
  }

  @media (max-width: 900px) {
    .site-header__inner {
      display: grid;
      grid-template-columns: 1fr;
      gap: var(--space-1);
      padding-block: var(--space-1);
    }

    .site-header__avatar { --avatar-h: var(--space-6); --avatar-gap: var(--space-2); }
    .site-header__wordmark { font-size: var(--text-h4); }
    .site-header__nav { justify-content: space-between; gap: var(--space-1); flex-wrap: nowrap; }
    .site-header__nav a { min-block-size: 44px; padding-block: 0; font-size: var(--text-eyebrow); letter-spacing: var(--track-label); }
  }

  @media (max-width: 360px) {
    .site-header__wordmark { font-size: var(--text-h4); }
    .site-header__nav a { font-size: var(--text-eyebrow); }
  }
</style>
