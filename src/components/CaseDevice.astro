---
// The handset the case pages' screens stand in (Uttham, 2026-10-03: "can you
// create a realisitic phone mock that renders this a,so the title and spacings
// of this card can be optimised"), drawn in CSS — an Android handset of the
// Pixel / OnePlus kind (2026-10-03: "instead of iphone lets use oneplus or pixel
// phone"): a graphite body with a bezel of even thickness, a display with an
// Android status bar (the clock on the left, a punch-hole camera in the middle,
// Wi-Fi, signal and battery on the right) and a gesture-bar strip, its power
// key and volume rocker both on the right edge. No brand marks, no images.
//
// The screen itself is the caller's: the default slot is the display's middle
// row, exactly 1 : 2, the proportion of Uttham's exports. The status bar sits
// ABOVE that row and the home strip below it, inside the bezel, never over the
// screenshot: his exports start on their own header row (a search bar, a back
// arrow) with no status bar of their own, so an island laid over them would
// hide it. Each strip takes the colour of the screen edge it meets (the
// caller sets --ct-device-top / --ct-device-foot and data-top-ink /
// data-foot-ink on this element, and data-following while a clip drives them
// frame by frame; src/lib/edge-colour.ts), as an app's own status bar does, so
// strip and screen read as one display.
//
// The size comes from one length the caller sets, --ct-device-screen: the
// display's width. Everything else is a proportion of it (--ct-device-k-*, on
// the teaser's root), so the handset is a scale drawing at every size — the
// sticky card, the 112px mini player, the enlarged dialog. The display row is
// 1 : 2 unless the caller sets --ct-device-r (its height over its width): only
// the enlarged dialog does, to stand a page capture in a taller handset of the
// same width (Uttham, 2026-10-03: "you can increase the phone size but not the
// width"). The `home` slot holds the "Scroll ↓" chip, which stands in the home
// strip rather than on the screenshot.
interface Props {
  class?: string;
  [attr: string]: unknown;
}
const { class: className, ...rest } = Astro.props;
---

<div class:list={['ct-device', className]} {...rest}>
  <div class="ct-device__glass">
    <div class="ct-device__status" aria-hidden="true">
      <span class="ct-device__time">9:30</span>
      <span class="ct-device__camera"></span>
      <span class="ct-device__icons">
        <svg class="ct-device__icon ct-device__icon--wifi" viewBox="0 0 16 12" fill="currentColor">
          <path d="M8 11.6 0.4 3.9a10.8 10.8 0 0 1 15.2 0Z" />
        </svg>
        <svg class="ct-device__icon ct-device__icon--signal" viewBox="0 0 12 12" fill="currentColor">
          <path d="M11.5 0.5v11h-11Z" />
        </svg>
        <svg class="ct-device__icon ct-device__icon--battery" viewBox="0 0 8 13" fill="currentColor">
          <rect x="2.6" y="0" width="2.8" height="1.6" rx="0.5" />
          <rect x="0.5" y="1.4" width="7" height="11.1" rx="1.4" />
        </svg>
      </span>
    </div>
    <slot />
    <div class="ct-device__home" aria-hidden="true">
      <span class="ct-device__bar"></span>
      <slot name="home" />
    </div>
  </div>
</div>

<style>
  /* Every length is a share of the display's width (W, --ct-device-screen):
       bezel          0.03 W, even all round
       status bar     0.12 W (the clock, the island, the glyphs)
       screen         2 W    (the caller's 1 : 2 row; r W with --ct-device-r)
       home strip     0.10 W (the home indicator)
     so the body is 1.06 W × 2.28 W, a modern handset's ~19.5 : 9. The radii
     are concentric: the display's corner is 0.10 W, no deeper than either
     strip, so it never rounds a corner off the screenshot; the body's is that
     plus the bezel (outer = inner + padding). */
  .ct-device {
    --ct-device-r-own: var(--ct-device-r, 2);
    --ct-device-w: calc(var(--ct-device-screen) * var(--ct-device-k-wide));
    --ct-device-h: calc(var(--ct-device-screen) * (var(--ct-device-r-own) + var(--ct-device-k-status) + var(--ct-device-k-home) + 2 * var(--ct-device-k-bezel)));
    --ct-device-bezel: calc(var(--ct-device-screen) * var(--ct-device-k-bezel));
    --ct-device-radius: calc(var(--ct-device-screen) * var(--ct-device-k-radius));
    /* graphite: the body is the darkest ink, the metal band around it a step
       lighter, the keys the band's own metal */
    --ct-device-body: var(--ink-900);
    --ct-device-frame: color-mix(in oklab, var(--ink-900) 70%, var(--ink-400));
    /* the band's width, and each key's: the band plus at least a pixel, so a
       key always stands proud of the band, even at the mini player's 112px
       (both had clamped to 1px there, the key hidden under the band) */
    --ct-device-ring: max(1px, calc(var(--ct-device-screen) * 0.005));
    --ct-device-key: calc(var(--ct-device-ring) + max(1px, calc(var(--ct-device-screen) * 0.009)));
    /* the strips' colours until the caller sets the screen's own (inline) */
    --ct-device-top: var(--paper-1);
    --ct-device-foot: var(--paper-1);
    position: relative;
    box-sizing: border-box;
    width: var(--ct-device-w);
    height: var(--ct-device-h);
    padding: var(--ct-device-bezel);
    border-radius: calc(var(--ct-device-radius) + var(--ct-device-bezel));
    background: var(--ct-device-body);
    /* depth from layered shadows, not a border: the metal band as a hairline
       ring, its inner highlight, then the paper's own rest and lift shadows */
    box-shadow:
      0 0 0 var(--ct-device-ring) var(--ct-device-frame),
      inset 0 0 0 1px color-mix(in oklab, var(--paper-1) 9%, transparent),
      var(--shadow-rest),
      var(--shadow-lift);
  }
  /* the keys, on the band, both on the right edge as on a Pixel or a OnePlus:
     the power key, then the longer volume rocker under it */
  .ct-device::before,
  .ct-device::after {
    content: '';
    position: absolute;
    right: calc(-1 * var(--ct-device-key));
    width: var(--ct-device-key);
    background: var(--ct-device-frame);
    border-radius: 0 var(--ct-device-key) var(--ct-device-key) 0;
  }
  .ct-device::before {
    top: calc(var(--ct-device-screen) * 0.46);
    height: calc(var(--ct-device-screen) * 0.13);
  }
  .ct-device::after {
    top: calc(var(--ct-device-screen) * 0.68);
    height: calc(var(--ct-device-screen) * 0.3);
  }

  /* the display: status bar, the caller's screen, home strip */
  .ct-device__glass {
    position: relative;
    display: grid;
    grid-template-rows:
      calc(var(--ct-device-screen) * var(--ct-device-k-status))
      calc(var(--ct-device-screen) * var(--ct-device-r-own))
      calc(var(--ct-device-screen) * var(--ct-device-k-home));
    height: 100%;
    overflow: hidden;
    border-radius: var(--ct-device-radius);
    /* under the rows, the same two colours, so no seam between them can show
       the body through */
    background: linear-gradient(var(--ct-device-top) 50%, var(--ct-device-foot) 50%);
    isolation: isolate;
  }
  /* the glass's edge: a 1px ring of pure black at low opacity, drawn just
     inside, so a white screen still has an edge against the bezel */
  .ct-device__glass::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: inherit;
    outline: 1px solid oklch(0 0 0 / 0.1);
    outline-offset: -1px;
    pointer-events: none;
  }
  .ct-device__status,
  .ct-device__home {
    color: var(--ink-900);
    transition: background-color var(--dur-2) var(--ease-standard), color var(--dur-2) var(--ease-standard);
  }
  /* while a clip drives them, a colour lands on the frame that brings it */
  .ct-device[data-following] .ct-device__status,
  .ct-device[data-following] .ct-device__home { transition: none; }
  .ct-device__status {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    background-color: var(--ct-device-top);
    font-family: var(--font-paper);
    font-size: calc(var(--ct-device-screen) * 0.043);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    letter-spacing: -0.01em;
    line-height: 1;
  }
  .ct-device[data-top-ink='light'] .ct-device__status { color: var(--paper-1); }
  /* Android: the clock at the left, the glyphs at the right, each a
     status-bar margin in from its edge, the punch-hole camera between them */
  .ct-device__status { padding-inline: calc(var(--ct-device-screen) * 0.06); }
  .ct-device__time { justify-self: start; }
  .ct-device__camera {
    width: calc(var(--ct-device-screen) * 0.055);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ct-device-body);
    box-shadow: inset 0 0 0 calc(var(--ct-device-screen) * 0.008) color-mix(in oklab, var(--ct-device-body) 80%, var(--paper-1));
  }
  .ct-device__icons {
    justify-self: end;
    display: flex;
    align-items: center;
    gap: calc(var(--ct-device-screen) * 0.016);
  }
  .ct-device__icon { display: block; height: calc(var(--ct-device-screen) * 0.034); width: auto; }
  .ct-device__icon--wifi { aspect-ratio: 16 / 12; }
  .ct-device__icon--signal { aspect-ratio: 1; }
  .ct-device__icon--battery { aspect-ratio: 8 / 13; height: calc(var(--ct-device-screen) * 0.038); }

  .ct-device__home {
    display: grid;
    place-items: center;
    background-color: var(--ct-device-foot);
  }
  .ct-device[data-foot-ink='light'] .ct-device__home { color: var(--paper-1); }
  /* the home indicator; the "Scroll ↓" chip, when it shows, stands over it */
  .ct-device__home > :global(*) { grid-area: 1 / 1; }
  .ct-device__bar {
    /* Android's gesture handle, shorter than an iPhone's home indicator */
    width: calc(var(--ct-device-screen) * 0.26);
    height: max(1.5px, calc(var(--ct-device-screen) * 0.014));
    border-radius: var(--radius-pill);
    background: currentColor;
    opacity: 0.9;
    transition: opacity var(--dur-2) var(--ease-standard);
  }
</style>
