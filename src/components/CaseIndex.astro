---
// The second layer of the Projects section: every case that is not on the
// board, one ruler-styled row each — year, kicker, title, one line, arrow.
// No media, so it scales to twenty cases without the page growing much.
//
// Also the entry points at the END OF A PAGE (`end`): "More cases" after a
// case study, and "More tools" after an AI Space tool page (Uttham,
// 2026-10-03: "and similar to projects at the end give entry points for next
// ones in ai prototype also"). Cases pass `items` (studies); anything else
// passes `rows`, already shaped, every word from its own data file — a tool
// row is its name, its card's line, and the year and kicker tools.ts gives it.
// A row without a year or kicker leaves that cell empty, never invented.
import type { Study } from '../data/studies';
import { rich } from '../lib/rich';

type Row = { href: string; year?: string; kicker?: string; title: string; line: string };
interface Props { items?: Study[]; rows?: Row[]; label?: string; end?: boolean }
const { items = [], rows: given, label, end = false } = Astro.props;
const rows: Row[] = given ?? items.map((s) => ({ href: `/work/${s.slug}`, year: s.year, kicker: s.kicker, title: s.title, line: s.summary }));
---
{rows.length > 0 && (
  <nav class:list={['case-index', { 'case-index--end': end }]} aria-label={label ?? 'More cases'}>
    {label && <p class="case-index__label">{label}</p>}
    <ol class="case-index__list">
      {rows.map((r) => (
        <li class="case-index__row">
          <a class="case-index__link" href={r.href} data-astro-prefetch>
            <span class="case-index__year">{r.year}</span>
            {r.kicker ? <span class="case-index__kicker">{r.kicker}</span> : <span />}
            <span class="case-index__title">{r.title}</span>
            <span class="case-index__line" set:html={rich(r.line)} />
            <span class="case-index__arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ol>
  </nav>
)}

<style>
  .case-index { position: relative; z-index: 1; }
  /* at the end of a page: the page's own column, after the layout's whole
     --section-y bottom pad, and one --section-y-sm under the last row */
  .case-index--end { width: min(calc(100% - var(--margin-side) * 2), var(--container-max)); margin: 0 auto var(--section-y-sm); }
  .case-index__label { margin: 0 0 var(--space-3); color: var(--ink-600); font-family: var(--font-paper); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; }
  .case-index__list { margin: 0; padding: 0; list-style: none; border-top: 1px dashed var(--line-mark); }
  .case-index__row { border-bottom: 1px dashed var(--line-mark); }
  .case-index__link {
    display: grid;
    grid-template-columns: 6ch auto minmax(0, 1fr) minmax(0, 1.6fr) auto;
    align-items: baseline;
    gap: var(--space-4);
    padding: var(--space-4) var(--space-2);
    color: inherit;
    text-decoration: none;
  }
  .case-index__year { color: var(--ink-600); font-family: var(--font-paper); font-size: var(--text-eyebrow); font-weight: 500; font-variant-numeric: tabular-nums; letter-spacing: var(--track-label); white-space: nowrap; }
  .case-index__kicker { align-self: center; padding: var(--space-1) var(--space-3); border: 1px solid var(--line-1); border-radius: var(--radius-pill); color: var(--ink-600); font-family: var(--font-paper); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; white-space: nowrap; }
  .case-index__title { font-size: var(--text-h4); font-weight: 600; letter-spacing: var(--track-heading); line-height: var(--lh-heading); color: var(--ink-900); }
  .case-index__line { color: var(--ink-600); font-size: var(--text-small); line-height: var(--lh-body); text-wrap: pretty; }
  .case-index__line :global(.em) { color: var(--ink-900); font-weight: 600; }
  .case-index__arr { color: var(--ink-600); transition: transform var(--dur-2) var(--ease-standard), color var(--dur-2) var(--ease-standard); }
  /* hover is colour and the arrow nudge only — nothing lifts or moves */
  .case-index__link:hover .case-index__title { color: var(--amber-600, var(--ink-900)); }
  .case-index__link:hover .case-index__arr { transform: translateX(4px); color: var(--ink-900); }
  .case-index__link:focus-visible { outline: 2px solid var(--ink-900); outline-offset: 2px; }
  @media (max-width: 900px) {
    .case-index__link { grid-template-columns: 6ch auto minmax(0, 1fr) auto; }
    .case-index__line { grid-column: 3 / span 1; grid-row: 2; }
  }
  @media (max-width: 640px) {
    .case-index__link { grid-template-columns: auto auto minmax(0, 1fr); row-gap: var(--space-2); }
    .case-index__title { grid-column: 1 / -1; grid-row: 2; }
    .case-index__line { grid-column: 1 / -1; grid-row: 3; }
    .case-index__arr { grid-column: 3; grid-row: 1; justify-self: end; }
  }
</style>
