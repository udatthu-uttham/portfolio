---
// The resume page (/resume): his CV, public/uttham-udatthu-cv.pdf, as a page a
// recruiter can read in a tab, with the PDF one click away. The words are the
// CV's own; only grammar, spelling (British) and punctuation are fixed, and
// date ranges take one format. The phone number stays in the PDF only: this
// page names the email and LinkedIn, as the contact panel does.
// One taped sheet on the board, as the 404 and the project tiles are: the
// header block and its actions across the top, then About, Education,
// Certifications and Expertise in a sidebar beside Work Experience on a laptop,
// one column on a phone. Prints on A4 without the header or the actions.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import GridOverlay from '../components/GridOverlay.astro';
import { contact } from '../data/studies';
import { SITE, NAME, resumeTitle, resumeLd, describe } from '../lib/seo';
import { rich } from '../lib/rich';

const PDF = '/uttham-udatthu-cv.pdf';
const PDF_NAME = 'Uttham-Udatthu-CV-2026.pdf';

const headline = 'Design Leader with 10+ years of experience';

const about = [
  'Design leader with a **strong record of cross-functional collaboration and mentoring teams** across B2C and B2B SaaS.',
  'Driven by a **problem-first and user-first mindset**, prioritising a deep understanding of user needs and business challenges to deliver impactful solutions.',
  'Advocating a **culture of continuous learning**, I empower teams to consistently produce delightful experiences, eager to apply **my strategic vision and people management skills** as a design manager to drive innovation, product excellence and measurable growth.',
];

type Point = { title?: string; text: string };
type Job = { company: string; at?: string; role: string; dates: string; product?: string; summary?: string; points: Point[] };

const jobs: Job[] = [
  {
    company: 'Meesho',
    role: 'Lead Product Designer',
    dates: 'Apr 2022–present',
    summary: 'Shaping the end-user mobile experience of Meesho.',
    points: [
      {
        title: 'Pioneered the design vision for strategic programmes Meesho Mall and Meesho Gold',
        text: 'Led these **flagship branded programmes from inception**, shaping strategy and evolution through continuous user learning. **Mentored junior designers**, running design critiques and raising craft quality across the team.',
      },
      {
        title: 'Revamped post-order journeys to reduce cancellations and boost NPS',
        text: 'Led a team in **overhauling order tracking and Meesho balance comprehension**, resulting in higher NPS and a reduction in order cancellation.',
      },
      {
        title: 'Helping intent channelisation for Meesho users',
        text: 'Translated complex projects like intent channelisation levers for rural users, category-specific feeds, Meesho Reels and filtering systems into **actionable, user-centric designs** that set new standards for engagement.',
      },
    ],
  },
  {
    company: 'Flyhomes',
    role: 'Senior Product Designer',
    dates: 'Aug 2021–Apr 2022',
    summary: 'Designing internal tools.',
    points: [
      { text: '**Heading the Indian design team**, responsible for end-to-end execution and stakeholder management for crafting delightful experiences.' },
    ],
  },
  {
    company: 'Yuj Design',
    at: 'Amdocs',
    role: 'Usability Design Expert',
    dates: 'Feb 2019–Aug 2021',
    points: [
      { text: 'Worked on a **B2B telecom product which has three parts**: Care web app, Technician tablet app, and Selfcare web and mobile app.' },
      { text: '**Leading a design team of four**, my work involves close coordination with the project stakeholders, translating the requirements into design, setting up the usability testing plan in the project and making interactive flows of critical hero flows for demos to clients.' },
    ],
  },
  {
    company: 'Digital Control Incorporation',
    role: 'VR UX/UI Artist',
    dates: 'May 2018–Oct 2018',
    product: 'VR training app',
    summary: 'It is a VR product for training in HDD drilling.',
    points: [
      { text: 'Set up the design process, made a design system and set up a **storyboarding process tailored for VR**. The setup resulted in efficient and delightful VR experiences, and I conducted **exhaustive usability tests** to test efficiency and usability.' },
    ],
  },
  {
    company: 'Newgen Technologies',
    role: 'UX/UI Designer',
    dates: 'Jun 2016–May 2018',
    product: 'B2B BPM software',
    summary: 'It is a banking BPM product customised for various clients.',
    points: [
      { text: 'Responsible for conducting stakeholder meetings in the organisation to understand requirements, **enhancing legacy modules of the product** and, in parallel, **building a design system for the product**.' },
    ],
  },
];

const education = {
  degree: 'B.Tech in Industrial Design',
  school: 'National Institute of Technology (NIT), Rourkela',
  dates: 'Aug 2012–May 2016',
};

const certifications = [
  { name: 'UX Management', by: 'Interaction Design Foundation' },
  { name: 'Design Thinking', by: 'Interaction Design Foundation' },
  { name: 'Human-Centred Design', by: 'Coursera' },
];

const expertise = [
  'Team & People Management',
  'Cross-functional Leadership',
  'Consumer-facing Product Design',
  'Product Strategy',
  'Hiring & Team Building',
  'Coaching & Mentoring Designers',
  'Data + Research-driven Design',
  'Communication & Storytelling',
];

const linkedinLabel = contact.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, '');

const url = `${SITE}/resume`;
const seoDescription = describe(headline, about[0]);
const ld = resumeLd({ url, description: seoDescription });
---

<Base title={resumeTitle} description={seoDescription} jsonLd={ld}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header active="none" />

  <main id="main" class="cv" tabindex="-1">
    <GridOverlay />
    <article class="cv__sheet" aria-labelledby="cv-name">
      <img class="cv__tape" src="/assets/stickers/washi.svg" alt="" width="128" height="349" aria-hidden="true" />

      <header class="cv__head">
        <div class="cv__id">
          <p class="cv__kicker">Resume</p>
          <h1 id="cv-name">{NAME}</h1>
          <p class="cv__headline">{headline}</p>
          <ul class="cv__contact" aria-label="Contact">
            <li><a class="text-link" href={`mailto:${contact.email}`}>{contact.email}</a></li>
            <li><a class="text-link" href={contact.linkedin} target="_blank" rel="noopener">{linkedinLabel}</a></li>
          </ul>
        </div>
        <div class="cv__actions">
          <p class="cv__downloaded" role="status" hidden>
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true"><path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" /></svg>
            CV downloaded<span class="cv__again"> · <a class="text-link" href={PDF} download={PDF_NAME}>Download again</a></span>
          </p>
          <a class="cta cta--primary cv__download" href={PDF} download={PDF_NAME}>Download PDF</a>
        </div>
      </header>

      <div class="cv__body">
        <aside class="cv__side">
          <section class="cv__block cv__block--about" aria-labelledby="cv-about">
            <h2 id="cv-about">About Me</h2>
            {about.map((s) => <p class="cv__about" set:html={rich(s)} />)}
          </section>

          <section class="cv__block" aria-labelledby="cv-education">
            <h2 id="cv-education">Education</h2>
            <p class="cv__item-title">{education.degree}</p>
            <p class="cv__muted">{education.school}</p>
            <p class="cv__dates">{education.dates}</p>
          </section>

          <section class="cv__block" aria-labelledby="cv-certs">
            <h2 id="cv-certs">Certifications</h2>
            <ul class="cv__list">
              {certifications.map((c) => (
                <li>
                  <span class="cv__item-title">{c.name}</span>
                  <span class="cv__muted">{c.by}</span>
                </li>
              ))}
            </ul>
          </section>

          <section class="cv__block" aria-labelledby="cv-expertise">
            <h2 id="cv-expertise">Expertise</h2>
            <ul class="cv__tags">
              {expertise.map((e) => <li>{e}</li>)}
            </ul>
          </section>
        </aside>

        <section class="cv__main" aria-labelledby="cv-work">
          <h2 id="cv-work">Work Experience</h2>
          <ol class="cv__jobs">
            {jobs.map((job) => (
              <li class="cv__job">
                <div class="cv__job-head">
                  <h3>
                    {job.company}
                    {job.at && <span class="cv__at">at {job.at}</span>}
                  </h3>
                  <p class="cv__dates">{job.dates}</p>
                </div>
                <p class="cv__role">{job.role}{job.product && <span class="cv__muted"> · {job.product}</span>}</p>
                {job.summary && <p class="cv__summary">{job.summary}</p>}
                <ul class="cv__points">
                  {job.points.map((pt) => (
                    <li>
                      {pt.title && <p class="cv__point-title">{pt.title}</p>}
                      <p set:html={rich(pt.text)} />
                    </li>
                  ))}
                </ul>
              </li>
            ))}
          </ol>
        </section>
      </div>
    </article>
  </main>
</Base>

<script>
  // Opened by the homepage's "Download CV", which downloads the PDF and opens
  // this page as /resume#downloaded: say so in place of the button (one way to
  // download again stays), then tidy the address.
  if (location.hash === '#downloaded') {
    document.querySelector<HTMLElement>('.cv__downloaded')?.removeAttribute('hidden');
    document.querySelector<HTMLElement>('.cv__download')?.setAttribute('hidden', '');
    history.replaceState(null, '', location.pathname + location.search);
  }
</script>

<style>
  .cv {
    position: relative;
    padding: calc(var(--header-height) + var(--section-pad)) var(--margin-side) var(--section-pad);
  }

  /* one white sheet, taped to the board the way a project tile is */
  .cv__sheet {
    position: relative;
    z-index: 1;
    width: min(100%, var(--container-max));
    margin-inline: auto;
    /* the content clears the tape by one within-card step (CLAUDE.md, spacing) */
    padding: max(var(--card-padding), calc(18px + var(--space-4))) var(--card-padding) var(--card-padding);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
    color: var(--ink-900);
  }

  .cv__tape {
    position: absolute;
    top: 0;
    left: calc(50% - var(--space-4));
    width: var(--space-6);
    height: auto;
    translate: 0 -50%;
    rotate: 92deg;
    mix-blend-mode: multiply;
    opacity: 0.9;
    pointer-events: none;
  }

  /* ---- the top: name, headline, contact, and the two actions ---- */
  .cv__head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-5) var(--space-6);
    padding-bottom: var(--card-padding);
    border-bottom: 1px dashed var(--line-1);
  }

  .cv__id { display: grid; gap: var(--space-2); }

  .cv__kicker {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: var(--text-h2);
    font-weight: 600;
    line-height: var(--lh-display);
    letter-spacing: var(--track-heading);
  }

  .cv__headline {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--text-body-lg);
    line-height: var(--lh-statement);
  }

  .cv__contact {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }
  .cv__contact .text-link { font-size: var(--text-body); overflow-wrap: anywhere; }

  .cv__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    padding: var(--space-2) var(--space-1); /* room for the stickers' lean */
  }

  .cv__downloaded {
    flex-basis: 100%;
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    color: var(--ink-900);
    font-size: var(--text-small);
    font-weight: 600;
  }
  .cv__downloaded[hidden], .cv__download[hidden] { display: none; }
  .cv__again { font-weight: 400; color: var(--ink-600); }
  .cv__downloaded svg { color: var(--amber-text); flex: none; }

  /* ---- the body: sidebar and experience ---- */
  .cv__body {
    display: grid;
    gap: var(--space-7);
    padding-top: var(--card-padding);
  }

  @media (min-width: 900px) {
    .cv__body {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: var(--space-8);
    }
    .cv__side {
      padding-right: var(--space-8);
      margin-right: calc(var(--space-8) * -1);
      border-right: 1px dashed var(--line-1);
    }
  }

  .cv__side { display: grid; align-content: start; gap: var(--space-7); }

  /* one column: About, then the experience, then the rest of the sidebar, so
     a recruiter on a phone reaches the work before the certificates */
  @media (max-width: 899.98px) {
    .cv__side { display: contents; }
    .cv__block { order: 2; }
    .cv__block--about { order: 0; }
    .cv__main { order: 1; }
  }
  .cv__block { display: grid; gap: var(--space-2); }

  h2 {
    margin: 0 0 var(--space-2);
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 600;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  p { margin: 0; }

  .cv__about {
    font-size: var(--text-body);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }
  .cv__about + .cv__about { margin-top: var(--space-2); }

  .cv__item-title { display: block; font-weight: 600; }
  .cv__muted { color: var(--ink-600); }
  .cv__list .cv__muted { display: block; }

  .cv__dates {
    color: var(--ink-600);
    font-size: var(--text-small);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .cv__list,
  .cv__tags,
  .cv__jobs,
  .cv__points {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cv__list { display: grid; gap: var(--space-4); }

  .cv__tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }
  .cv__tags li {
    padding: var(--space-1) var(--space-3);
    background: var(--paper-0);
    border-radius: var(--radius-sm);
    font-size: var(--text-small);
    line-height: var(--lh-heading);
    padding-block: var(--space-2);
  }

  /* ---- experience ---- */
  .cv__main { min-width: 0; }
  .cv__main h2 { margin-bottom: var(--space-5); }

  .cv__jobs { display: grid; }
  .cv__job { display: grid; gap: var(--space-2); }
  .cv__summary,
  .cv__points { max-width: 68ch; }
  .cv__job + .cv__job {
    margin-top: var(--space-6);
    padding-top: var(--space-6);
    border-top: 1px dashed var(--line-1);
  }

  .cv__job-head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-1) var(--space-4);
  }

  h3 {
    margin: 0;
    font-size: var(--text-h4);
    font-weight: 600;
    line-height: var(--lh-heading);
    letter-spacing: var(--track-heading);
  }
  .cv__at {
    margin-left: var(--space-2);
    color: var(--ink-600);
    font-size: var(--text-body);
    font-weight: 500;
    letter-spacing: 0;
  }

  .cv__role { font-weight: 600; }
  .cv__summary { color: var(--ink-600); }

  .cv__points {
    display: grid;
    gap: var(--space-4);
    margin-top: var(--space-2);
  }
  .cv__points li {
    position: relative;
    padding-left: var(--space-5);
    line-height: var(--lh-body);
    text-wrap: pretty;
  }
  .cv__points li::before {
    content: '';
    position: absolute;
    left: var(--space-1);
    top: 0.7em;
    width: var(--space-2);
    height: 2px;
    background: var(--amber-500);
  }
  .cv__point-title { font-weight: 600; margin-bottom: var(--space-1); }

  .cv :global(strong.em) { font-weight: 600; }

  /* ---- print: the sheet alone, on A4 ---- */
  @media print {
    @page { size: A4; margin: 14mm 14mm 16mm; }

    :global(.site-header),
    :global(.skip-link),
    .cv__downloaded,
    :global(.grid-overlay),
    :global(.ride-smoke),
    .cv__actions,
    .cv__tape { display: none !important; }

    :global(html), :global(body) { background: #fff !important; }
    :global(body::before), :global(body::after) { display: none !important; }

    .cv { padding: 0; }
    .cv__sheet {
      width: 100%;
      padding: 0;
      border: 0;
      box-shadow: none;
      border-radius: 0;
      font-size: 10.5pt;
    }
    h1 { font-size: 24pt; }
    h3 { font-size: 12.5pt; }
    .cv__headline { font-size: 12pt; }
    .cv__contact .text-link { font-size: 10.5pt; }
    .cv__contact .text-link::after { display: none; }

    .cv__body {
      grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
      gap: 10mm;
    }
    .cv__side { padding-right: 0; margin-right: 0; border-right: 0; gap: 7mm; }
    .cv__job + .cv__job { margin-top: 5mm; padding-top: 5mm; }
    .cv__job { break-inside: avoid; }
    .cv__tags li { background: none; border: 1px solid var(--line-1); }
  }
</style>
