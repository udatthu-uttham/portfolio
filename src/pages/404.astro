---
// The not-found page (domain trust pass, 2026-10-03; CLAUDE.md, "Domain
// trust"). Cloudflare serves it, with a 404 status, for any address that
// matches no file, because wrangler.jsonc sets not_found_handling to
// "404-page"; without that a wrong link got an empty 404. One taped sheet on
// the board, as a project tile is, and the ways back. Kept out of the index
// and the sitemap.
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import GridOverlay from '../components/GridOverlay.astro';
---

<Base title="Page not found — Uttham Udatthu" description="This address has no page on uttham.fyi." noindex>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header active="none" />

  <main id="main" class="nf" tabindex="-1">
    <GridOverlay />
    <div class="nf__sheet">
      <img class="nf__tape" src="/assets/stickers/washi.svg" alt="" width="128" height="349" aria-hidden="true" />
      <p class="nf__code">404</p>
      <h1>Page not found</h1>
      <p class="nf__lead">The address may have changed, or it was never here.</p>
      <div class="nf__ways">
        <a class="cta cta--primary" href="/">Back to the homepage</a>
        <a class="text-link" href="/#work">See the projects <span aria-hidden="true">→</span></a>
      </div>
    </div>
  </main>
</Base>

<style>
  .nf {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: calc(var(--header-height) + var(--section-pad)) var(--margin-side) var(--section-pad);
  }

  /* one white sheet, taped to the board the way a project tile is */
  .nf__sheet {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
    width: min(100%, 560px);
    /* the title clears the tape by one within-card step (CLAUDE.md, spacing) */
    padding: max(var(--card-padding), calc(18px + var(--space-4))) var(--card-padding) var(--card-padding);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
  }

  .nf__tape {
    position: absolute;
    top: 0;
    left: calc(50% - var(--space-4));
    width: var(--space-6);
    height: auto;
    translate: 0 -50%;
    rotate: 92deg;
    mix-blend-mode: multiply;
    opacity: 0.9;
    pointer-events: none;
  }

  .nf__code {
    margin: 0;
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
  }

  h1 {
    margin: 0;
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--lh-heading);
    letter-spacing: var(--track-heading);
    text-wrap: balance;
  }

  .nf__lead {
    margin: 0;
    color: var(--ink-600);
    text-wrap: pretty;
  }

  .nf__ways {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-5) var(--space-6);
    margin-top: var(--space-4);
  }
</style>
