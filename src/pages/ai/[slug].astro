---
// One AI Space tool, as a one-pager (Uttham, 2026-10-02: "no need to have
// teaser, just a one pager only"), in the case studies' layout (2026-10-01:
// "clicking on the card will move to ai space teaser page, where
// the right side is running preview as we did for the project case studies").
// The left column is the white-label guide — how it helps, what you get, what
// you need, the prompt (copyable), what to change — and the sticky phone on the
// right runs the tool itself. The layout is the case studies' CaseTeaser in
// live mode; the arrangement and the state of each row are in
// src/data/ai-pages.ts, the words in tools.ts and guides.ts.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import GridOverlay from '../../components/GridOverlay.astro';
import CaseTeaser from '../../components/CaseTeaser.astro';
import ResonaPreview from '../../components/ResonaPreview.astro';
import ProtoPreview from '../../components/ProtoPreview.astro';
import { guides } from '../../data/guides';
import { tools } from '../../data/tools';
import { aiPage } from '../../data/ai-pages';
import { SITE, NAME, describe, describeWhole, firstSentence, ogHome, workLd, toolSearch, searchTitle } from '../../lib/seo';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const tool = tools.find((t) => t.slug === guide.slug);
const page = aiPage(guide.slug);

// Search and link previews (CLAUDE.md, "Domain trust"): the tool's name and
// what kind of tool it is, as a searcher would put it, then his name, e.g.
// "Realistic prototype for user research — Uttham Udatthu" (src/lib/seo.ts,
// toolSearch); a tool without an entry keeps "<tool> · AI Space — Uttham
// Udatthu". The description is the page's headline and who uses the tool (the
// first sentence of its Value added fact) when the two fit in 155 whole — it
// names Meesho — else the headline and the card's own line (tools.ts `what`),
// else that line alone.
const search = toolSearch[guide.slug];
const seoTitle = search ? searchTitle(search) : `${tool?.name ?? guide.title} · AI Space — ${NAME}`;
const seoDescription = tool
  ? (tool.value && describeWhole(guide.title, firstSentence(tool.value))) || describe(guide.title, tool.what)
  : describe(guide.intro);
const pageUrl = new URL(`/ai/${guide.slug}/`, SITE).href;
const toolLd = workLd({
  url: pageUrl,
  name: tool?.name ?? guide.title,
  headline: guide.title,
  description: seoDescription,
  image: new URL(ogHome.src, SITE).href,
  about: search?.about,
  keywords: search?.keywords,
});
---
<Base title={seoTitle} description={seoDescription} type="article" jsonLd={toolLd}>
  <a class="skip-link" href="#main">Skip to content</a>
  <Header active="ai" />
  <main id="main" class="ai-page" tabindex="-1">
    <GridOverlay />
    <CaseTeaser data={page} frame="phone">
      <Fragment slot="preview">
        {guide.slug === 'resona' && <ResonaPreview fill follow />}
        {guide.slug === 'realistic-prototype' && tool?.visit && <ProtoPreview src={tool.visit.href} fill interactive />}
      </Fragment>
    </CaseTeaser>
  </main>
</Base>

<style>
  /* the case page's own frame (work/[slug].astro): the header, then half a
     section gap; the layout's own bottom pad ends the page */
  .ai-page {
    position: relative;
    min-height: 100svh;
    overflow: visible;
    padding-top: calc(var(--header-height) + var(--section-pad));
  }
</style>
