---
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import GridOverlay from '../components/GridOverlay.astro';
import SectionRule from '../components/SectionRule.astro';
import SignalLoop from '../components/SignalLoop.astro';
import InstaxFrame from '../components/InstaxFrame.astro';
import HiSticker from '../components/HiSticker.astro';
// The hero's GSAP chunk, into Base's head slot: this is the only page with a
// hero or with magnetic tiles, so it is the only page that loads GSAP.
import HeroMotion from '../components/HeroMotion.astro';
import { studies, contact } from '../data/studies';
import { rich } from '../lib/rich';
import CaseIndex from '../components/CaseIndex.astro';
import ResonaPreview from '../components/ResonaPreview.astro';
import ProtoPreview from '../components/ProtoPreview.astro';
const featuredStudies = studies.filter((s) => s.featured);
const indexedStudies = studies.filter((s) => !s.featured);
import { tools } from '../data/tools';
import { Image } from 'astro:assets';
import portrait from '../assets/uttham-portrait.webp';
import rider from '../assets/rider.png';
// Deck covers for the case tiles (slide 1 of each study's deck), keyed by file name.
const coverFiles = import.meta.glob<ImageMetadata>('../assets/{mall,cards}/*.{jpg,png}', { eager: true, import: 'default' });
const covers: Record<string, ImageMetadata> = Object.fromEntries(
  Object.entries(coverFiles).map(([path, img]) => [path.split('/').pop()!.replace(/\.(jpg|png)$/, ''), img])
);

// The replicate button hands over the guide's prompt verbatim, so the card and
// the guide page can never drift apart.

// Authored copy; unfinished metrics stay out of the rendered page.
const principles = [
  {
    title: 'Know the user two layers down.',
    tag: 'What they do → why → what it costs them',
  },
  {
    title: 'Evidence and craft, in the same room.',
    tag: 'Open with the number. Close with the bar.',
  },
  {
    // Uttham, 2026-10-01: "rather than saying speed … optimising the process
    // and leveraging AI tooling to accelerate & improve efficiency"; compacted
    // to the other two's length on 2026-10-02 ("the third how I lead is
    // verbose, please compact that whole block"). It was "Boosting design
    // workflows for improving efficiency." / "Automate repetitive tasks,
    // boosting workflows with AI."
    title: 'Design workflows, boosted by AI.',
    // Uttham, 2026-10-02: "lets rephrase this as elevate the craft and automate
    // repititive flows"
    tag: 'Elevate the craft and automate repetitive flows.',
  },
];
---

<Base title="Uttham Udatthu — Design Lead">
  <HeroMotion slot="head" />
  <a class="skip-link" href="#main">Skip to content</a>
  <Header />

  <main id="main" tabindex="-1">
    <h1 class="sr-only">Uttham Udatthu — design lead, systems thinker and builder</h1>

    <!-- the dotted column grid runs under the entire page -->
    <GridOverlay />

    <!-- ============================ ABOUT / HERO ============================ -->
    <section id="about" class="hero">

      <div class="hero__stage">
        <!-- The photo tucks behind the glass, inset clear of its corner bolts. -->
        <div class="hero__hello" data-hero-hello>
          <InstaxFrame label="Uttham Udatthu" rotate={-5} develop>
            <Image
              src={portrait}
              alt="Uttham smiling on a boat, with green cliffs behind him"
              width={480}
              widths={[160, 320, 480]}
              sizes="164px"
              loading="eager"
              fetchpriority="high"
            />
          </InstaxFrame>
          <div class="hero__hello-sticker" aria-hidden="true">
            <HiSticker />
          </div>
        </div>

        <!-- The glass and its bolts sit in front of the tucked photo edge.
             The bed holds the lamp behind the pane: same footprint, so the
             light is only ever seen through the glass. -->
        <div class="hero__bed">
          <span class="glass-lamp" aria-hidden="true"></span>
          <div class="hero__slab glass" data-hero-slab>
            <span class="bolt bolt--tl" aria-hidden="true"></span>
            <span class="bolt bolt--tr" aria-hidden="true"></span>
            <span class="bolt bolt--bl" aria-hidden="true"></span>
            <span class="bolt bolt--br" aria-hidden="true"></span>
            <div class="hero__copy">
              <div class="mask">
                <p class="hero__lead" data-hero-line>
                  I’m a <strong>design lead, systems thinker and builder.</strong>
                  I run the signals at the <strong>busy intersections where user needs cross business goals.</strong>
                </p>
              </div>

              <div class="hero__ctas" data-hero-ctas>
                <a class="cta cta--primary" href="/uttham-udatthu-cv.pdf" download="Uttham-Udatthu-CV-2026.pdf">Download CV</a>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- The scene and its explanation are one compact, captioned figure. -->
      <figure class="hero__aside" data-hero-art>
        <figcaption class="mask">
          <p class="hero__signals" data-hero-line>
            <strong>These days I run the signals</strong><br />
            — <strong>setting direction,</strong> deciding how to ship, and
            <strong>clearing the road for <mark class="hl">people and AI agents</mark>.</strong>
          </p>
        </figcaption>
        <div class="hero__art-window">
          <SignalLoop />
        </div>
      </figure>
    </section>

    <!-- ============================ WORK / PROJECTS ======================== -->
    <section id="work" class="section wrap" aria-label="Selected work">
      <SectionRule label="Projects" />
      <div class="sec-head rv">
        <h2 class="sec-sub">The problems, the bets, what shipped.</h2>
      </div>
      <!-- Two sheets, each with its own tape and its own picture (Uttham,
           2026-10-01: "we should have [an image] for both"). On a laptop the
           sheet is exactly as tall as the screen leaves, and the well takes
           whatever the copy does not need, so the section is one screen. -->
      <div class="workboard">
        <div class="tiles tiles--work">
          {
            featuredStudies.map((study, index) => (
              <div class="tile-reveal rv" style={`--tile-layer: ${featuredStudies.length - index};`}>
                <a
                  class="tile"
                  href={`/work/${study.slug}`}
                  data-magnetic
                  data-astro-prefetch>
                  <img class="tape" src="/assets/stickers/washi.svg" alt="" aria-hidden="true" />
                  <h3>{study.title}</h3>
                  <p class="tile__desc" set:html={rich(study.summary)} />
                  <div class={`tile__media glass ${study.deck ? 'tile__media--deck' : ''}`}>
                    {study.deck && covers[study.deck.screen] ? (
                      <div class="tile__deck"><Image src={covers[study.deck.screen]} alt="" widths={[240, 480]} sizes="240px" /></div>
                    ) : study.cover && covers[study.cover.image] ? (
                      <Image class="tile__cover" src={covers[study.cover.image]} alt="" widths={[480, 960]} sizes="480px" />
                    ) : (
                      study.placeholder && <span class="tile__ph">{study.placeholder}</span>
                    )}
                  </div>
                  <span class="tile__go text-link">Read the case study <span class="tile__arr" aria-hidden="true">→</span></span>
                </a>
              </div>
            ))
          }
        </div>
      </div>
      <CaseIndex items={indexedStudies} />
    </section>

    <!-- ============================ AI SPACE ============================== -->
    <section id="ai" class="section wrap" aria-label="AI Space">
      <SectionRule label="AI Space" />
      <div class="sec-head rv">
        <h2 class="sec-sub">Tools I build so the team moves faster.</h2>
      </div>

      <!-- Two sheets on the same board as Projects, each with its own tape and
           its own running phone. Where the sheet is wide enough the copy reads on
           the left and the phone stands on the right; narrower, they stack. The
           card is the tool's name, its one line and the phone; how it helps the
           team is on its teaser page, which the whole card opens (Uttham,
           2026-10-01). The phones are running previews and nothing else — no
           link or pill of their own. The previews run on mock data (tools.ts). -->
      <div class="workboard">
        <div class="tiles tiles--ai">
          {
            tools.map((tool, index) => (
              <div class="tile-reveal rv" style={`--tile-layer: ${tools.length - index};`}>
                <article class="tile tile--ai" data-magnetic>
                  <img class="tape" src="/assets/stickers/washi.svg" alt="" aria-hidden="true" />
                  <div class="tool__copy">
                    <h3><a class="tool__link" href={`/ai/${tool.slug}`} data-astro-prefetch>{tool.name}</a></h3>
                    <p class="tile__desc" set:html={rich(tool.what)} />
                  </div>

                  <div class="tile__media tile__media--tool glass">
                    {tool.slug === 'resona' && <ResonaPreview />}
                    {tool.slug === 'realistic-prototype' && tool.visit && <ProtoPreview src={tool.visit.href} />}
                  </div>

                  <span class="tile__go tool__go text-link" aria-hidden="true">{tool.action} <span class="tile__arr">→</span></span>
                </article>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <!-- ============================ CONTACT =============================== -->
    <section id="contact" class="section wrap" aria-label="Contact">
      <SectionRule label="Contact" />
      <!-- How I lead: one white paper sheet, the same stock as the case tiles,
           so the three principles read as one object pinned above the glass -->
      <div class="prin prin--sheet rv">
        <h3 class="prin__title">How I lead</h3>
        {
          principles.map((p, index) => (
            <div class:list={['prin__item', 'rv', { 'rv-d1': index === 1, 'rv-d2': index === 2 }]}>
              <h3>{p.title}</h3>
              <p class="prin__tag">{p.tag}</p>
            </div>
          ))
        }
      </div>
      <div class="contact-panel glass rv contact-panel--after-prin">
        <span class="bolt bolt--tl" aria-hidden="true"></span>
        <span class="bolt bolt--tr" aria-hidden="true"></span>
        <span class="bolt bolt--bl" aria-hidden="true"></span>
        <span class="bolt bolt--br" aria-hidden="true"></span>
        <div class="contact-panel__body">
          <h2 class="contact-panel__title on-glass">Let’s catch up</h2>
          <p class="contact-panel__sub">If our roads cross</p>

          <!-- every way to reach me is a sticky note on the acrylic -->
          <ul class="note-row">
            <li>
              <a class="note-link" style="--note-tilt: -3deg" href={`mailto:${contact.email}`}>
                <span>email me</span>
                <small>{contact.email}</small>
                <span class="note-link__arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a
                class="note-link"
                style="--note-tilt: 2deg"
                href={contact.linkedin}
                target="_blank"
                rel="noopener">
                <span>LinkedIn</span>
                <small>{contact.linkedinHandle}</small>
                <span class="note-link__arrow" aria-hidden="true">→</span>
              </a>
            </li>
            <li>
              <a
                class="note-link"
                style="--note-tilt: -1.5deg"
                href={contact.whatsapp}
                target="_blank"
                rel="noopener">
                <span>WhatsApp</span>
                <small>{contact.phone}</small>
                <span class="note-link__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          </ul>
        </div>

        <!-- me & the bike — every ride badge lives on this photo -->
        <div class="contact-panel__photo rv rv-d1">
          <InstaxFrame
            label="Uttham on the bike"
            caption="my peaceful zone = race tracks"
            rotate={-3}
            aspect="1500 / 1602"
          >
            <Image
              src={rider}
              alt="Uttham in riding gear on his motorcycle"
              width={720}
              widths={[360, 540, 720]}
              sizes="(max-width: 639px) 300px, 340px"
              loading="lazy"
            />
          </InstaxFrame>
        </div>
      </div>
    </section>

    <footer class="wrap site-footer">
      <SectionRule />
      <span>© 2026 Uttham Udatthu</span>
      <span class="site-footer__colophon">
        General Sans · Caveat
        <span class="footer-sticker" style="--note-tilt: 2deg">crafted with lots of Claude tokens 😛</span>
      </span>
    </footer>
  </main>
</Base>

<style>
  /* ============================ shared layout ========================= */
  main {
    position: relative; /* the page-wide grid overlay anchors to this */
  }

  .wrap {
    width: min(calc(100% - var(--margin-side) * 2), var(--container-max));
    margin-inline: auto;
  }

  .site-footer :global(.rule) { flex-basis: 100%; margin-bottom: 0; } /* its own row, so the copyright starts at the edge; the row gap is the 12px every ruler keeps */
  .site-footer { position: relative; }

  .section,
  .site-footer {
    /* lift content above the page-wide grid overlay */
    position: relative;
    z-index: 1;
  }

  /* THE SCREEN CONTRACT (2026-10-01). Every top-level section — About, Projects,
     AI Space, Contact — is one screen with its content centred in it.
     - Projects, AI Space and Contact fill the screen below the fixed header; a
       nav jump lands their top edge under it (section[id] below).
     - Each pads itself by HALF a section gap, top and bottom (--section-pad).
       Neighbouring pads meet at the boundary, so content-to-content is always at
       least one --section-y, plus the shorter section's centring slack. No
       section owns the whole gap any more, so none can double it.
     - Content budget = 100svh - --header-height - --section-y. Content shorter
       than that is centred; taller content simply grows the section from its
       top pad down — nothing clips, nothing overlaps.
     Centring is block-level align-content, not flex or grid: the children keep
     normal flow, so their widths AND their collapsing margins (the ruler's 12px
     into the How-I-lead sheet's 32px) are exactly what they were. Browsers
     without block align-content (pre-2024) top-align, which is the old layout. */
  .section {
    min-height: calc(100svh - var(--header-height));
    padding-block: var(--section-pad);
    align-content: center;
    font-size: var(--text-body);
  }

  /* THE LAST SCREEN IS CONTACT AND THE FOOTER (Uttham, 2026-10-02: "reduce the
     space between footer and last section, so whole contact with footer can
     come in one viewport"). Contact gives up its bottom pad and the screen the
     footer needs, so a jump to #contact — or the end of the page — shows both.
     The footer's top pad is then the only gap between them: one --section-y-sm,
     the supporting-detail rung, instead of a half section gap plus that.
     --footer-block is the footer's whole height in tokens: its top pad, the
     ruler's row gap, its one line (the sticker: body × heading leading plus its
     4px pads) and its bottom pad. */
  main {
    --footer-block: calc(var(--section-y-sm) + var(--space-3) + var(--text-body) * var(--lh-heading) + var(--space-2) + var(--card-padding));
  }
  #contact {
    min-height: calc(100svh - var(--header-height) - var(--footer-block));
    padding-bottom: 0;
    /* A jump lands the CONTENT one --space-6 under the header, not the top
       pad: the pad is the boundary with AI Space, and showing it would push
       the footer off the bottom. Where Contact is only its min-height (tall
       screens) the page cannot scroll that far, and the jump lands exactly as
       every other section's does. */
    scroll-margin-top: calc(var(--header-height) + var(--space-6) - var(--section-pad));
  }

  /* One landing rule for every nav jump, Contact included. */
  section[id] {
    scroll-margin-top: var(--header-height);
  }

  /* One quiet heading per section: the nav word, close to its content and far
     from the section before it. No label above, no deck below (plans/016). */
  .sec-head {
    /* Close to what it introduces, but not touching it (Uttham, 2026-09-21,
       retuned 2026-09-25). The ruler above already separates this section from
       the last, so this gap only has to beat the tape's overhang — and stay a
       clear step under the between-section gap, or the grouping stops reading. */
    margin-bottom: var(--head-gap);
  }
  /* the section's heading is its sentence; the name lives on the ruler above */
  .sec-sub {
    margin: 0;
    max-width: 52ch;
    font-family: var(--font-paper);
    font-size: var(--text-h3);
    font-weight: 500;
    letter-spacing: 0;
    line-height: var(--lh-statement);
    color: var(--ink-900);
    text-wrap: balance;
  }

  h2 {
    margin: 0;
    text-wrap: balance;
    font-family: var(--font-paper);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--lh-heading);
    letter-spacing: var(--track-heading);
  }

  h3 {
    margin: 0;
    text-wrap: balance;
    font-family: var(--font-paper);
    font-size: var(--text-h3);
    font-weight: 600;
    line-height: var(--lh-heading);
    letter-spacing: var(--track-heading);
  }

  /* reveal */
  .rv {
    opacity: 0;
    transform: translateY(16px);
    transition:
      opacity var(--dur-4) var(--ease-enter),
      transform var(--dur-4) var(--ease-enter);
  }
  .rv.is-in { opacity: 1; transform: none; }
  .rv-d1 { transition-delay: var(--stagger-1); }
  .rv-d2 { transition-delay: calc(var(--stagger-1) * 2); }
  .rv-d3 { transition-delay: calc(var(--stagger-1) * 3); }

  /* ============================ hero ================================= */
  .hero {
    position: relative;
    z-index: 1; /* above the page-wide grid */
    overflow: hidden;
    /* One section per screen (Uttham, 2026-10-01): "in one viewport so many
       elements are there, I want to just show one section". The hero is the
       screen contract's first section (see .section above): it sits UNDER the
       fixed header, so it takes the whole 100svh and adds the header to its top
       pad — which leaves it the same content budget, and the same half-gap pads,
       as every other section. Its grid tracks (display: grid, further down) are
       centred in that budget, so nothing of Projects shows until you scroll.
       This retires the peek (plans/016, /018, /023). plans/006 still holds: on
       a short screen (1024x600) the hero runs past the viewport naturally and
       Projects starts at its bottom. On phones the hero is taller than the
       screen, so min-height and centring do nothing there.
       The top pad (>= 48px) also keeps the portrait and its hi! sticker clear
       of the header — it is never less than the group gap it replaced. */
    min-height: 100svh;
    align-content: center;
    padding-top: calc(var(--header-height) + var(--section-pad));
    padding-bottom: var(--section-pad);
  }

  /* The bed carries the lamp behind the pane and takes the slab's place in
     the stage grid. It is the positioning context for .glass-lamp, nothing more. */
  .hero__bed {
    position: relative;
    z-index: 2;
    min-width: 0;
  }

  .hero__slab {
    position: relative;
    z-index: 1; /* above the lamp in the bed; the bed carries the page-level z */
    border-radius: var(--radius-sm);
  }

  .hero__copy {
    /* Hardware rails include clearance for the CTA's entrance movement. */
    padding: var(--bolted-panel-padding) var(--panel-padding);
    display: flex;
    flex-direction: column;
    align-items: stretch;
    text-align: left;
  }

  .hero__art-window { border-radius: var(--radius-sm); }

  .hero__lead {
    font-family: var(--font-glass);
    font-weight: 400;
    margin: 0;
    font-size: var(--text-h3); /* the locked 38-word bio needs one step down from the old 42px */
    line-height: var(--lh-statement);
    text-wrap: pretty;
    letter-spacing: var(--track-heading);
    color: var(--etch-ink);
    max-width: none;
    text-shadow: var(--etch-shadow);
  }

  /* the signals paragraph — a handwritten annotation on the scene */
  .hero__signals {
    font-family: var(--font-hand);
    font-weight: 500;
    margin: 0;
    font-size: var(--text-note);
    line-height: var(--lh-statement);
    letter-spacing: 0;
    color: var(--ink-600);
    max-width: none;
  }

  /* Give the handwritten caption a small inset without separating it
     from the scene that it explains. */
  .hero__aside .mask {
    padding-block: var(--space-1);
  }

  .hero__lead strong { font-weight: 600; }
  .hero__signals strong { font-weight: 600; color: var(--ink-900); }

  /* The instant photo is behind the glass, outside the bolt's footprint. */
  .hero__hello {
    /* named so the sticker can find the print's centre (its shake pivot) */
    --hello-w: clamp(120px, 13vw, 164px);
    position: relative;
    z-index: 0;
    width: var(--hello-w);
    /* The tuck is deliberately deep: the photo's edge disappearing under the
       pane is the most convincing glass on the page, so the pane gets a real
       amount of it to bend rather than a sliver. The Instax chin is what goes
       under — the subject stays clear (Uttham, 2026-09-19). */
    margin: 0 0 calc(var(--space-7) * -1) var(--space-8);
  }

  .hero__hello :global(.instax) { width: 100%; }

  .hero__hello-sticker {
    /* Stuck ONTO the print's top-right corner (Uttham, 2026-10-01: "make sure
       the hi sticker is having enough overlap with the photo"). The old
       offsets (top -0.22, right -0.8) left under 1% of the bubble on the
       print once its -5deg tilt pulled the corner in. These put ~40% of the
       painted bubble over the print (~15-22% over the image itself), well
       right of the face, at every size: offsets are in the sticker's own
       width, so the bite stays the same fraction as both scale.
       It clears the fixed nav: the bubble rises at most 0.2x its width above
       the photo (12.5px at 1280, 14px at 1440; ~2.6px more at the peak of a
       shake), and the photo starts the hero's whole top pad below the header. */
    --hi-size: clamp(52px, 5vw, 72px);
    --tilt: 0deg; /* the wrapper's own turn is only ever the print's shake */
    position: absolute;
    width: var(--hi-size);
    top: calc(var(--hi-size) * -0.25);
    right: calc(var(--hi-size) * -0.42);
    /* A sticker on the print moves with the print: the wrapper pivots on the
       print's centre (the frame is ~1.36x as tall as wide), so when the
       photo shakes the sticker rides it instead of sliding over it. */
    transform-origin:
      calc(var(--hi-size) * 0.58 - var(--hello-w) * 0.5)
      calc(var(--hello-w) * 0.68 + var(--hi-size) * 0.25);
    /* decoration: the pointer reaches the photo underneath it */
    pointer-events: none;
  }

  /* The tilt and the shadow sit on the bubble itself, so the wrapper is free
     to turn with the print. Same 12deg, same --drop-stuck as before. */
  .hero__hello-sticker :global(.hi-bubble) {
    rotate: 12deg;
    filter: var(--drop-stuck);
  }

  /* Rides InstaxFrame's develop shake: the same global keyframes and the same
     640ms as its --develop-shake, started by the same hover, so the two stay
     in step. Fine pointers only; reduced motion keeps it still. */
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .hero__hello:has(.instax--develop:hover) .hero__hello-sticker {
      animation: instax-develop-shake 640ms ease-in-out;
    }
  }

  .hero__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-start;
    gap: var(--control-gap);
    margin-top: var(--group-gap);
  }

  .hero__stage {
    position: relative;
    z-index: 2;
    isolation: isolate;
    grid-column: 1 / -1;
    min-width: 0;
  }

  .hero__aside {
    position: relative;
    z-index: 0;
    grid-column: 1 / -1;
    min-width: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--space-3);
    text-align: left;
  }

  .hero__art-window {
    width: 100%;
    overflow: hidden;
    aspect-ratio: 720 / 416;
  }


  .mask { overflow: hidden; }

  /* ============================ work tiles =========================== */
  /* The pin-board: sits behind the case-study pages. Plain shared glass —
     same material as the hero slab and contact panel, no extra texture. */
  .workboard + :global(.case-index) { margin-top: var(--group-gap); }
  /* No board (Uttham, 2026-09-20): the tiles are paper sheets taped to the wall,
     framed by the ruler above and the measure at the edges. The top padding is
     only the tape's overhang — one number, shared with the tape itself below,
     so the heading can sit as close as the tape allows and no closer. */
  .workboard {
    /* The tape overhangs the sheet's top edge by ~16.5px. At 24px of board
       padding only 7.5px of paper showed above it, which is what made the
       heading look glued to the cards (2026-09-25). */
    --tape-overhang: var(--space-7);
    /* The half of the tape that lies ON the sheet. The 32×87px strip turned 92°
       stands 35px tall, centred on the sheet's top edge, so 17.5px of it covers
       paper. A sheet's top padding is this plus one within-card step, so the
       title clears the tape by 16px at every width — at --card-padding alone it
       cleared it by 0px on a phone and 11px at 1280 (Uttham, 2026-10-01: "the
       washi tape is so tightly spaced with the product card"). */
    --tape-bite: 18px;
    --sheet-top: max(var(--card-padding), calc(var(--tape-bite) + var(--space-4)));
    /* What a section stacks above its sheets: the ruler's 12px, the heading
       sentence (one line of --text-h3 at 1.4) with its gap, and this board's
       tape overhang. */
    --sec-chrome: calc(12px + var(--text-h3) * 1.4 + var(--head-gap) + var(--tape-overhang));
    /* The height a sheet's content gets so its section is one screen: the
       content budget less the chrome and the sheet's own padding and border.
       The 360px floor keeps a phone legible (the section scrolls below it); the
       480px cap stops a tall monitor stretching the wells into towers. */
    --sheet-in: clamp(360px, calc(100svh - var(--header-height) - var(--section-y) - var(--sec-chrome) - var(--sheet-top) - var(--card-padding) - 2px), 480px);
    position: relative;
    padding-top: var(--tape-overhang);
  }

  .tiles {
    position: relative;
    z-index: 1;
    display: grid;
    /* Two featured tiles share the row; a third fits beside them at desktop.
       Below ~320px per tile the row wraps, and phones get one column. */
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    /* Clear the rotated tape's overhang and the card shadow. */
    gap: calc(var(--tape-overhang) + var(--space-5)) var(--grid-gap);
  }

  /* Reveal the sheet wrapper so GSAP's magnetic transform and the touch
     press never replace the entrance transform or its stagger. */
  .tile-reveal {
    position: relative;
    display: grid;
    min-width: 0;
    isolation: isolate;
    /* A card and its tape share one layer. Earlier cards stay above later
       tape through reveals, tilt and press, regardless of column count. */
    z-index: var(--tile-layer);
  }
  .tile-reveal:nth-child(3n + 1) { transition-delay: 0ms; }
  .tile-reveal:nth-child(3n + 2) { transition-delay: var(--stagger-1); }
  .tile-reveal:nth-child(3n) { transition-delay: calc(var(--stagger-1) * 2); }

  .tile {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    padding: var(--sheet-top) var(--card-padding) var(--card-padding);
    font-family: var(--font-paper);
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    text-decoration: none;
    color: inherit;
    /* A resting shadow is load-bearing, not decoration: these white sheets
       sit on a near-white glass board, so without it they merge into one
       continuous white slab — most visibly in the single-column layout,
       where a card spans nearly the whole board and the row-gap stops
       reading as a gap at all. */
    box-shadow:
      var(--shadow-rest);
    /* transform is NOT transitioned here on purpose: GSAP owns it on fine
       pointers (motion.js) and writes a new inline value every animation
       frame — a CSS transition on the same property would re-ease each of
       those already-eased frames, compounding into a mushy, laggy feel.
       Touch/no-hover devices get their own transform transition below,
       where nothing else is animating it. */
    transition:
      box-shadow var(--dur-2) var(--ease-standard),
      border-color var(--dur-2) var(--ease-standard);
  }

  @media (hover: none), (pointer: coarse) {
    .tile {
      transition:
        transform var(--dur-1) var(--ease-enter),
        box-shadow var(--dur-2) var(--ease-standard),
        border-color var(--dur-2) var(--ease-standard);
    }
    /* press feedback for touch — GSAP owns transform on fine pointers */
    .tile:active { transform: scale(0.98); }
  }

  /* Hover motion is retired (Uttham, 2026-09-20). Nothing lifts, tilts or
     straightens; the card states its affordance with its border and its arrow. */
  @media (hover: hover) and (pointer: fine) {
    .tile:hover { border-color: rgba(22, 20, 14, 0.3); }
    .tile:hover .tile__arr { transform: translateX(4px); }
  }

  /* Uttham's washi tape holds each page to the board — one strip, dead
     centre. The vertical tape asset is laid sideways across the top edge. */
  .tape {
    position: absolute;
    /* Straddling the top edge, half on the sheet and half on the wall. The lift
       is half the tape's OWN height rather than a fixed number, so re-tuning the
       gap above the board can never slide the tape inside the card again
       (Uttham, 2026-09-21). */
    top: 0;
    left: calc(50% - var(--space-4));
    width: var(--space-6);
    height: auto;
    translate: 0 -50%;
    rotate: 92deg;
    transform-origin: center;
    mix-blend-mode: multiply;
    opacity: 0.9;
    z-index: 2;
    pointer-events: none;
  }

  /* transform is owned by the magnetic-tile GSAP tween on fine pointers
     (motion.js) — it always wins over a CSS transform here, so this rule
     only actually drives translateY on touch/coarse-pointer devices where
     that script bails out. Shadow/border apply everywhere either way. */
  .tile:focus-visible {
    outline: 2px solid var(--amber-text);
    outline-offset: var(--space-1);
  }

  /* The pill-and-year row went from every homepage tile on 2026-10-01 (Uttham:
     "we don't need this whole section"). The kicker and year still live in the
     data — the case and guide pages and the case index use them. */

  .tile__desc {
    color: var(--ink-600);
    margin: 0;
    text-wrap: pretty;
    /* Two lines are reserved whether or not the copy fills them, so every tile's
       preview well starts on the same line and the row reads as one shelf. */
    min-height: calc(2em * var(--lh-body));
    text-wrap: balance;
  }
  .tile__desc :global(.em) { color: var(--ink-900); font-weight: 600; }

  .tile__media {
    /* Taller than the old 16/10: a phone standing in the well needs the height,
       and at 16/10 it overflowed and was clipped mid-screen (Uttham, 2026-09-20). */
    aspect-ratio: 4 / 3;
    /* The well is the tile's one piece of glass (Uttham, 2026-09-20): the .glass
       recipe supplies sheen, rim and bevel; the media lies on top untouched, so
       the hook stays crisp and the glass shows only around it. */
    border-radius: var(--radius-sm);
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--ink-600);
    font-size: var(--text-eyebrow);
    text-align: center;
    padding: var(--space-4);
    font-weight: 500;
    letter-spacing: var(--track-label);
    text-transform: uppercase;
    line-height: var(--lh-body);
  }

  .tile__media--deck { align-items: end; padding: var(--space-5) var(--space-5) 0; }
  /* The phone is sized off the well's HEIGHT, not its width, so it always stands
     flush on the bottom edge and is never cut off mid-screen. Width follows the
     aspect ratio; the cap keeps it from dominating a wide tile. */
  .tile__deck {
    height: 100%;
    width: auto;
    max-width: 52%;
    aspect-ratio: 9 / 15;
    overflow: hidden;
    border: 1px solid var(--line-1);
    border-bottom: 0;
    border-radius: 18px 18px 0 0;
    background: #fff;
    box-shadow: var(--shadow-rest);
  }
  .tile__deck img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; }
  /* a study without a deck shows its cover render as a card inside the glass well */
  .tile__cover { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: var(--radius-inset); box-shadow: 0 1px 2px rgba(22, 20, 14, 0.08); }
  .tile__media :global(svg),
  .tile__media :global(.case-art) {
    width: 100%;
    height: 100%;
  }

  .tile h3 { font-size: var(--text-h4); }
  .tile__go {
    margin-top: auto;
  }

  .tile__arr { transition: transform var(--dur-2) var(--ease-standard); }

  /* ============================ AI Space ============================= */
  /* The same sheets as Projects, two up and never three: each one carries a
     running tool, so the row is a shelf of two working things rather than a
     grid of summaries. Everything below the well is kept to one line a piece so
     an AI sheet stands the same height as a case sheet beside it. */
  /* The row is the Projects row exactly — two up from tablet, one on phones —
     so the two sections never disagree (Uttham, 2026-10-02: "on tablet, the ai
     cards have different layout and project have different, please keep them
     consistent"). A sheet sets its copy beside its phone only once the sheet
     itself is 540px wide (the container query below), which happens on laptops;
     on a tablet both sections stack: title, line, picture, action. */
  .tile--ai { gap: var(--space-4); }

  /* An AI card opens its teaser page, as a case card opens its case — but the
     phone inside it is an iframe, which may not sit inside a link, so the sheet
     cannot BE one. The title's link stretches over the whole sheet instead, and
     "View more" is its visible action, as "Read the case study" is a case tile's
     (Uttham, 2026-10-02: "view more should be the CTA for it"). It is
     aria-hidden because the title link already names the destination. The
     phones are running previews with no link of their own (2026-10-01), so
     every bit of paper and glass opens the teaser. */
  .tool__link { color: inherit; text-decoration: none; }
  .tool__link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    /* the sheet's radius, named: a pseudo-element inherits from its own <a>,
       so `inherit` gave the focus ring square corners on a rounded sheet */
    border-radius: var(--radius-sm);
  }
  .tool__link:focus-visible { outline: none; }
  .tool__link:focus-visible::after { outline: 2px solid var(--amber-text); outline-offset: var(--space-1); }

  /* The Projects well exactly — 4/3, phone standing flush on the bottom edge,
     glass showing on the other three sides. `container` lets each preview ask
     how much room it actually got. */
  .tile__media--tool {
    position: relative;
    container: well / inline-size;
    align-items: end;
    padding: var(--space-5) var(--space-5) 0;
  }


  /* The lead does not reserve the two lines a case tile does: a tool sheet's
     well need not line up with a neighbour's, and an empty reserved line would
     only open a gap between the line and the action. */
  .tile--ai .tile__desc { min-height: 0; }

  /* On a phone the well is only as wide as the screen, so it goes taller —
     otherwise the 9/15 phone inside it comes out ~130px wide and nothing in
     the app can be read (Uttham, 2026-09-21). */
  @media (max-width: 560px) {
    .tile__media--tool { aspect-ratio: 2 / 3; padding: var(--space-4) var(--space-4) 0; }
  }

  /* The action is a case tile's "Read the case study" exactly — same amber rule, and
     the arrow nudges when the sheet is hovered — so the two sections end the
     same way. It only sizes to its words, never the row. */
  .tool__go { align-self: flex-start; }

  /* ================== one screen per section, a picture per sheet ========= */
  /* Each section keeps two taped sheets, and each sheet keeps its own picture
     (Uttham, 2026-10-01: "why we are having image of one card, we should have
     for both"). On a laptop a sheet is exactly as tall as the screen leaves
     (--sheet-in), so the section reads as one screen. */
  @media (min-width: 1024px) {
    /* A case sheet: title, lead and action take what they need and the well
       takes the rest, so the picture grows with the screen instead of the sheet
       growing past it. The lead still reserves two lines, so both wells start on
       the same line. */
    .tiles--work .tile {
      display: grid;
      grid-template-rows: auto auto minmax(0, 1fr) auto;
      height: calc(var(--sheet-in) + var(--sheet-top) + var(--card-padding) + 2px);
    }
    .tiles--work .tile__media { aspect-ratio: auto; min-height: 0; }
    /* The cover is sized to fit inside the well, never cropped to fill it: a
       card ON the pane with glass on every side (CLAUDE.md, Images). */
    .tiles--work .tile__cover { width: auto; height: auto; max-width: 100%; max-height: 100%; }
  }

  /* A tool sheet wide enough for both sets its copy on the left and its phone
     on the right; narrower, it stacks as on a phone. The reveal wrapper is the
     container, so the switch follows the sheet's own width — two up on a laptop,
     one per row on a small laptop or a tablet. */
  .tool__copy { display: flex; flex-direction: column; gap: var(--space-4); }
  .tiles--ai .tile-reveal { container: ai-sheet / inline-size; }
  @container ai-sheet (min-width: 540px) {
    .tile--ai {
      /* the phone's column: two fifths of the sheet, so the copy keeps a
         reading width (~260px at 1440) and the phone stays over 200px wide */
      --well-w: clamp(220px, 40cqw, 280px);
      display: grid;
      grid-template-columns: minmax(0, 1fr) var(--well-w);
      /* The name, its line and the action are one block, centred against the
         phone's glass well (the phone itself starts 24px down it, so the block
         sits 12px above the phone's own centre). With the answers gone to the
         guide page (2026-10-01), pinning
         the action to the bottom left 210–260px of bare paper between it and
         the line — the gap read as a hole, not as breathing room. */
      grid-template-rows: minmax(0, 1fr) auto auto minmax(0, 1fr);
      grid-template-areas: ". well" "copy well" "foot well" ". well";
      gap: var(--space-4) var(--space-5);
      min-height: calc(var(--sheet-in) + var(--sheet-top) + var(--card-padding) + 2px);
    }
    .tile--ai .tool__copy { grid-area: copy; }
    .tile--ai .tool__go { grid-area: foot; align-self: start; justify-self: start; margin-top: 0; }
    /* The well runs the sheet's full height and the phone stands flush on its
       bottom edge, as tall as the well allows — a handset's proportions, not
       a cropped screen. */
    .tile--ai .tile__media--tool {
      grid-area: well;
      aspect-ratio: auto;
      padding: var(--space-5) var(--space-4) 0;
    }
  }

  /* ============================ principles =========================== */
  /* How I lead — three plain statements on the paper, a title and its tagline
     each (the body paragraphs went on 2026-10-01 so Contact fits one screen).
     Space does the grouping: within an item --space-2, between items
     --grid-gap. No row gap: the two rows are one item, and the subgrid below
     would otherwise have a parent gap to reconcile. */
  .prin {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0 var(--grid-gap);
  }
  /* One sheet of the tiles' white stock: the principles are a paper object, not loose text. */
  .prin--sheet {
    position: relative;
    z-index: 0;
    /* Narrower than the glass and slid under it like a sheet into a folder
       (Uttham's call: on the measure it looked off here). The tuck is
       --space-7, the depth the hero photo goes under its slab: it ends inside
       the panel's bolt band, so the paper's edge shows through the glass above
       the heading and never behind it. A tuck costs no height — the negative
       margin hands it back — so it was never what made Contact long.
       The top margin leaves room for the sticker to clear the ruler (the ruler's
       12px collapses into it). Inside, --space-6 clears the sticker's lower half;
       the bottom padding is the tuck plus one small step, so only a band of
       paper shows between the taglines and the glass. */
    margin: var(--space-6) var(--group-gap) calc(-1 * var(--space-7));
    padding: var(--space-6) var(--group-gap) calc(var(--space-4) + var(--space-7));
    background: var(--paper-1);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-rest);
  }
  /* "How I lead" is an amber sticker holding the sheet's top-left corner to the
     paper, the way the hi! sticker holds the hero photo. Handwriting, tilted, stuck. */
  .prin__title {
    /* Stuck on the sheet's top edge, centred — the way a label goes on a folder
       rather than dog-eared into the corner (Uttham, 2026-09-20). */
    position: absolute;
    top: calc(var(--space-4) * -1);
    left: 50%;
    translate: -50% 0;
    z-index: 2;
    margin: 0;
    padding: var(--space-1) var(--space-3) calc(var(--space-1) + 2px);
    background: var(--amber-500);
    color: var(--ink-900);
    font-family: var(--font-hand);
    font-size: var(--text-note);
    font-weight: 600;
    line-height: var(--lh-heading);
    letter-spacing: 0;
    text-transform: none;
    border-radius: var(--radius-sm);
    box-shadow: var(--shadow-stuck);
    rotate: -5deg;
  }

  /* Each principle is two rows on a shared grid, so titles and taglines line up
     across the columns and the sheet reads as a table, not three floating blocks.
     The tagline's underline went with the body it used to divide off. */
  .prin__item { display: grid; grid-template-rows: subgrid; grid-row: span 2; row-gap: 0; align-content: start; }
  .prin__item + .prin__item { padding-inline-start: var(--space-6); border-inline-start: 1px dashed var(--line-mark); }
  .prin__item h3 { margin: 0; font-size: var(--text-h4); letter-spacing: var(--track-heading); line-height: var(--lh-heading); text-wrap: balance; }
  .prin__item :where(p) { margin: 0; color: var(--ink-600); text-wrap: pretty; }
  .prin__item .prin__tag { margin-top: var(--space-2); color: var(--ink-600); font-family: var(--font-paper); font-size: var(--text-small); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; }

  /* ============================ contact ============================== */
  .contact-panel--after-prin { position: relative; z-index: 1; margin-top: 0; }

  .contact-panel {
    position: relative;
    /* A size container, so the photo can be capped by the width the notes
       leave as well as by the screen's height (see --photo-w). */
    container: contact / inline-size;
    display: grid;
    /* the body takes the width; the photo column is only as wide as the photo */
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--group-gap);
    align-items: center;
    border-radius: var(--radius-sm);
    padding: var(--bolted-panel-padding) var(--panel-padding);
    overflow: visible;
  }

  /* The body takes the whole column so the three notes keep their full width
     and the address stays on one line; the title and sub cap themselves. */
  .contact-panel__body { max-width: none; }

  /* me & the bike — the stickers live on this photo */
  .contact-panel__photo {
    position: relative;
    /* As big as the screen's HEIGHT allows (Uttham, 2026-10-01: "make this image
       section bigger") — once the footer has its share (2026-10-02: "whole
       contact with footer can come in one viewport"). The photo sets the
       panel's height, so its width is what the screen leaves under the header
       after one --space-6 of air, the footer (--footer-block) and everything
       else Contact stacks: 412px = the ruler, the How I lead sheet and the
       panel's own padding (≤342px) plus the print's caption and border, which
       make it ~69px taller than it is wide. Measured at 1024×768 through
       1920×1080 on 2026-10-02; the old formula (295px, ÷1.23) under-reserved
       by up to 40px. It stays ≥150px on short screens — where Contact and the
       footer still fit, with less air — and ≤340px on tall ones.
       The two moto badges came off the photo on 2026-10-01 ("for now remove
       the stickers") along with the space reserved for them; MotoSticker.astro
       is kept so they are one import away from coming back. */
    /* …and never wider than what the three notes leave. Sized off height alone,
       a tall but narrow window (~1050px wide) grew the photo to its cap and
       slid it over the third note (2026-10-01). The notes measure 530px at
       their narrowest (213 + 136 + 133 + two 24px gaps); 560 keeps a margin
       for Caveat's wider labels. 100cqw is the panel's content width. */
    --notes-min: 560px;
    /* The tilted print's corner pokes ~9px past its box; at full size that
       left 15px between it and the bottom-right bolt, under the 16px every
       bolt is owed. One within-card step in from the right edge clears it at
       every size, and the cap below gives the notes that step back. */
    --photo-inset: var(--space-4);
    --photo-w: clamp(150px, min(calc(100svh - var(--header-height) - var(--space-6) - var(--footer-block) - 412px), calc(100cqw - var(--notes-min) - var(--group-gap) - var(--photo-inset))), 340px);
  }

  .contact-panel__photo :global(.instax) {
    width: var(--photo-w);
    margin-inline: 0 var(--photo-inset);
  }

  .contact-panel__photo :global(.instax__ph) {
    max-width: var(--space-11);
    margin-bottom: var(--space-8);
  }


  /* Contact copy is etched on glass; handwritten notes remain separate. */
  .contact-panel__title {
    max-width: 16ch;
    margin: 0;
    font-family: var(--font-glass);
    font-weight: 600;
    font-size: var(--text-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--track-heading);
  }

  .contact-panel__sub {
    max-width: 560px;
    margin: var(--space-2) 0 0;
    color: var(--ink-600);
    font-family: var(--font-glass);
    font-weight: 400;
    font-size: var(--text-body-lg);
    line-height: var(--lh-body);
  }

  /* contact actions are sticky notes stuck to the acrylic */
  .note-row {
    list-style: none;
    /* one row of three notes under the heading, so the panel stays one screen tall.
       Each note is never narrower than its own content — nothing wraps. The row
       is only as wide as the notes need (all three at the widest one's width,
       or each at its own when room is short), not stretched across the leftover
       glass: stretched, they read as three slabs the size of the photo and the
       panel as four cards in a row (Uttham, 2026-10-01). */
    display: grid;
    grid-template-columns: repeat(3, minmax(max-content, 1fr));
    width: max-content;
    max-width: 100%;
    gap: var(--space-5);
    margin: var(--space-6) 0 0;
    padding: 0;
  }

  .note-row li {
    width: auto;
    min-width: 0;
  }

  /* A note is two lines: the label with its arrow, then the address. The arrow
     rides the label's line rather than taking a third, so a note is an action
     you can see at a glance, not a card competing with the photo. */
  .note-link {
    --note-tilt: -2deg;
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--space-1) var(--space-4);
    width: 100%;
    padding: var(--space-3) var(--space-4);
    background: var(--amber-400);
    border: 1px solid var(--line-1);
    border-radius: var(--radius-sm);
    color: var(--ink-900);
    text-decoration: none;
    font-family: var(--font-hand);
    font-size: var(--text-note);
    font-weight: 500;
    line-height: var(--lh-heading);
    rotate: var(--note-tilt);
    box-shadow: var(--shadow-stuck);
    transition:
      rotate var(--dur-2) var(--ease-standard),
      translate var(--dur-2) var(--ease-standard),
      box-shadow var(--dur-2) var(--ease-standard);
  }

  .note-link:focus-visible {
    outline: 2px solid var(--amber-text);
    outline-offset: var(--space-1);
  }

  /* Hover: the note straightens, lifts and casts a deeper shadow — the
     original rule, restored on 2026-10-01 at Uttham's request ("the hover
     animations on these cards are also gone"). It had been retired with the
     2026-09-20 no-hover-motion pass; this supersedes that for the notes. */
  @media (hover: hover) and (pointer: fine) {
    .note-link:hover {
      rotate: 0deg;
      translate: 0 var(--lift-y);
      box-shadow: var(--shadow-lift);
    }
  }

  /* Pressed flat: tilt returns, lift gone, shadow shrinks. */
  .note-link:active {
    rotate: var(--note-tilt);
    translate: 0 0;
    box-shadow: var(--shadow-press);
    transition-duration: var(--dur-1);
    transition-timing-function: var(--ease-enter);
  }

  .note-link small {
    grid-column: 1 / -1;
    /* the address may break mid-word rather than run past the note's edge */
    white-space: normal;
    font-family: var(--font-paper);
