---
// THROWAWAY PREVIEW — delete after review. Shows the Projects section with
// three featured tiles and four stand-in index rows, so the second layer can
// be judged before there are enough real cases to fill it.
import Base from '../../layouts/Base.astro';
import Header from '../../components/Header.astro';
import GridOverlay from '../../components/GridOverlay.astro';
import SectionRule from '../../components/SectionRule.astro';
import CaseIndex from '../../components/CaseIndex.astro';
import { studies } from '../../data/studies';

const tiles = [
  ...studies.filter((s) => s.featured),
  { slug: 'stand-in-3', kicker: 'Systems', year: '2024', title: 'Stand-in third tile', summary: 'A third featured case, so the row can be judged **three across.**', focus: '', scope: [] },
];
const rows = [
  { slug: 'stand-in-a', kicker: 'Craft', year: '2023', title: 'Post-order, rebuilt', summary: 'Order tracking and balance comprehension overhauled to **cut cancellations** at scale.', focus: '', scope: [] },
  { slug: 'stand-in-b', kicker: 'Systems', year: '2024', title: 'Intent channelization', summary: 'Category feeds, filters and Reels tuned to **how rural India expresses intent.**', focus: '', scope: [] },
  { slug: 'stand-in-c', kicker: 'Vision', year: '2022', title: 'Gold, the second tier', summary: 'What a quality tier needs before shoppers will **believe it without being told.**', focus: '', scope: [] },
  { slug: 'stand-in-d', kicker: 'Current', year: '2025—', title: 'Repurchase, as a system', summary: 'How India buys again — from buy-again moments to **replenishment rhythms.**', focus: '', scope: [] },
];
---
<Base title="Mock — Projects with an index" description="throwaway preview">
  <Header active="projects" />
  <main class="mock" tabindex="-1">
    <GridOverlay />
    <section class="section wrap">
      <SectionRule label="Projects" />
      <h2 class="sec-sub">The problems, the bets, what shipped.</h2>
      <div class="board glass">
        <span class="bolt bolt--tl"></span><span class="bolt bolt--tr"></span><span class="bolt bolt--bl"></span><span class="bolt bolt--br"></span>
        <div class="tiles">
          {tiles.map((t) => (
            <a class="tile" href={`/work/${t.slug}`}>
              <span class="tile__top"><span class="pill">{t.kicker}</span><span class="tile__year">{t.year}</span></span>
              <h3>{t.title}</h3>
              <p class="tile__desc">{t.summary.replace(/\*\*/g, '')}</p>
              <div class="tile__media">media</div>
              <span class="tile__go">Read the case →</span>
            </a>
          ))}
        </div>
      </div>
      <CaseIndex items={rows as any} />
    </section>
  </main>
</Base>

<style>
  .mock { position: relative; min-height: 100svh; padding-top: calc(var(--header-height) + var(--section-y-sm)); }
  .wrap { width: min(calc(100% - var(--margin-side) * 2), var(--container-max)); margin: 0 auto; }
  .sec-sub { margin: var(--space-3) 0 var(--space-6); font-size: var(--text-h3); font-weight: 500; color: var(--ink-600); }
  .board { position: relative; padding: var(--bolted-board-padding); border-radius: var(--radius-sm); }
  .tiles { position: relative; z-index: 1; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr)); gap: var(--space-7) var(--grid-gap); }
  .tile { display: flex; flex-direction: column; gap: var(--space-4); padding: var(--card-padding, var(--space-6)); background: var(--paper-1); border: 1px solid var(--line-1); border-radius: var(--radius-sm); box-shadow: var(--shadow-rest); color: inherit; text-decoration: none; }
  .tile__top { display: flex; justify-content: space-between; align-items: center; }
  .pill, .tile__year { font-family: var(--font-paper); font-size: var(--text-eyebrow); font-weight: 500; letter-spacing: var(--track-label); text-transform: uppercase; color: var(--ink-600); }
  .pill { padding: var(--space-2) var(--space-3); border: 1px solid var(--line-1); border-radius: var(--radius-pill); }
  .tile h3 { margin: 0; font-size: var(--text-h4); }
  .tile__desc { margin: 0; color: var(--ink-600); font-size: var(--text-small); }
  .tile__media { aspect-ratio: 16 / 10; display: grid; place-items: center; background: var(--paper-2); border-radius: var(--radius-inset); color: var(--ink-600); font-size: var(--text-eyebrow); text-transform: uppercase; letter-spacing: var(--track-label); }
  .tile__go { margin-top: auto; font-size: var(--text-small); font-weight: 500; }
  .board + :global(.case-index) { margin-top: var(--group-gap); }
</style>
