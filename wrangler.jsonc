// Cloudflare Workers serves the built site as static assets (2026-10-02: hosted
// at uttham.fyi). Workers Builds runs `npm run build`, then `npx wrangler deploy`
// uploads dist/. The name must match the Worker created in the dashboard.
// Both addresses are declared here, so each deploy keeps them attached: a
// deploy sets the Worker's custom domains to exactly this list.
{
  "name": "portfolio",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // An address with no file gets dist/404.html with a 404 status (domain
    // trust pass, 2026-10-03); without this it got an empty 404.
    "not_found_handling": "404-page"
  },
  // On, so the site can be checked from a network that blocks uttham.fyi
  // (Uttham, 2026-10-03, asked to turn it back on after the domain trust pass;
  // with `routes` present Wrangler turns it off unless this says true).
  // public/_headers marks it noindex and every page's canonical tag names the
  // apex, so search engines never index the copy.
  "workers_dev": true,
  "routes": [
    { "pattern": "uttham.fyi", "custom_domain": true },
    { "pattern": "www.uttham.fyi", "custom_domain": true }
  ]
}
